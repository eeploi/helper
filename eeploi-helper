#!/usr/bin/env bash
# eeploi-helper: the only command the deploy user may run as root (/etc/sudoers.d/eeploi).
# Every argument is checked, every action is fixed. Content comes on stdin.
# Source, releases and signatures: https://github.com/eeploi/helper
set -euo pipefail
umask 022
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TMPDIR=/tmp

VERSION='1.0.0'

# The minisign public key releases are signed with (minisign.pub, key id A2C97024AB6219A8).
PUBKEY='RWSoGWKrJHDJoknVaEcX3dz5ew9zWZPqae2Qn2d3M+SGxNBT99NZGiLA'
RELEASES='https://github.com/eeploi/helper/releases/download'
INSTALL_PATH=/usr/local/sbin/eeploi-helper

DRY="${EEPLOI_HELPER_DRY_RUN:-}"
CALLER="${SUDO_USER:-}"

# Root-owned eeploi state: helper.conf (DEPLOY_USER=...) and the new-server marker.
# The overrides are for tests and only count in dry-run mode. EEPLOI_HELPER_DB_STATE stands in for
# what db-create's checks would find on the database server.
ETC=/etc/eeploi
NGINX_CONF=/etc/nginx/nginx.conf
DB_STATE=
if [ -n "$DRY" ]; then
  ETC="${EEPLOI_HELPER_ETC:-$ETC}"
  NGINX_CONF="${EEPLOI_HELPER_NGINX_CONF:-$NGINX_CONF}"
  DB_STATE="${EEPLOI_HELPER_DB_STATE:-}"
fi

fail() { echo "eeploi-helper: $*" >&2; exit 64; }

# Temporary files and folders, removed on every exit.
TMP_PATHS=""
cleanup() {
  local p
  for p in $TMP_PATHS; do rm -rf -- "$p"; done
}
trap cleanup EXIT

run() {
  if [ -n "$DRY" ]; then printf 'run:'; printf ' %s' "$@"; printf '\n'; else "$@"; fi
}

# put <file> <mode>: write stdin to the file, atomically, owned by root.
put() {
  if [ -n "$DRY" ]; then cat > /dev/null; echo "write: $1 ($2)"; return; fi
  local tmp
  tmp=$(mktemp "$1.eeploi.XXXXXX")
  cat > "$tmp"
  chmod "$2" "$tmp"
  chown root:root "$tmp"
  mv -f "$tmp" "$1"
}

# trusted <path>: a regular file (no link), owned by the user running the helper (root through sudo),
# in a folder with the same rules, and neither writable by group or others.
trusted() {
  local f=$1 d
  d=$(dirname -- "$f")
  [[ -f $f && ! -L $f && -O $f ]] || return 1
  [[ -d $d && ! -L $d && -O $d ]] || return 1
  [ -z "$(find "$f" "$d" -maxdepth 0 \( -perm -020 -o -perm -002 \) 2>/dev/null)" ]
}


# The deploy user: eeploi, or DEPLOY_USER from helper.conf. The file is parsed, never sourced.
DEPLOY_USER=eeploi
CONF="$ETC/helper.conf"
if [ -e "$CONF" ] || [ -L "$CONF" ]; then
  trusted "$CONF" || fail "untrusted config: $CONF (must be a root-owned file, not writable by others)"
  conf_re='^DEPLOY_USER=([a-z][a-z0-9_-]{1,31})$'
  seen=0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    [[ $line =~ $conf_re ]] || fail "invalid line in $CONF: $line"
    [ $seen -eq 0 ] || fail "DEPLOY_USER is set twice in $CONF"
    DEPLOY_USER=${BASH_REMATCH[1]}
    seen=1
  done < "$CONF"
  [ "$DEPLOY_USER" != root ] || fail "the deploy user cannot be root"
fi

HOMES='ploi|forge|eeploi'
case "|$HOMES|" in *"|$DEPLOY_USER|"*) ;; *) HOMES="$HOMES|$DEPLOY_USER" ;; esac

domain() {
  local re='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'
  [[ $1 =~ $re ]] || fail "invalid domain: $1"
}

# A certificate name: the domain, or eeploi-<domain> for one made at a take-over.
cert_name() { domain "${1#eeploi-}"; }

program() {
  local re='^eeploi-[a-z0-9.-]+$'
  [[ $1 =~ $re ]] || fail "invalid program: $1"
}

php_version() {
  local re='^[0-9]\.[0-9]$'
  [[ $1 =~ $re ]] || fail "invalid PHP version: $1"
}

# A PHP-FPM socket: the default one per version (Ploi and Forge use /var/run/php), or eeploi's own pool.
socket() {
  local re='^(/var)?/run/php/php[0-9]+\.[0-9]+-fpm(-eeploi)?\.sock$'
  [[ $1 =~ $re ]] || fail "invalid PHP-FPM socket: $1"
}

# home_path <path>: a path inside one of the allowed home folders.
home_path() {
  local p=$1 re="^/home/($HOMES)/[A-Za-z0-9._/-]+$"
  case "$p/" in */../*|*/./*|*//*) fail "invalid path: $p" ;; esac
  [[ $p =~ $re ]] || fail "outside the allowed home folders: $p"
  if realpath -m / > /dev/null 2>&1; then
    local resolved
    resolved=$(realpath -m -- "$p")
    [[ $resolved =~ $re ]] || fail "resolves outside the allowed home folders: $p"
  fi
}

# caller_path <path>: a path inside the calling user's own home folder.
caller_path() {
  home_path "$1"
  case "$1" in "/home/$CALLER/"*) ;; *) fail "not in /home/$CALLER: $1" ;; esac
}

owner() { [ "$1" = "$CALLER" ] || fail "owner must be $CALLER: $1"; }

supervisor_file() {
  local re='^/etc/supervisor/conf\.d/(worker|daemon|eeploi)-[A-Za-z0-9._-]+\.conf$'
  [[ $1 =~ $re ]] || fail "invalid Supervisor config: $1"
}

# The vhost a domain uses: the target of sites-enabled/<domain>, else sites-available/<domain>.
vhost_file() {
  domain "$1"
  local enabled="/etc/nginx/sites-enabled/$1" target
  if [ -L "$enabled" ]; then
    target=$(readlink -f "$enabled")
    case "$target" in /etc/nginx/sites-available/*|/etc/nginx/sites-enabled/*) echo "$target" ;; *) fail "vhost link points outside nginx: $enabled" ;; esac
  elif [ -f "$enabled" ]; then
    echo "$enabled"
  else
    echo "/etc/nginx/sites-available/$1"
  fi
}

# acl_package: install the acl package (setfacl) when it is missing, and only that package.
acl_package() {
  if [ -n "$DRY" ]; then
    echo "check: setfacl installed, else apt-get install acl"
  elif ! command -v setfacl > /dev/null 2>&1; then
    { apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq acl > /dev/null; } < /dev/null \
      || fail "cannot install the acl package"
  fi
}

# nginx_user: set NGINX_USER and NGINX_GROUP from the one `user` line in nginx.conf (www-data without one).
nginx_user() {
  local line found=0 start_re='^[[:space:]]*user([[:space:]]|;|$)'
  local re='^[[:space:]]*user[[:space:]]+([a-z_][a-z0-9_-]{0,31})([[:space:]]+([a-z_][a-z0-9_-]{0,31}))?[[:space:]]*;[[:space:]]*(#.*)?$'
  [ -f "$NGINX_CONF" ] || fail "nginx config not found: $NGINX_CONF"
  NGINX_USER=www-data
  NGINX_GROUP=
  while IFS= read -r line || [ -n "$line" ]; do
    [[ $line =~ $start_re ]] || continue
    [ $found -eq 0 ] || fail "more than one user line in $NGINX_CONF"
    [[ $line =~ $re ]] || fail "cannot read the user line in $NGINX_CONF: $line"
    NGINX_USER=${BASH_REMATCH[1]}
    NGINX_GROUP=${BASH_REMATCH[3]:-}
    found=1
  done < "$NGINX_CONF"
  [ -n "$NGINX_GROUP" ] || NGINX_GROUP=$NGINX_USER
  [[ $NGINX_USER != root && $NGINX_GROUP != root ]] || fail "nginx runs as root, refusing"
  if [ -n "$DRY" ]; then
    echo "check: user $NGINX_USER and group $NGINX_GROUP exist"
  else
    id -u "$NGINX_USER" > /dev/null 2>&1 || fail "nginx user does not exist: $NGINX_USER"
    getent group "$NGINX_GROUP" > /dev/null 2>&1 || fail "nginx group does not exist: $NGINX_GROUP"
  fi
}

# source_path <path>: a path in another panel's home (/home/ploi, /home/forge), never the caller's own.
# Sets SRC to where it really is (Ploi's site folder is a link), which must still be in those homes.
# Root only reads from here.
source_path() {
  home_path "$1"
  local re='^/home/(ploi|forge)/[A-Za-z0-9._/-]+$'
  [[ $1 =~ $re ]] || fail "source must be in /home/ploi or /home/forge: $1"
  case "$1" in "/home/$CALLER/"*) fail "source cannot be in /home/$CALLER: $1" ;; esac
  SRC=$1
  if [ -z "$DRY" ]; then
    SRC=$(realpath -e -- "$1") || fail "source not found: $1"
    [[ $SRC =~ $re ]] || fail "source resolves outside /home/ploi and /home/forge: $1"
    case "$SRC" in "/home/$CALLER/"*) fail "source resolves into /home/$CALLER: $1" ;; esac
  fi
}

# version_lt <a> <b>: true when version a is lower than version b (both checked x.y.z).
version_lt() {
  local a1 a2 a3 b1 b2 b3
  IFS=. read -r a1 a2 a3 <<< "$1"
  IFS=. read -r b1 b2 b3 <<< "$2"
  (( a1 != b1 )) && { (( a1 < b1 )); return; }
  (( a2 != b2 )) && { (( a2 < b2 )); return; }
  (( a3 < b3 ))
}

# vhost_conf <domain> <socket>: eeploi's one vhost, HTTPS only behind Cloudflare, built here from checked
# arguments. Root, certificate and log paths are fixed: logs go to /var/log/nginx, never into a folder the
# caller can write (nginx opens log files as root).
vhost_conf() {
  cat <<VHOST
# Written by eeploi-helper (vhost-write). eeploi rewrites this file, do not edit.
server {
    listen 80;
    listen [::]:80;
    server_name $1;
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name $1;
    root /home/$CALLER/$1/current/public;

    ssl_certificate /etc/nginx/ssl/$1.crt;
    ssl_certificate_key /etc/nginx/ssl/$1.key;

    index index.php;
    charset utf-8;

    access_log /var/log/nginx/eeploi-$1-access.log;
    error_log /var/log/nginx/eeploi-$1-error.log;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \\.php\$ {
        fastcgi_pass unix:$2;
        fastcgi_param SCRIPT_FILENAME \$realpath_root\$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\\.(?!well-known).* {
        deny all;
    }
}
VHOST
}

# supervisor_conf <program> <directory> <processes> <command>: a worker config built here. Only these keys;
# the log goes to /var/log/supervisor (supervisord opens it as root).
supervisor_conf() {
  cat <<CONF
[program:$1]
process_name=%(program_name)s_%(process_num)02d
command=$4
directory=$2
user=$CALLER
numprocs=$3
autostart=true
autorestart=true
stopwaitsecs=3600
redirect_stderr=true
stdout_logfile=/var/log/supervisor/$1.log
CONF
}

# Where root keeps take-over backups: root-owned, never in a folder the caller can write.
STATE=/var/lib/eeploi

# escape_dots <text>: dots escaped for a sed pattern (the input is already checked: no other special characters).
escape_dots() { printf '%s' "$1" | sed 's/[.]/\\./g'; }

# pool_conf <version>: eeploi's own PHP-FPM pool, running as the deploy user.
pool_conf() {
  cat <<POOL
; Written by eeploi-helper (php-pool-write). eeploi rewrites this file, do not edit.
[eeploi]
user = $DEPLOY_USER
group = $DEPLOY_USER
listen = /run/php/php$1-fpm-eeploi.sock
listen.owner = $NGINX_USER
listen.group = $NGINX_GROUP
listen.mode = 0660
pm = ondemand
pm.max_children = 10
pm.process_idle_timeout = 10s
pm.max_requests = 500
request_terminate_timeout = 300
POOL
}

# db_engine <engine>: mysql, mariadb or pgsql.
db_engine() {
  case "$1" in mysql|mariadb|pgsql) ;; *) fail "invalid database engine: $1 (mysql, mariadb or pgsql)" ;; esac
}

# db_name <database|user> <name>: a lowercase letter, then a-z, 0-9 or _, at most 32 in all. Names the
# engines keep for themselves are refused, and so is Postgres' pg_ prefix.
DB_RESERVED='mysql|information_schema|performance_schema|sys|postgres|template0|template1|root'
db_name() {
  local re='^[a-z][a-z0-9_]{0,31}$'
  [[ $2 =~ $re ]] || fail "invalid $1 name: $2 (a-z, 0-9 and _, starting with a letter, at most 32)"
  case "|$DB_RESERVED|" in *"|$2|"*) fail "reserved $1 name: $2" ;; esac
  case "$2" in pg_*) fail "reserved $1 name: $2" ;; esac
}

# db_login <socket|password>: how the user logs in, in DB_LOGIN. socket: as the Unix user of the same
# name, with no password; stdin is never read. password: the password from stdin in DB_PASSWORD, only
# characters that are safe inside an SQL string, never printed, logged, written to a file or put on a
# command line. A missing password fails; it never falls back to socket login.
db_login() {
  local re='^[A-Za-z0-9._~+/=-]{16,128}$'
  DB_PASSWORD=
  DB_LOGIN=$1
  case "$1" in
    socket) return ;;
    password) ;;
    *) fail "invalid login: $1 (socket or password)" ;;
  esac
  [ ! -t 0 ] || fail "password login needs the password on stdin, not a terminal"
  DB_PASSWORD=$(head -c 256)
  [[ $DB_PASSWORD =~ $re ]] || fail "the password on stdin must be 16 to 128 characters: A-Z a-z 0-9 . _ ~ + / = -"
}

# db_unix_user <user>: socket login trusts every process of that Unix user, so it must exist and be a
# site's own user: not a system user (uid below 1000) and not a user that runs more than one site
# (the deploy user, ploi, forge). In a dry run the uid comes from a uid=<n|none> line in
# EEPLOI_HELPER_DB_STATE, else 1001.
db_unix_user() {
  local uid=
  if [ -n "$DRY" ]; then
    echo "check: id -u -- $1"
    [ -z "$DB_STATE" ] || uid=$(sed -n 's/^uid=//p' "$DB_STATE")
    uid=${uid:-1001}
    [ "$uid" != none ] || uid=
  else
    uid=$(id -u -- "$1" 2> /dev/null) || uid=
  fi
  [ -n "$uid" ] || fail "no Unix user $1 on this server: socket login needs the site's own user"
  [[ $uid =~ ^[0-9]+$ ]] || fail "cannot read the uid of $1: $uid"
  [ "$uid" -ge 1000 ] || fail "$1 is a system user (uid $uid): socket login needs the site's own user"
  case "|$HOMES|" in *"|$1|"*) fail "$1 runs more than one site: socket login needs the site's own user" ;; esac
}

# db_client <engine>: the client command in DB_CLIENT. Through the local socket only, with a clean
# environment: no option file, history or plugin from the caller's home, no PG* or MYSQL_* variables.
# MySQL and MariaDB log in as root (socket auth), Postgres as the postgres user (peer auth).
db_client() {
  case "$1" in
    mysql|mariadb)
      DB_BIN=mysql
      if [ "$1" = mariadb ] && { [ -n "$DRY" ] || command -v mariadb > /dev/null; }; then DB_BIN=mariadb; fi
      DB_CLIENT=(env -i PATH="$PATH" HOME=/root LC_ALL=C "$DB_BIN" --protocol=socket --user=root --batch --skip-column-names) ;;
    pgsql)
      DB_BIN=psql
      DB_CLIENT=(env -i PATH="$PATH" LC_ALL=C runuser -u postgres -- psql -X -q -A -t --no-password -v ON_ERROR_STOP=1 -d postgres) ;;
  esac
  [ -z "$DRY" ] || return 0
  command -v "$DB_BIN" > /dev/null || fail "$DB_BIN not found: is $1 installed?"
  [ "$1" != pgsql ] || id -u postgres > /dev/null 2>&1 || fail "no postgres user: is Postgres installed?"
}

# db_check_sql <engine> <name> <user>: what the server has, as key=count lines (see db_state).
# MySQL keeps a grant on `a\_b` for the database a_b, so both spellings are looked up.
db_check_sql() {
  local esc
  if [ "$1" = pgsql ]; then
    cat <<SQL
SELECT 'db_exists=' || count(*) FROM pg_database WHERE datname = '$2';
SELECT 'user_exists=' || count(*) FROM pg_roles WHERE rolname = '$3';
SELECT 'user_global=' || count(*) FROM pg_roles r WHERE r.rolname = '$3' AND (r.rolsuper OR r.rolcreatedb OR r.rolcreaterole OR r.rolreplication OR r.rolbypassrls OR EXISTS (SELECT 1 FROM pg_auth_members m WHERE m.member = r.oid));
SELECT 'user_elsewhere=' || count(*) FROM pg_database d, pg_roles r WHERE r.rolname = '$3' AND d.datname <> '$2' AND (d.datdba = r.oid OR EXISTS (SELECT 1 FROM aclexplode(d.datacl) a WHERE a.grantee = r.oid));
SELECT 'db_others=' || count(*) FROM pg_database d WHERE d.datname = '$2' AND (d.datdba IS DISTINCT FROM (SELECT oid FROM pg_roles WHERE rolname = '$3') OR EXISTS (SELECT 1 FROM aclexplode(d.datacl) a WHERE a.grantee NOT IN (0, d.datdba)));
SELECT 'granted=' || count(*) FROM pg_database d, pg_roles r WHERE d.datname = '$2' AND r.rolname = '$3' AND d.datdba = r.oid;
SELECT 'user_socket=' || count(*) FROM pg_authid WHERE rolname = '$3' AND rolpassword IS NULL;
SQL
    return
  fi
  esc=$(printf '%s' "$2" | sed 's/_/\\\\_/g')
  cat <<SQL
SET SESSION sql_mode = '';
SELECT CONCAT('mariadb=', IF(VERSION() LIKE '%MariaDB%', 1, 0));
SELECT CONCAT('db_exists=', COUNT(*)) FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = '$2';
SELECT CONCAT('user_exists=', COUNT(*)) FROM mysql.user WHERE User = '$3' AND Host = 'localhost';
SELECT CONCAT('user_global=', COUNT(*)) FROM information_schema.USER_PRIVILEGES WHERE SUBSTRING_INDEX(GRANTEE, '@', 1) = '''$3''' AND PRIVILEGE_TYPE <> 'USAGE';
SELECT CONCAT('user_elsewhere=', (SELECT COUNT(*) FROM mysql.db WHERE User = '$3' AND Db NOT IN ('$2', '$esc')) + (SELECT COUNT(*) FROM mysql.tables_priv WHERE User = '$3' AND Db <> '$2'));
SELECT CONCAT('db_others=', (SELECT COUNT(*) FROM mysql.db WHERE Db IN ('$2', '$esc') AND NOT (User = '$3' AND Host = 'localhost')) + (SELECT COUNT(*) FROM mysql.tables_priv WHERE Db = '$2' AND NOT (User = '$3' AND Host = 'localhost')));
SELECT CONCAT('granted=', COUNT(*)) FROM mysql.db WHERE Db IN ('$2', '$esc') AND User = '$3' AND Host = 'localhost';
SELECT CONCAT('user_socket=', COUNT(*)) FROM mysql.user WHERE User = '$3' AND Host = 'localhost' AND plugin IN ('auth_socket', 'unix_socket');
SELECT CONCAT('socket_plugin=', COUNT(*)) FROM information_schema.PLUGINS WHERE PLUGIN_NAME = IF(VERSION() LIKE '%MariaDB%', 'unix_socket', 'auth_socket') AND PLUGIN_STATUS = 'ACTIVE';
SQL
}

# db_state <engine> <name> <user>: run the checks and set S_<key>. Only known key=count lines are read.
# user_socket: the user logs in over the socket (no password); socket_plugin: MySQL's auth_socket or
# MariaDB's unix_socket is active. In a dry run the state comes from EEPLOI_HELPER_DB_STATE (its uid=
# line is db_unix_user's), or is a server with neither and the socket plugin active.
db_state() {
  local out line key var keys='db_exists user_exists user_global user_elsewhere db_others granted user_socket'
  local re='^(mariadb|db_exists|user_exists|user_global|user_elsewhere|db_others|granted|user_socket|socket_plugin)=([0-9]+)$'
  [ "$1" = pgsql ] || keys="mariadb $keys socket_plugin"
  S_mariadb='' S_db_exists='' S_user_exists='' S_user_global='' S_user_elsewhere='' S_db_others='' S_granted=''
  S_user_socket='' S_socket_plugin=''
  if [ -n "$DRY" ]; then
    echo "check: what the $1 server has (on stdin of: ${DB_CLIENT[*]})"
    db_check_sql "$@" | sed 's/^/  /'
    if [ -n "$DB_STATE" ]; then
      out=$(grep -v '^uid=' "$DB_STATE" || true)
    else
      out=$(for key in $keys; do echo "$key=0"; done)
      [ "$1" != mariadb ] || out=${out/mariadb=0/mariadb=1}
      out=${out/socket_plugin=0/socket_plugin=1}
    fi
  else
    out=$(db_check_sql "$@" | "${DB_CLIENT[@]}") || fail "$1 failed: cannot read what the server has"
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [[ $line =~ $re ]] || fail "cannot read the $1 checks: $line"
    printf -v "S_${BASH_REMATCH[1]}" '%s' "${BASH_REMATCH[2]}"
  done <<< "$out"
  for key in $keys; do
    var="S_$key"
    [ -n "${!var}" ] || fail "cannot read the $1 checks: no $key"
  done
}

# db_create_sql <engine> <name> <user> <password>: only what is missing (DB_PLUGIN, DB_NEW_USER,
# DB_NEW_DB, DB_GRANT). With DB_LOGIN=socket the user gets no password: Postgres peer auth, MariaDB
# unix_socket, MySQL auth_socket. The session first turns off the server's statement logs, so a
# password stays out of them.
db_create_sql() {
  local esc
  if [ "$1" = pgsql ]; then
    echo "SET log_statement = 'none';"
    echo "SET log_min_duration_statement = -1;"
    echo "SET log_min_error_statement = 'panic';"
    echo "SET pg_stat_statements.track_utility = off;"
    if [ -n "$DB_NEW_USER" ] && [ "$DB_LOGIN" = socket ]; then
      echo "CREATE ROLE \"$3\" LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;"
    elif [ -n "$DB_NEW_USER" ]; then
      printf '%s\n' "CREATE ROLE \"$3\" LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD '$4';"
    fi
    if [ -n "$DB_NEW_DB" ]; then
      echo "CREATE DATABASE \"$2\" OWNER \"$3\" ENCODING 'UTF8' TEMPLATE template0;"
      echo "REVOKE ALL ON DATABASE \"$2\" FROM PUBLIC;"
    fi
    return
  fi
  esc=$(printf '%s' "$2" | sed 's/_/\\_/g')
  echo "SET SESSION sql_log_off = 1;"
  [ -z "$DB_PLUGIN" ] || echo "INSTALL PLUGIN auth_socket SONAME 'auth_socket.so';"
  if [ -n "$DB_NEW_USER" ] && [ "$DB_LOGIN" = socket ] && [ "$1" = mariadb ]; then
    echo "CREATE USER '$3'@'localhost' IDENTIFIED VIA unix_socket;"
  elif [ -n "$DB_NEW_USER" ] && [ "$DB_LOGIN" = socket ]; then
    echo "CREATE USER '$3'@'localhost' IDENTIFIED WITH auth_socket;"
  elif [ -n "$DB_NEW_USER" ]; then
    printf '%s\n' "CREATE USER '$3'@'localhost' IDENTIFIED BY '$4';"
  fi
  [ -z "$DB_NEW_DB" ] || echo "CREATE DATABASE \`$2\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
  [ -z "$DB_GRANT" ] || echo "GRANT ALL PRIVILEGES ON \`$esc\`.* TO '$3'@'localhost';"
}

[[ $CALLER =~ ^($HOMES)$ ]] || fail "run through sudo as the deploy user"
[ $# -ge 1 ] || fail "usage: eeploi-helper <subcommand> [arguments]"

command=$1
shift

# Every call that can change something goes to the system log: who, the subcommand and its
# arguments, never what comes on stdin (a certificate, a command, a file). A dry run says so
# on stderr instead.
if [ "$command" != "version" ]; then
  if [ -n "$DRY" ]; then
    echo "log: eeploi-helper: $CALLER: $command $*" >&2
  else
    logger -t eeploi-helper -- "$CALLER: $command $*" 2> /dev/null || true
  fi
fi

case "$command" in
  version)
    echo "$VERSION" ;;

  nginx-test)
    run nginx -t ;;

  nginx-reload)
    run service nginx reload ;;

  php-fpm-reload)
    [ $# -eq 1 ] || fail "usage: php-fpm-reload <version>"
    php_version "$1"
    run service "php$1-fpm" reload ;;

  vhost-write)
    [ $# -eq 2 ] || fail "usage: vhost-write <domain> <php-fpm-socket>"
    file=$(vhost_file "$1")
    socket "$2"
    if [ -n "$DRY" ]; then vhost_conf "$1" "$2" | sed 's/^/  /'; fi
    vhost_conf "$1" "$2" | put "$file" 644 ;;

  vhost-backup)
    [ $# -eq 1 ] || fail "usage: vhost-backup <domain>"
    file=$(vhost_file "$1")
    dir="$STATE/nginx/$1"
    run mkdir -p -m 700 "$dir"
    run cp "$file" "$dir/vhost"
    if [ -f "/etc/nginx/ssl/$1" ] || [ -n "$DRY" ]; then run cp "/etc/nginx/ssl/$1" "$dir/ssl"; else run rm -f "$dir/ssl"; fi ;;

  vhost-restore)
    [ $# -eq 1 ] || fail "usage: vhost-restore <domain>"
    file=$(vhost_file "$1")
    dir="$STATE/nginx/$1"
    [ -f "$dir/vhost" ] || [ -n "$DRY" ] || fail "no backup for $1: $dir/vhost"
    run cp "$dir/vhost" "$file"
    if [ -f "$dir/ssl" ] || [ -n "$DRY" ]; then run cp "$dir/ssl" "/etc/nginx/ssl/$1"; fi ;;

  vhost-enable)
    [ $# -eq 1 ] || fail "usage: vhost-enable <domain>"
    domain "$1"
    run ln -sfn "/etc/nginx/sites-available/$1" "/etc/nginx/sites-enabled/$1" ;;

  vhost-disable)
    [ $# -eq 1 ] || fail "usage: vhost-disable <domain>"
    domain "$1"
    run rm -f "/etc/nginx/sites-enabled/$1" ;;

  vhost-remove)
    [ $# -eq 1 ] || fail "usage: vhost-remove <domain>"
    domain "$1"
    run rm -f "/etc/nginx/sites-enabled/$1" "/etc/nginx/sites-available/$1" ;;

  vhost-set-root)
    [ $# -eq 3 ] || fail "usage: vhost-set-root <domain> <old-root> <new-root>"
    file=$(vhost_file "$1")
    home_path "$2"
    home_path "$3"
    run sed -i "s#root ${2//./\\.};#root $3;#" "$file" ;;

  vhost-set-socket)
    [ $# -eq 3 ] || fail "usage: vhost-set-socket <domain> <from-socket> <to-socket>"
    file=$(vhost_file "$1")
    socket "$2"
    socket "$3"
    [ "$2" != "$3" ] || fail "from and to are the same socket: $2"
    from=$(escape_dots "$2")
    line="^[[:space:]]*fastcgi_pass unix:$from;[[:space:]]*\$"
    if [ -z "$DRY" ]; then
      [ -f "$file" ] || fail "no vhost for $1: $file"
      grep -qE "$line" "$file" || fail "no 'fastcgi_pass unix:$2;' line in $file"
      backup=$(mktemp)
      TMP_PATHS="$TMP_PATHS $backup"
      cp -p "$file" "$backup"
    fi
    run sed -i -E "s#^([[:space:]]*)fastcgi_pass unix:$from;([[:space:]]*)\$#\\1fastcgi_pass unix:$3;\\2#" "$file"
    if [ -n "$DRY" ]; then
      run nginx -t
    elif ! out=$(nginx -t 2>&1); then
      cp -p "$backup" "$file"
      echo "$out" >&2
      fail "nginx -t failed, vhost restored: $file"
    fi
    run service nginx reload ;;

  vhost-set-cert)
    [ $# -eq 1 ] || fail "usage: vhost-set-cert <domain>"
    file=$(vhost_file "$1")
    for f in "$file" "/etc/nginx/ssl/$1"; do
      [ -f "$f" ] || [ -n "$DRY" ] || continue
      run sed -i -E "s#^(\s*)ssl_certificate\s+[^;]+;#\1ssl_certificate /etc/nginx/ssl/eeploi-$1.crt;#; s#^(\s*)ssl_certificate_key\s+[^;]+;#\1ssl_certificate_key /etc/nginx/ssl/eeploi-$1.key;#" "$f"
    done ;;

  ssl-csr)
    [ $# -eq 1 ] || fail "usage: ssl-csr <name>"
    cert_name "$1"
    key="/etc/nginx/ssl/$1.key"
    run mkdir -p /etc/nginx/ssl
    if [ ! -f "$key" ]; then
      run openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:prime256v1 -out "$key"
    fi
    run chmod 600 "$key"
    run openssl req -new -key "$key" -subj "/CN=${1#eeploi-}" ;;

  ssl-write)
    [ $# -eq 1 ] || fail "usage: ssl-write <name> < certificate"
    cert_name "$1"
    pem=$(cat)
    pem_re='^-----BEGIN CERTIFICATE-----'$'\n''([A-Za-z0-9+/=]{1,76}'$'\n'')+''-----END CERTIFICATE-----$'
    [[ $pem =~ $pem_re ]] || fail "not one PEM certificate"
    printf '%s\n' "$pem" | put "/etc/nginx/ssl/$1.crt" 644 ;;

  ssl-remove)
    [ $# -eq 1 ] || fail "usage: ssl-remove <name>"
    cert_name "$1"
    run rm -f "/etc/nginx/ssl/$1.crt" "/etc/nginx/ssl/$1.key" ;;

  supervisor-write)
    [ $# -eq 3 ] || fail "usage: supervisor-write <program> <directory> <processes> < command"
    program "$1"
    caller_path "$2"
    [[ $3 =~ ^([1-9]|[12][0-9]|3[0-2])$ ]] || fail "processes must be 1 to 32: $3"
    worker=$(cat)
    [ -n "$worker" ] || fail "empty command"
    [[ $worker != *$'\n'* && $worker != *$'\r'* ]] || fail "the command must be one line"
    [[ $worker =~ ^[[:print:]]+$ ]] || fail "the command has control characters"
    if [ -n "$DRY" ]; then supervisor_conf "$1" "$2" "$3" "$worker" | sed 's/^/  /'; fi
    supervisor_conf "$1" "$2" "$3" "$worker" | put "/etc/supervisor/conf.d/$1.conf" 644 ;;

  supervisor-remove)
    [ $# -eq 1 ] || fail "usage: supervisor-remove <program>"
    program "$1"
    run rm -f "/etc/supervisor/conf.d/$1.conf" ;;

  supervisor-remove-site)
    [ $# -eq 1 ] || fail "usage: supervisor-remove-site <domain>"
    domain "$1"
    for f in /etc/supervisor/conf.d/eeploi-"$1"-*.conf; do
      [ -e "$f" ] && run rm -f "$f"
    done
    true ;;

  supervisor-pause)
    [ $# -eq 1 ] || fail "usage: supervisor-pause <config>"
    supervisor_file "$1"
    run mv "$1" "$1.paused" ;;

  supervisor-resume)
    [ $# -eq 1 ] || fail "usage: supervisor-resume <config>"
    supervisor_file "$1"
    if [ -f "$1.paused" ] || [ -n "$DRY" ]; then run mv "$1.paused" "$1"; fi ;;

  supervisor-update)
    run supervisorctl reread
    run supervisorctl update ;;

  cron-write)
    [ $# -eq 1 ] || fail "usage: cron-write <domain> < line"
    domain "$1"
    line=$(cat)
    re="^\* \* \* \* \* $CALLER php([0-9]\.[0-9])? (/[A-Za-z0-9._/-]+)/artisan schedule:run > /dev/null 2>&1$"
    [[ $line =~ $re ]] || fail "only '* * * * * $CALLER php <site>/artisan schedule:run' is allowed"
    home_path "${BASH_REMATCH[2]}"
    printf '%s\n' "$line" | put "/etc/cron.d/eeploi-$1" 644 ;;

  cron-remove)
    [ $# -eq 1 ] || fail "usage: cron-remove <domain>"
    domain "$1"
    run rm -f "/etc/cron.d/eeploi-$1" ;;

  crontab-remove-lines)
    [ $# -eq 1 ] || fail "usage: crontab-remove-lines <domain> < lines"
    domain "$1"
    patterns=$(mktemp)
    TMP_PATHS="$TMP_PATHS $patterns"
    cat > "$patterns"
    # Only a panel's own jobs: run as ploi or forge, on a path in their home. Never system lines.
    line_re='^[^#[:space:]]+([[:space:]]+[^[:space:]]+){4}[[:space:]]+(ploi|forge)[[:space:]]+.*/home/(ploi|forge)/.*$'
    count=0
    while IFS= read -r line || [ -n "$line" ]; do
      [ -n "$line" ] || continue
      [[ $line =~ $line_re ]] || fail "only ploi or forge jobs in their home can be removed: $line"
      count=$((count + 1))
    done < "$patterns"
    [ $count -gt 0 ] || fail "no lines given"
    saved="$STATE/crontab/$1"
    if [ -n "$DRY" ]; then
      while IFS= read -r line; do [ -n "$line" ] && echo "remove from /etc/crontab: $line"; done < "$patterns"
      echo "save: $saved"
    else
      install -d -m 700 "$STATE/crontab"
      grep -xF -f "$patterns" /etc/crontab | put "$saved" 600 || true
      tmp=$(mktemp /etc/crontab.eeploi.XXXXXX)
      grep -vxF -f "$patterns" /etc/crontab > "$tmp" || true
      chmod 644 "$tmp"
      mv -f "$tmp" /etc/crontab
    fi ;;

  crontab-restore)
    [ $# -eq 1 ] || fail "usage: crontab-restore <domain>"
    domain "$1"
    saved="$STATE/crontab/$1"
    if [ -n "$DRY" ]; then
      echo "add back to /etc/crontab: the lines in $saved"
    elif [ -f "$saved" ]; then
      # Only the lines crontab-remove-lines took out, each once; later changes to /etc/crontab stay.
      tmp=$(mktemp /etc/crontab.eeploi.XXXXXX)
      cp -p /etc/crontab "$tmp"
      while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        grep -qxF -- "$line" "$tmp" || printf '%s\n' "$line" >> "$tmp"
      done < "$saved"
      chmod 644 "$tmp"
      mv -f "$tmp" /etc/crontab
      rm -f "$saved"
    fi ;;

  env-install)
    [ $# -eq 3 ] || fail "usage: env-install <from-file> <to-file> <owner>"
    source_path "$1"
    caller_path "$2"
    owner "$3"
    [ -f "$SRC" ] || [ -n "$DRY" ] || fail "no file: $1"
    # Root only reads the source (no link at the end), the caller writes the copy: a swapped link in the
    # caller's home can't send root's write elsewhere.
    # shellcheck disable=SC2016 # $1 is for the inner shell
    write='umask 027 && cat > "$1" && chmod 640 "$1"'
    if [ -n "$DRY" ]; then
      echo "run: dd if=$SRC iflag=nofollow | runuser -u $CALLER -- sh -c '$write' sh $2"
    else
      dd if="$SRC" iflag=nofollow status=none | runuser -u "$CALLER" -- sh -c "$write" sh "$2"
    fi ;;

  storage-copy)
    [ $# -eq 3 ] || fail "usage: storage-copy <from-dir> <to-dir> <owner>"
    source_path "$1"
    caller_path "$2"
    owner "$3"
    # Root reads the source with tar (links stay links), the caller unpacks it in their own folder.
    if [ -n "$DRY" ]; then
      echo "run: tar -C $SRC -cf - . | runuser -u $CALLER -- tar -C $2 -xf - --no-same-owner"
    elif [ -d "$SRC" ]; then
      tar -C "$SRC" -cf - . | runuser -u "$CALLER" -- tar -C "$2" -xf - --no-same-owner
    fi ;;

  db-create)
    [ $# -eq 4 ] || fail "usage: db-create <engine> <name> <user> <socket|password> [< password]"
    db_engine "$1"
    db_name database "$2"
    db_name user "$3"
    db_login "$4"
    [ "$DB_LOGIN" != socket ] || db_unix_user "$3"
    cd / || fail "cannot change to /"
    db_client "$1"
    db_state "$1" "$2" "$3"
    case "$1" in
      mysql) [ "$S_mariadb" = 0 ] || fail "this server runs MariaDB, not MySQL" ;;
      mariadb) [ "$S_mariadb" = 1 ] || fail "this server runs MySQL, not MariaDB" ;;
    esac
    # The user gets that one database and nothing else; a database someone else can use is not taken.
    [ "$S_user_global" = 0 ] || fail "user $3 has rights beyond one database, refusing"
    [ "$S_user_elsewhere" = 0 ] || fail "user $3 has rights on another database, refusing"
    [ "$S_db_others" = 0 ] || fail "database $2 belongs to another user, refusing"
    [ "$S_db_exists" = 0 ] || [ "$S_granted" != 0 ] || fail "database $2 exists and is not $3's, refusing"
    # An existing user keeps its way in: never switched between socket and password login.
    if [ "$S_user_exists" != 0 ] && [ "$DB_LOGIN" = socket ] && [ "$S_user_socket" = 0 ]; then
      fail "user $3 exists with password login, not socket login: refusing, it is not switched"
    fi
    if [ "$S_user_exists" != 0 ] && [ "$DB_LOGIN" = password ] && [ "$S_user_socket" != 0 ]; then
      fail "user $3 exists with socket login, not password login: refusing, it is not switched"
    fi
    # MySQL's auth_socket is a plugin; Ubuntu installs it unless root got a password. MariaDB has
    # unix_socket built in and on since 10.4.
    DB_PLUGIN=
    if [ "$DB_LOGIN" = socket ] && [ "$1" = mysql ] && [ "$S_socket_plugin" = 0 ]; then DB_PLUGIN=1; fi
    if [ "$DB_LOGIN" = socket ] && [ "$1" = mariadb ] && [ "$S_socket_plugin" = 0 ]; then
      fail "the unix_socket plugin is not active on this MariaDB server, refusing"
    fi
    DB_NEW_USER=
    DB_NEW_DB=
    DB_GRANT=
    [ "$S_user_exists" != 0 ] || DB_NEW_USER=1
    [ "$S_db_exists" != 0 ] || DB_NEW_DB=1
    [ "$S_granted" != 0 ] || DB_GRANT=1
    if [ -z "$DB_PLUGIN$DB_NEW_USER$DB_NEW_DB$DB_GRANT" ]; then
      echo "exists: $1 database $2 for user $3, nothing changed ($DB_LOGIN login)"
      exit 0
    fi
    # The SQL goes on the client's stdin (printf is a shell builtin), so the password is on no command line.
    if [ -n "$DRY" ]; then
      echo "run: ${DB_CLIENT[*]} (SQL on stdin)"
      db_create_sql "$1" "$2" "$3" '<password>' | sed 's/^/  /'
    elif ! out=$(db_create_sql "$1" "$2" "$3" "$DB_PASSWORD" | "${DB_CLIENT[@]}" 2>&1); then
      # Only the error lines, without the password: psql repeats the failing statement.
      [ -z "$DB_PASSWORD" ] || out=${out//"$DB_PASSWORD"/<password>}
      printf '%s\n' "$out" | grep -E 'ERROR|FATAL' >&2 || true
      fail "$1 failed: database $2 for user $3 not created"
    fi
    if [ -n "$DB_NEW_USER" ]; then
      echo "created: $1 database $2 for user $3 ($DB_LOGIN login)"
    elif [ "$DB_LOGIN" = socket ]; then
      echo "created: $1 database $2 for user $3 (socket login, the user existed)"
    else
      echo "created: $1 database $2 for user $3 (password login, the user existed, its password is unchanged)"
    fi ;;

  firewall-close-22)
    [ $# -eq 0 ] || fail "usage: firewall-close-22"
    trusted "$ETC/new-server" || fail "firewall-close-22 only runs on a server eeploi created ($ETC/new-server is missing or not root-owned)"
    run ufw delete allow 22/tcp ;;

  acl-nginx)
    [ $# -eq 0 ] || fail "usage: acl-nginx"
    nginx_user
    home="/home/$DEPLOY_USER"
    if [ -z "$DRY" ]; then
      [[ -d $home && ! -L $home ]] || fail "no home folder: $home"
    fi
    acl_package
    run setfacl -m "u:$NGINX_USER:x" "$home" ;;

  php-pool-write)
    [ $# -eq 1 ] || fail "usage: php-pool-write <version>"
    php_version "$1"
    nginx_user
    dir="/etc/php/$1/fpm/pool.d"
    file="$dir/eeploi.conf"
    if [ -n "$DRY" ]; then
      echo "write: $file (644)"
      pool_conf "$1" | sed 's/^/  /'
      run "php-fpm$1" -t
      run service "php$1-fpm" reload
      exit 0
    fi
    [[ -d $dir && ! -L $dir ]] || fail "PHP $1 FPM is not installed: $dir"
    command -v "php-fpm$1" > /dev/null || fail "php-fpm$1 not found"
    id -u "$DEPLOY_USER" > /dev/null 2>&1 || fail "deploy user does not exist: $DEPLOY_USER"
    backup=""
    if [ -f "$file" ]; then
      backup=$(mktemp "$dir/.eeploi.conf.backup.XXXXXX")
      TMP_PATHS="$TMP_PATHS $backup"
      cp -p "$file" "$backup"
    fi
    pool_conf "$1" | put "$file" 644
    if ! out=$("php-fpm$1" -t 2>&1); then
      if [ -n "$backup" ]; then mv -f "$backup" "$file"; else rm -f "$file"; fi
      echo "$out" >&2
      fail "php-fpm$1 -t failed, previous pool restored"
    fi
    service "php$1-fpm" reload ;;

  self-update)
    [ $# -eq 1 ] || fail "usage: self-update <version>"
    semver='^(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})$'
    [[ $1 =~ $semver ]] || fail "invalid version: $1"
    ! version_lt "$1" "$VERSION" || fail "no downgrade: $VERSION is installed, $1 is older"
    key_re='^RW[A-Za-z0-9+/]{54}$'
    case "$PUBKEY" in *REPLACE_WITH_RELEASE_KEY*) fail "no release key in this build (PUBKEY is the placeholder), self-update refused" ;; esac
    [[ $PUBKEY =~ $key_re ]] || fail "invalid release key in this build, self-update refused"
    url="$RELEASES/v$1/eeploi-helper"
    if [ -n "$DRY" ]; then
      echo "download: $url"
      echo "download: $url.minisig"
      echo "run: minisign -V -q -P $PUBKEY -m <download>/eeploi-helper -x <download>/eeploi-helper.minisig"
      echo "run: bash -n <download>/eeploi-helper"
      echo "check: <download>/eeploi-helper version = $1"
      echo "install: $INSTALL_PATH (root:root 755)"
      exit 0
    fi
    command -v curl > /dev/null || fail "curl not found"
    command -v minisign > /dev/null || fail "minisign not found"
    work=$(mktemp -d)
    TMP_PATHS="$TMP_PATHS $work"
    for f in eeploi-helper eeploi-helper.minisig; do
      curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
        --connect-timeout 10 --max-time 120 --max-filesize 1048576 \
        -o "$work/$f" "$RELEASES/v$1/$f" || fail "download failed: $RELEASES/v$1/$f"
    done
    minisign -V -q -P "$PUBKEY" -m "$work/eeploi-helper" -x "$work/eeploi-helper.minisig" \
      || fail "signature check failed, nothing changed"
    bash -n "$work/eeploi-helper" || fail "the new helper is not valid bash, nothing changed"
    got=$(env -i PATH="$PATH" SUDO_USER="$CALLER" bash "$work/eeploi-helper" version 2>&1) \
      || fail "the new helper does not run, nothing changed"
    [ "$got" = "$1" ] || fail "the new helper says version $got, expected $1, nothing changed"
    new=$(mktemp "$INSTALL_PATH.eeploi.XXXXXX")
    TMP_PATHS="$TMP_PATHS $new"
    cp "$work/eeploi-helper" "$new"
    chown root:root "$new"
    chmod 755 "$new"
    mv -f "$new" "$INSTALL_PATH"
    echo "eeploi-helper $VERSION -> $1"
    exit 0 ;;

  *)
    fail "unknown subcommand: $command" ;;
esac
