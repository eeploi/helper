#!/bin/bash
# eeploi-helper: the only command the deploy user may run as root (/etc/sudoers.d/eeploi).
# Every argument is checked, every action is fixed. Content comes on stdin.
# Source, releases and signatures: https://github.com/eeploi/helper
set -euo pipefail
umask 022
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TMPDIR=/tmp HOME=/root LC_ALL=C

VERSION='1.0.3'

# The minisign public key releases are signed with (minisign.pub, key id A2C97024AB6219A8).
PUBKEY='RWSoGWKrJHDJoknVaEcX3dz5ew9zWZPqae2Qn2d3M+SGxNBT99NZGiLA'
RELEASES='https://github.com/eeploi/helper/releases/download'
INSTALL_PATH=/usr/local/sbin/eeploi-helper

DRY="${EEPLOI_HELPER_DRY_RUN:-}"
CALLER="${SUDO_USER:-}"

# Root-owned eeploi state: helper.conf (DEPLOY_USER=...), the new-server marker, the site registry
# (sites/<user>) and the Redis configs (redis/<user>.conf).
# The overrides are for tests and only count in dry-run mode. EEPLOI_HELPER_DB_STATE stands in for
# what db-create's checks would find on the database server, EEPLOI_HELPER_SYSTEM for the users,
# groups, paths and running units the site-user checks would find (see stand_in),
# EEPLOI_HELPER_VHOST for the vhost vhost-set-root rewrites (the result is printed) and
# vhost-set-socket checks, and
# EEPLOI_HELPER_NGINX_LOGS for nginx's log folder.
ETC=/etc/eeploi
NGINX_CONF=/etc/nginx/nginx.conf
NGINX_LOGS=/var/log/nginx
DB_STATE=
SYSTEM=
VHOST_STAND_IN=
if [ -n "$DRY" ]; then
  ETC="${EEPLOI_HELPER_ETC:-$ETC}"
  NGINX_CONF="${EEPLOI_HELPER_NGINX_CONF:-$NGINX_CONF}"
  NGINX_LOGS="${EEPLOI_HELPER_NGINX_LOGS:-$NGINX_LOGS}"
  DB_STATE="${EEPLOI_HELPER_DB_STATE:-}"
  SYSTEM="${EEPLOI_HELPER_SYSTEM:-}"
  VHOST_STAND_IN="${EEPLOI_HELPER_VHOST:-}"
fi

fail() { echo "eeploi-helper: $*" >&2; exit 64; }

# Temporary files and folders, removed on every exit.
TMP_PATHS=""
cleanup() {
  local p
  for p in $TMP_PATHS; do rm -rf -- "$p"; done
}
trap cleanup EXIT

run() {
  if [ -n "$DRY" ]; then printf 'run:'; printf ' %s' "$@"; printf '\n'; else "$@"; fi
}

# put <file> <mode>: write stdin to the file, atomically, owned by root.
put() {
  if [ -n "$DRY" ]; then cat > /dev/null; echo "write: $1 ($2)"; return; fi
  local tmp
  tmp=$(mktemp "$1.eeploi.XXXXXX")
  cat > "$tmp"
  chmod "$2" "$tmp"
  chown root:root "$tmp"
  mv -f "$tmp" "$1"
}

# closed <-d|-f> <path>: a folder or regular file (no link), owned by the user running the helper
# (root through sudo) and not writable by group or others.
closed() {
  if [ "$1" = -d ]; then [ -d "$2" ]; else [ -f "$2" ]; fi && [[ ! -L $2 && -O $2 ]] && [ -z "$(find "$2" -maxdepth 0 \( -perm -020 -o -perm -002 \) 2> /dev/null)" ]
}

# trusted <path>: a closed file in a closed folder.
trusted() { closed -f "$1" && closed -d "$(dirname -- "$1")"; }


# The deploy user: eeploi, or DEPLOY_USER from helper.conf. The file is parsed, never sourced.
DEPLOY_USER=eeploi
CONF="$ETC/helper.conf"
if [ -e "$CONF" ] || [ -L "$CONF" ]; then
  trusted "$CONF" || fail "untrusted config: $CONF (must be a root-owned file, not writable by others)"
  conf_re='^DEPLOY_USER=([a-z][a-z0-9_-]{1,31})$'
  seen=0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    [[ $line =~ $conf_re ]] || fail "invalid line in $CONF: $line"
    [ $seen -eq 0 ] || fail "DEPLOY_USER is set twice in $CONF"
    DEPLOY_USER=${BASH_REMATCH[1]}
    seen=1
  done < "$CONF"
  [ "$DEPLOY_USER" != root ] || fail "the deploy user cannot be root"
fi

HOMES='ploi|forge|eeploi'
case "|$HOMES|" in *"|$DEPLOY_USER|"*) ;; *) HOMES="$HOMES|$DEPLOY_USER" ;; esac

domain() {
  local re='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'
  [[ $1 =~ $re ]] || fail "invalid domain: $1"
}

# A certificate name: the domain, or eeploi-<domain> for one made at a take-over.
cert_name() { domain "${1#eeploi-}"; }

program() {
  local re='^eeploi-[a-z0-9.-]+$'
  [[ $1 =~ $re ]] || fail "invalid program: $1"
}

php_version() {
  local re='^[0-9]\.[0-9]$'
  [[ $1 =~ $re ]] || fail "invalid PHP version: $1"
}

# socket <socket> <domain> <from|to>: a PHP-FPM socket in /run/php or /var/run/php. to: only the pool of
# the site user listed for that domain. from: also a socket a vhost may still use: the default one per
# version, eeploi 1.0.1's php<v>-fpm-eeploi.sock, or a panel's pool per user (php<v>-fpm-<user>.sock).
# Another site user's pool is never a from-socket.
socket() {
  local re='^(/var)?/run/php/php[0-9]+\.[0-9]+-fpm(-([a-z][a-z0-9_-]{0,31}))?\.sock$'
  [[ $1 =~ $re ]] || fail "invalid PHP-FPM socket: $1"
  local user=${BASH_REMATCH[3]}
  if [ "$3" = from ]; then
    [ -n "$user" ] || return 0
    [ -e "$ETC/sites/$user" ] || [ -L "$ETC/sites/$user" ] || return 0
  else
    [ -n "$user" ] || fail "invalid PHP-FPM socket: $1 (the new socket is the pool of the site user of $2)"
  fi
  ( site_user "$user" "$2" ) > /dev/null 2>&1 \
    || fail "invalid PHP-FPM socket: $1 ($user is not the eeploi site user of $2)"
}

# site_root <path> <domain>: a path in a site user's home must be in the folder of that user's own
# listed domain, /srv/eeploi/<user>/<domain>/. Other paths pass unchanged.
site_root() {
  local re='^/srv/eeploi/([a-z][a-z0-9_]{0,31})/'
  [[ $1 =~ $re ]] || return 0
  local user=${BASH_REMATCH[1]}
  site_user "$user" "$2"
  case "$1" in "/srv/eeploi/$user/$2/"?*) ;; *) fail "not in /srv/eeploi/$user/$2: $1" ;; esac
}

# home_path <path>: a path inside one of the allowed home folders, or in the home of a listed site
# user (/srv/eeploi/<user>/...).
home_path() {
  local p=$1 re="^/home/($HOMES)/[A-Za-z0-9._/-]+$" site_re='^/srv/eeploi/([a-z][a-z0-9_]{0,31})/[A-Za-z0-9._/-]+$'
  case "$p/" in */../*|*/./*|*//*) fail "invalid path: $p" ;; esac
  if [[ $p =~ $site_re ]]; then
    re="^/srv/eeploi/${BASH_REMATCH[1]}/[A-Za-z0-9._/-]+$"
    site_user "${BASH_REMATCH[1]}"
  fi
  [[ $p =~ $re ]] || fail "outside the allowed home folders: $p"
  if realpath -m / > /dev/null 2>&1; then
    local resolved
    resolved=$(realpath -m -- "$p")
    [[ $resolved =~ $re ]] || fail "resolves outside the allowed home folders: $p"
  fi
}

# site_path <user> <path>: a path inside the home of that listed site user.
site_path() {
  case "$2" in "/srv/eeploi/$1/"*) ;; *) fail "not in /srv/eeploi/$1: $2" ;; esac
  home_path "$2"
}

supervisor_file() {
  local re='^/etc/supervisor/conf\.d/(worker|daemon|eeploi)-[A-Za-z0-9._-]+\.conf$'
  [[ $1 =~ $re ]] || fail "invalid Supervisor config: $1"
}

# The vhost a domain uses: the target of sites-enabled/<domain>, else sites-available/<domain>.
vhost_file() {
  domain "$1"
  local enabled="/etc/nginx/sites-enabled/$1" target
  if [ -L "$enabled" ]; then
    target=$(readlink -f "$enabled")
    case "$target" in /etc/nginx/sites-available/*|/etc/nginx/sites-enabled/*) echo "$target" ;; *) fail "vhost link points outside nginx: $enabled" ;; esac
  elif [ -f "$enabled" ]; then
    echo "$enabled"
  else
    echo "/etc/nginx/sites-available/$1"
  fi
}

# acl_package: install the acl package (setfacl) when it is missing, and only that package.
acl_package() {
  if [ -n "$DRY" ]; then
    echo "check: setfacl installed, else apt-get install acl"
  elif ! command -v setfacl > /dev/null 2>&1; then
    { apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq acl > /dev/null; } < /dev/null \
      || fail "cannot install the acl package"
  fi
}

# nginx_user: set NGINX_USER and NGINX_GROUP from the one `user` line in nginx.conf (www-data without one).
nginx_user() {
  local line found=0 start_re='^[[:space:]]*user([[:space:]]|;|$)'
  local re='^[[:space:]]*user[[:space:]]+([a-z_][a-z0-9_-]{0,31})([[:space:]]+([a-z_][a-z0-9_-]{0,31}))?[[:space:]]*;[[:space:]]*(#.*)?$'
  [ -f "$NGINX_CONF" ] || fail "nginx config not found: $NGINX_CONF"
  NGINX_USER=www-data
  NGINX_GROUP=
  while IFS= read -r line || [ -n "$line" ]; do
    [[ $line =~ $start_re ]] || continue
    [ $found -eq 0 ] || fail "more than one user line in $NGINX_CONF"
    [[ $line =~ $re ]] || fail "cannot read the user line in $NGINX_CONF: $line"
    NGINX_USER=${BASH_REMATCH[1]}
    NGINX_GROUP=${BASH_REMATCH[3]:-}
    found=1
  done < "$NGINX_CONF"
  [ -n "$NGINX_GROUP" ] || NGINX_GROUP=$NGINX_USER
  [[ $NGINX_USER != root && $NGINX_GROUP != root ]] || fail "nginx runs as root, refusing"
  if [ -n "$DRY" ]; then
    echo "check: user $NGINX_USER and group $NGINX_GROUP exist"
  else
    id -u "$NGINX_USER" > /dev/null 2>&1 || fail "nginx user does not exist: $NGINX_USER"
    getent group "$NGINX_GROUP" > /dev/null 2>&1 || fail "nginx group does not exist: $NGINX_GROUP"
  fi
}

# stand_in <prefix>: in a dry run, the rest of the first EEPLOI_HELPER_SYSTEM line that starts with
# <prefix>. The lines: "passwd <getent passwd line>", "group <getent group line>",
# "id <user>:<id -G output>", "path <path that exists>" and "active <running unit>".
stand_in() {
  local line
  [ -n "$SYSTEM" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "$1"*) printf '%s\n' "${line#"$1"}"; return 0 ;; esac
  done < "$SYSTEM"
  return 1
}

# What the server has: a user's passwd line, its group's line, its groups, a path, a running unit.
passwd_of() {
  local rest
  if [ -z "$DRY" ]; then getent passwd "$1"; return; fi
  rest=$(stand_in "passwd $1:") || return 1
  echo "$1:$rest"
}
group_of() {
  local rest
  if [ -z "$DRY" ]; then getent group "$1"; return; fi
  rest=$(stand_in "group $1:") || return 1
  echo "$1:$rest"
}
groups_of() {
  if [ -z "$DRY" ]; then id -G "$1"; else stand_in "id $1:"; fi
}
present() {
  if [ -z "$DRY" ]; then [ -e "$1" ] || [ -L "$1" ]; else [ -n "$SYSTEM" ] && grep -qxF -- "path $1" "$SYSTEM"; fi
}
running() {
  if [ -z "$DRY" ]; then systemctl is-active --quiet "$1"; else [ -n "$SYSTEM" ] && grep -qxF -- "active $1" "$SYSTEM"; fi
}

# root_dir <folder>: a root-owned folder (755), made when missing. One that is there must be
# root-owned, not a link and not writable by others.
root_dir() {
  if [ -n "$DRY" ]; then
    [ -d "$1" ] || present "$1" || echo "run: install -d -o root -g root -m 755 $1"
  elif [ -e "$1" ] || [ -L "$1" ]; then
    closed -d "$1" || fail "$1 must be a root-owned folder, not writable by others"
  else
    install -d -o root -g root -m 755 "$1"
  fi
}

# A site user: one Linux user per site, home /srv/eeploi/<user>, listed in the registry.
SITE_USER_RE='^[a-z][a-z0-9_]{0,31}$'

# Names a site user never gets: the system's own users, panels and services, and the standard groups
# that grant root or close to it. useradd makes a group of the user's name, and a package installed
# later keeps a group that is already there, so these are refused also while the group doesn't exist.
RESERVED_USERS='root|eeploi|ploi|forge|ubuntu|www-data|postgres|mysql|redis|nobody|nogroup'
RESERVED_GROUPS='admin|wheel|sudo|adm|staff|shadow|disk|kmem|tty|utmp|crontab|docker|lxd|incus|incus-admin|libvirt|libvirt-qemu|kvm|video|render|input|sgx|systemd-journal|systemd-network|lpadmin|sambashare|operator|daemon|bin|sys|backup|syslog|ssl-cert'

# site_user_name <user>: a valid name with an _ after the first letter, and not one of the system's, a
# panel's, a powerful group or the deploy user.
site_user_name() {
  [[ $1 =~ $SITE_USER_RE ]] || fail "invalid site user: $1 (a-z, 0-9 and _, starting with a letter, at most 32)"
  nginx_user
  case "|$RESERVED_USERS|$RESERVED_GROUPS|$DEPLOY_USER|$NGINX_USER|$NGINX_GROUP|" in
    *"|$1|"*) fail "reserved name, not a site user: $1" ;;
  esac
  # No standard user or group of the system or of a package has one.
  case "${1:1}" in *_*) ;; *) fail "a site user needs an _ after its first letter, like shop_example: $1" ;; esac
}

# The registry, $ETC/sites/<user>: DOMAIN=<domain> and every file and place of the site, one
# KEY=value line each. Root-owned, parsed line by line, never sourced. Only DOMAIN is used for checks.
REG_KEYS='DOMAIN|HOME|VHOST|POOL|CRON|SUPERVISOR|LOGS|REDIS_UNIT|REDIS_DROPIN|REDIS_CONF|REDIS_SOCKET'
REG_FILE='' REG_DOMAIN='' REG_LINES='' REG_FOUND='' REG_ALL='' REG_SCANNED=0 REG_LOCKS=0 SITE_USER_OK=''

# registry_read <user>: sets REG_FILE, REG_DOMAIN and REG_LINES (the KEY=value lines, in order).
registry_read() {
  local line re="^($REG_KEYS)=([A-Za-z0-9@._/-]+)$"
  REG_FILE="$ETC/sites/$1"
  REG_DOMAIN=
  REG_LINES=
  [ -e "$REG_FILE" ] || [ -L "$REG_FILE" ] || fail "$1 is not an eeploi site user (not in $ETC/sites)"
  trusted "$REG_FILE" || fail "untrusted site registry: $REG_FILE (must be a root-owned file, not writable by others)"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    [[ $line =~ $re ]] || fail "invalid line in $REG_FILE: $line"
    if [ "${BASH_REMATCH[1]}" = DOMAIN ]; then
      [ -z "$REG_DOMAIN" ] || fail "DOMAIN is set twice in $REG_FILE"
      REG_DOMAIN=${BASH_REMATCH[2]}
    fi
    REG_LINES="$REG_LINES$line"$'\n'
  done < "$REG_FILE"
  [ -n "$REG_DOMAIN" ] || fail "no DOMAIN in $REG_FILE"
  domain "$REG_DOMAIN"
}

# registry_write: REG_LINES to REG_FILE (a dry run prints them).
registry_write() {
  local text
  text="# Written by eeploi-helper: this site's domain and every file and place of it. Do not edit."$'\n'"$REG_LINES"
  [ -z "$DRY" ] || printf '%s' "$text" | sed 's/^/  /'
  printf '%s' "$text" | put "$REG_FILE" 644
  REG_SCANNED=0
}

# registry_edit <user> <set|add|del|clear> <KEY=value|KEY>... [<mode> <KEY=value|KEY>...]: change the
# site's registry in one write, under a lock. set: one line for KEY, replaced in place or added;
# add: the line, once; del: that line out; clear: every line of KEY out.
registry_edit() {
  local user=$1 mode pair key line new found
  shift
  registry_lock
  registry_read "$user"
  for pair in "$@"; do
    case "$pair" in set|add|del|clear) mode=$pair; continue ;; esac
    key=${pair%%=*}
    new=''
    found=0
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      case "$mode" in
        set) if [ "${line%%=*}" = "$key" ]; then [ $found -eq 0 ] || continue; line=$pair; found=1; fi ;;
        add) [ "$line" != "$pair" ] || found=1 ;;
        del) [ "$line" != "$pair" ] || continue ;;
        clear) [ "${line%%=*}" != "$key" ] || continue ;;
      esac
      new="$new$line"$'\n'
    done <<< "$REG_LINES"
    case "$mode" in set|add) [ $found -eq 1 ] || new="$new$pair"$'\n' ;; esac
    REG_LINES=$new
  done
  registry_write
  registry_unlock
}

# registry_lock, registry_unlock: one writer of the registry at a time (fd 9, closed before any runuser).
# They nest: only the outer pair takes and drops the lock. Taking it starts a fresh scan.
registry_lock() {
  REG_LOCKS=$((REG_LOCKS + 1))
  [ $REG_LOCKS -eq 1 ] || return 0
  REG_SCANNED=0
  [ -z "$DRY" ] || return 0
  root_dir "$ETC/sites"
  exec 9> "$ETC/sites/.lock"
  flock 9 || fail "cannot lock $ETC/sites"
}
registry_unlock() {
  REG_LOCKS=$((REG_LOCKS - 1))
  [ $REG_LOCKS -eq 0 ] || return 0
  [ -n "$DRY" ] || exec 9>&-
}

# registry_scan: read every registry once per call into REG_ALL ("<user> KEY=value" lines). Any
# untrusted or invalid registry stops the call. REG_FILE, REG_DOMAIN and REG_LINES stay as they were.
registry_scan() {
  [ $REG_SCANNED -eq 0 ] || return 0
  local f user line file=$REG_FILE dom=$REG_DOMAIN lines=$REG_LINES
  REG_ALL=''
  if [ -d "$ETC/sites" ]; then
    for f in "$ETC/sites"/*; do
      user=${f##*/}
      [[ $user =~ $SITE_USER_RE ]] || continue
      registry_read "$user"
      while IFS= read -r line; do
        [ -z "$line" ] || REG_ALL="$REG_ALL$user $line"$'\n'
      done <<< "$REG_LINES"
    done
  fi
  REG_FILE=$file REG_DOMAIN=$dom REG_LINES=$lines REG_SCANNED=1
}

# registry_find <KEY=value>: REG_FOUND is the site user whose registry has that exact line, or empty.
registry_find() {
  local user line
  registry_scan
  REG_FOUND=''
  while read -r user line; do
    if [ -n "$user" ] && [ "$line" = "$1" ]; then REG_FOUND=$user; return 0; fi
  done <<< "$REG_ALL"
}

# registry_domains: every listed site user and its domain, as "<user> <domain>" lines.
registry_domains() {
  local user line
  registry_scan
  while read -r user line; do
    case "$line" in DOMAIN=*) echo "$user ${line#DOMAIN=}" ;; esac
  done <<< "$REG_ALL"
}

# registry_forget <KEY=value>: that line out of the registry that has it.
registry_forget() {
  registry_find "$1"
  [ -z "$REG_FOUND" ] || registry_edit "$REG_FOUND" del "$1"
}

# site_account <user>: the Linux user exists with uid 1000 or higher and home /srv/eeploi/<user>,
# and is in no group but its own.
site_account() {
  local pw name uid gid home gr gname ggid groups
  pw=$(passwd_of "$1") || fail "no Linux user $1 on this server"
  IFS=: read -r name _ uid gid _ home _ <<< "$pw"
  [ "$name" = "$1" ] && [[ $uid =~ ^[0-9]+$ && $gid =~ ^[0-9]+$ ]] || fail "cannot read the Linux user $1"
  [ "$uid" -ge 1000 ] || fail "$1 is a system user (uid $uid), not a site user"
  [ "$home" = "/srv/eeploi/$1" ] || fail "$1 has home $home, not /srv/eeploi/$1"
  gr=$(group_of "$1") || fail "no group $1 on this server"
  IFS=: read -r gname _ ggid _ <<< "$gr"
  [ "$gname" = "$1" ] && [ "$ggid" = "$gid" ] || fail "the group of $1 is not its own group $1"
  groups=$(groups_of "$1") || fail "cannot read the groups of $1"
  [ "$groups" = "$gid" ] || fail "$1 is in other groups too (ids $groups), not a site user"
}

# site_user <user> [<domain>]: a site user eeploi made. Its name is valid and not reserved, its
# registry is trusted (and lists <domain>, when given), and site_account passes. Sets REG_*. A user
# that passed once in this call isn't checked again; its registry is still read.
site_user() {
  [ "$SITE_USER_OK" = "ok:$1" ] || site_user_name "$1"
  registry_read "$1"
  [ -z "${2:-}" ] || [ "$REG_DOMAIN" = "$2" ] || fail "site user $1 is for $REG_DOMAIN, not $2"
  [ "$SITE_USER_OK" = "ok:$1" ] || site_account "$1"
  SITE_USER_OK="ok:$1"
}

# site_home <user>: the home is 750, and only the nginx user may pass through (an ACL with x).
# Root changes the folder itself, never anything in it; /srv/eeploi is root's, so it can't be swapped.
site_home() {
  local home="/srv/eeploi/$1" uid
  if [ -z "$DRY" ]; then
    [[ -d $home && ! -L $home ]] || fail "no home folder: $home"
    uid=$(passwd_of "$1" | cut -d: -f3)
    [ "$(stat -c %u -- "$home")" = "$uid" ] || fail "$home is not owned by $1"
  fi
  acl_package
  run chmod 750 "$home"
  run setfacl -m "u:$NGINX_USER:x" "$home"
}

# keep <file>...: copy each file that exists aside, so restore_kept can put them back (or remove a
# new one). Checked paths only: no spaces or colons.
keep() {
  local f b
  KEPT=''
  for f in "$@"; do
    b=-
    if [ -f "$f" ]; then
      b=$(mktemp "${f%/*}/.${f##*/}.backup.XXXXXX")
      TMP_PATHS="$TMP_PATHS $b"
      cp -p "$f" "$b"
    fi
    KEPT="$KEPT $f:$b"
  done
}
restore_kept() {
  local pair
  for pair in $KEPT; do
    if [ "${pair#*:}" != - ]; then mv -f "${pair#*:}" "${pair%%:*}"; else rm -f "${pair%%:*}"; fi
  done
}

# source_path <path> <name>: a path named <name> (.env, storage) in another panel's home (/home/ploi,
# /home/forge), never the caller's own. Sets SRC to where it really is (Ploi's site folder is a link),
# which must still be in that same home and still be named <name>, and SRC_OWNER to that panel's user.
# The source is read as SRC_OWNER, never as root: a folder swapped after this check gives it only what
# it may read anyway.
source_path() {
  home_path "$1"
  local re='^/home/(ploi|forge)/[A-Za-z0-9._/-]+$'
  [[ $1 =~ $re ]] || fail "source must be in /home/ploi or /home/forge: $1"
  SRC_OWNER=${BASH_REMATCH[1]}
  case "$1" in "/home/$CALLER/"*) fail "source cannot be in /home/$CALLER: $1" ;; esac
  [ "${1##*/}" = "$2" ] || fail "source must end in /$2: $1"
  SRC=$1
  if [ -z "$DRY" ]; then
    SRC=$(realpath -e -- "$1") || fail "source not found: $1"
    [[ $SRC =~ $re ]] || fail "source resolves outside /home/ploi and /home/forge: $1"
    [ "${BASH_REMATCH[1]}" = "$SRC_OWNER" ] || fail "source resolves into another panel's home: $1"
    case "$SRC" in "/home/$CALLER/"*) fail "source resolves into /home/$CALLER: $1" ;; esac
    [ "${SRC##*/}" = "$2" ] || fail "source resolves to a path not ending in /$2: $1"
    id -u "$SRC_OWNER" > /dev/null 2>&1 || fail "no user $SRC_OWNER on this server"
  fi
}

# version_lt <a> <b>: true when version a is lower than version b (both checked x.y.z).
version_lt() {
  local a1 a2 a3 b1 b2 b3
  IFS=. read -r a1 a2 a3 <<< "$1"
  IFS=. read -r b1 b2 b3 <<< "$2"
  (( a1 != b1 )) && { (( a1 < b1 )); return; }
  (( a2 != b2 )) && { (( a2 < b2 )); return; }
  (( a3 < b3 ))
}

# vhost_conf <domain> <user> <socket>: eeploi's one vhost, HTTPS only behind Cloudflare, built here from
# checked arguments. Root, certificate and log paths are fixed: logs go to /var/log/nginx, never into a
# folder the caller can write (nginx opens log files as root).
vhost_conf() {
  cat <<VHOST
# Written by eeploi-helper (vhost-write). eeploi rewrites this file, do not edit.
server {
    listen 80;
    listen [::]:80;
    server_name $1;
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name $1;
    root /srv/eeploi/$2/$1/current/public;
    # nginx follows a link in the site only when the link and its target have the same owner.
    disable_symlinks if_not_owner from=/srv/eeploi/$2;

    ssl_certificate /etc/nginx/ssl/$1.crt;
    ssl_certificate_key /etc/nginx/ssl/$1.key;

    index index.php;
    charset utf-8;

    access_log /var/log/nginx/eeploi-$1-access.log;
    error_log /var/log/nginx/eeploi-$1-error.log;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \\.php\$ {
        fastcgi_pass unix:$3;
        fastcgi_param SCRIPT_FILENAME \$realpath_root\$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\\.(?!well-known).* {
        deny all;
    }
}
VHOST
}

# supervisor_conf <program> <user> <directory> <processes> <command>: a worker config built here. Only
# these keys; the log goes to the site's folder in /var/log/supervisor/eeploi (supervisord opens it as root).
supervisor_conf() {
  cat <<CONF
[program:$1]
process_name=%(program_name)s_%(process_num)02d
command=$5
directory=$3
user=$2
numprocs=$4
autostart=true
autorestart=true
stopwaitsecs=3600
redirect_stderr=true
stdout_logfile=/var/log/supervisor/eeploi/$2/$1.log
CONF
}

# Where root keeps take-over backups: root-owned, never in a folder the caller can write.
STATE=/var/lib/eeploi

# escape_dots <text>: dots escaped for a sed pattern (the input is already checked: no other special characters).
escape_dots() { printf '%s' "$1" | sed 's/[.]/\\./g'; }

# vhost_root_conf <old> <new> <site user or empty>: the vhost on stdin with its one root line (root <old>;
# or, run again, root <new>;) set to root <new>;. For a site user, eeploi's disable_symlinks line goes
# right after it, once; that root must sit at the top level of a server block that listens on port 443,
# and the vhost may have no disable_symlinks line of its own. eeploi's earlier disable_symlinks lines are
# taken out. Quotes aren't parsed, so for a site user a line with a quote and a {, } or # is refused.
vhost_root_conf() {
  local line t n=0 i depth=0 block=0 roots=0 root_i=-1 root_block=0 root_depth=0 ob='{' cb='}' opens closes
  local -a lines ssl
  local ours='^[[:space:]]*disable_symlinks[[:space:]]+if_not_owner[[:space:]]+from=/srv/eeploi/[a-z0-9_]+;[[:space:]]*$'
  local root_re listen_re='^[[:space:]]*listen[[:space:]]+([^;]*[[:space:]:])?443([[:space:];]|$)'
  root_re="^([[:space:]]*)root[[:space:]]+($(escape_dots "$1")|$(escape_dots "$2"));[[:space:]]*$"
  while IFS= read -r line || [ -n "$line" ]; do
    [[ ! $line =~ $ours ]] || continue
    lines[n]=$line
    t=${line%%#*}
    if [ -n "$3" ] && [[ $t == *[\"\']* && $line == *[{}#]* ]]; then
      fail "a vhost line with a quote and a {, } or # can't be read safely, disable_symlinks can't be placed: $line"
    fi
    # Every block that opens at the top level is a new one, also when its { is on a line of its own.
    if [ $depth -eq 0 ] && [[ $t == *$ob* ]]; then block=$((block + 1)); fi
    if [[ $t =~ $listen_re ]]; then ssl[block]=1; fi
    if [[ $line =~ $root_re ]]; then roots=$((roots + 1)); root_i=$n; root_block=$block; root_depth=$depth; fi
    if [ -n "$3" ] && [[ $t == *disable_symlinks* ]]; then
      fail "the vhost has a disable_symlinks line of its own, eeploi's can't be placed: $line"
    fi
    opens=${t//[!$ob]/}
    closes=${t//[!$cb]/}
    depth=$((depth + ${#opens} - ${#closes}))
    n=$((n + 1))
  done
  [ $roots -eq 1 ] || fail "expected one 'root $1;' line in the vhost, found $roots"
  if [ -n "$3" ] && [ "${ssl[root_block]:-}" != 1 ]; then
    fail "the root line is not in a server block on port 443, disable_symlinks can't be placed"
  fi
  if [ -n "$3" ] && [ $root_depth -ne 1 ]; then
    fail "the root line is not at the top level of its server block, disable_symlinks can't be placed"
  fi
  for ((i = 0; i < n; i++)); do
    if [ $i -ne $root_i ]; then printf '%s\n' "${lines[i]}"; continue; fi
    [[ ${lines[i]} =~ $root_re ]]
    printf '%sroot %s;\n' "${BASH_REMATCH[1]}" "$2"
    [ -z "$3" ] || printf '%sdisable_symlinks if_not_owner from=/srv/eeploi/%s;\n' "${BASH_REMATCH[1]}" "$3"
  done
}

# inside <path> <base> <what>: the path is in <base>, without . or .. parts, and every folder from its
# own up to <base> is closed.
inside() {
  local dir=${1%/*} re='^/[A-Za-z0-9._/*?-]+$'
  [[ $1 =~ $re ]] || fail "a $3 that can't be read safely: $1"
  case "$1/" in */../*|*/./*|*//*) fail "a $3 with . or ..: $1" ;; esac
  case "$1" in "$2/"?*) ;; *) fail "a $3 outside $2: $1" ;; esac
  while :; do
    closed -d "$dir" || fail "a $3 in a folder that is not root-owned, or open to group or others: $1 ($dir)"
    [ "$dir" != "$2" ] || return 0
    dir=${dir%/*}
  done
}

# vhost_paths <file> [<depth>]: every include, access_log and error_log in the file, and in what it
# includes, stays root's alone: nginx reads and opens them as root. An include is in the nginx folder
# (a relative one counts from there), and each file it matches is closed. A log is in nginx's log
# folder and no link; the log file itself belongs to nginx's user. Statements may span lines; quotes
# aren't parsed, so a line with a quote and a #, an open quote, or a # inside a word is refused.
vhost_paths() {
  local file=$1 depth=${2:-0} line t dq sq text='' stmt arg match nginx_dir=${NGINX_CONF%/*} ob='{' cb='}'
  local word_end='(^|[[:space:];{}])$'
  local -a words
  [ "$depth" -le 8 ] || fail "vhost includes nested deeper than 8: $file"
  while IFS= read -r line || [ -n "$line" ]; do
    t=${line%%#*}
    dq=${t//[!\"]/} sq=${t//[!\']/}
    if [[ $t == *[\"\']* && $line == *#* ]]; then fail "a vhost line with a quote and a # can't be read safely: $line"; fi
    if [ $((${#dq} % 2 + ${#sq} % 2)) -ne 0 ]; then fail "a vhost line with an open quote can't be read safely: $line"; fi
    if [[ $line == *#* && ! $t =~ $word_end ]]; then fail "a vhost line with a # inside a word can't be read safely: $line"; fi
    text="$text $t"
  done < "$file"
  while IFS= read -r -d ';' stmt; do
    read -r -a words <<< "$stmt"
    arg=${words[1]:-}
    # nginx takes a quoted name too: "include" is include.
    case "${words[0]//[\"\'\\]/}" in
      include)
        [[ $arg == /* ]] || arg="$nginx_dir/$arg"
        [[ ${arg%/*} != *[*?]* ]] || fail "a vhost include with a wildcard in its folder: $arg"
        inside "$arg" "$nginx_dir" "vhost include"
        while IFS= read -r match; do
          [ -n "$match" ] || continue
          closed -f "$match" || fail "a vhost include that is not root-owned, or open to group or others: $match"
          vhost_paths "$match" $((depth + 1))
        done <<< "$(compgen -G "$arg" || true)" ;;
      access_log|error_log)
        case "$arg" in off|stderr|syslog:*|memory:*) continue ;; esac
        [[ $arg != *[*?]* ]] || fail "a vhost log with a wildcard: $arg"
        inside "$arg" "$NGINX_LOGS" "vhost log"
        [[ ! -L $arg && ( -f $arg || ! -e $arg ) ]] || fail "a vhost log that is a link or not a file: $arg" ;;
    esac
  done <<< "${text//[$ob$cb]/;};"
}

# pool_conf <version> <user>: the site's own PHP-FPM pool, running as the site user. Only the nginx user
# may use its socket (0600, no group access).
pool_conf() {
  cat <<POOL
; Written by eeploi-helper (php-pool-write). eeploi rewrites this file, do not edit.
[$2]
user = $2
group = $2
listen = /run/php/php$1-fpm-$2.sock
listen.owner = $NGINX_USER
listen.mode = 0600
pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 10s
pm.max_requests = 500
request_terminate_timeout = 60
POOL
}

# opcache_ini: the pools share one OPcache, so a cached script is only served to a pool whose user may
# read the file.
opcache_ini() {
  cat <<INI
; Written by eeploi-helper (php-pool-write). eeploi rewrites this file, do not edit.
opcache.validate_permission = 1
INI
}

# The Redis of a site: a template unit for all sites, a memory drop-in and a config per site, all
# root-owned. The socket and data live in the site's home.
REDIS_TEMPLATE=/etc/systemd/system/eeploi-redis@.service

redis_unit() {
  cat <<'UNIT'
# Written by eeploi-helper (redis-create). eeploi rewrites this file, do not edit.
[Unit]
Description=Redis of eeploi site user %i
After=network.target

[Service]
Type=notify
User=%i
Group=%i
ExecStart=/usr/bin/redis-server /etc/eeploi/redis/%i.conf --supervised systemd --daemonize no
Restart=on-failure
UMask=0077
MemorySwapMax=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# Only Unix sockets: its own, and systemd's notify socket. No TCP or UDP.
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/srv/eeploi/%i/.redis

[Install]
WantedBy=multi-user.target
UNIT
}

# redis_dropin <mb>: the memory cap, <mb> plus 36 MB for Redis itself and the child its rewrite forks.
redis_dropin() {
  cat <<DROPIN
# Written by eeploi-helper (redis-create). eeploi rewrites this file, do not edit.
[Service]
MemoryMax=$(($1 + 36))M
DROPIN
}

# redis_conf <user> <mb>: no TCP, a socket only the site user can open, append-only, and writes that fail
# when full instead of keys that vanish.
redis_conf() {
  cat <<CONF
# Written by eeploi-helper (redis-create). eeploi rewrites this file, do not edit.
port 0
unixsocket /srv/eeploi/$1/.redis/redis.sock
unixsocketperm 600
dir /srv/eeploi/$1/.redis
appendonly yes
maxmemory $2mb
maxmemory-policy noeviction
enable-module-command no
enable-debug-command no
CONF
}

# db_engine <engine>: mysql, mariadb or pgsql.
db_engine() {
  case "$1" in mysql|mariadb|pgsql) ;; *) fail "invalid database engine: $1 (mysql, mariadb or pgsql)" ;; esac
}

# db_name <database|user> <name>: a lowercase letter, then a-z, 0-9 or _, at most 32 in all. Names the
# engines keep for themselves are refused, and so is Postgres' pg_ prefix.
DB_RESERVED='mysql|information_schema|performance_schema|sys|postgres|template0|template1|root'
db_name() {
  local re='^[a-z][a-z0-9_]{0,31}$'
  [[ $2 =~ $re ]] || fail "invalid $1 name: $2 (a-z, 0-9 and _, starting with a letter, at most 32)"
  case "|$DB_RESERVED|" in *"|$2|"*) fail "reserved $1 name: $2" ;; esac
  case "$2" in pg_*) fail "reserved $1 name: $2" ;; esac
}

# db_login <socket|password>: how the user logs in, in DB_LOGIN. socket: as the Unix user of the same
# name, with no password; stdin is never read. password: the password from stdin in DB_PASSWORD, only
# characters that are safe inside an SQL string, never printed, logged, written to a file or put on a
# command line. A missing password fails; it never falls back to socket login.
db_login() {
  local re='^[A-Za-z0-9._~+/=-]{16,128}$'
  DB_PASSWORD=
  DB_LOGIN=$1
  case "$1" in
    socket) return ;;
    password) ;;
    *) fail "invalid login: $1 (socket or password)" ;;
  esac
  [ ! -t 0 ] || fail "password login needs the password on stdin, not a terminal"
  DB_PASSWORD=$(head -c 256)
  [[ $DB_PASSWORD =~ $re ]] || fail "the password on stdin must be 16 to 128 characters: A-Z a-z 0-9 . _ ~ + / = -"
}

# db_client <engine>: the client command in DB_CLIENT. Through the local socket only, with a clean
# environment: no option file, history or plugin from the caller's home, no PG* or MYSQL_* variables.
# MySQL and MariaDB log in as root (socket auth), Postgres as the postgres user (peer auth).
db_client() {
  case "$1" in
    mysql|mariadb)
      DB_BIN=mysql
      if [ "$1" = mariadb ] && { [ -n "$DRY" ] || command -v mariadb > /dev/null; }; then DB_BIN=mariadb; fi
      DB_CLIENT=(env -i PATH="$PATH" HOME=/root LC_ALL=C "$DB_BIN" --protocol=socket --user=root --batch --skip-column-names) ;;
    pgsql)
      DB_BIN=psql
      DB_CLIENT=(env -i PATH="$PATH" LC_ALL=C runuser -u postgres -- psql -X -q -A -t --no-password -v ON_ERROR_STOP=1 -d postgres) ;;
  esac
  [ -z "$DRY" ] || return 0
  command -v "$DB_BIN" > /dev/null || fail "$DB_BIN not found: is $1 installed?"
  [ "$1" != pgsql ] || id -u postgres > /dev/null 2>&1 || fail "no postgres user: is Postgres installed?"
}

# db_check_sql <engine> <name> <user>: what the server has, as key=count lines (see db_state).
# MySQL keeps a grant on `a\_b` for the database a_b, so both spellings are looked up.
db_check_sql() {
  local esc
  if [ "$1" = pgsql ]; then
    cat <<SQL
SELECT 'db_exists=' || count(*) FROM pg_database WHERE datname = '$2';
SELECT 'user_exists=' || count(*) FROM pg_roles WHERE rolname = '$3';
SELECT 'user_global=' || count(*) FROM pg_roles r WHERE r.rolname = '$3' AND (r.rolsuper OR r.rolcreatedb OR r.rolcreaterole OR r.rolreplication OR r.rolbypassrls OR EXISTS (SELECT 1 FROM pg_auth_members m WHERE m.member = r.oid));
SELECT 'user_elsewhere=' || count(*) FROM pg_database d, pg_roles r WHERE r.rolname = '$3' AND d.datname <> '$2' AND (d.datdba = r.oid OR EXISTS (SELECT 1 FROM aclexplode(d.datacl) a WHERE a.grantee = r.oid));
SELECT 'db_others=' || count(*) FROM pg_database d WHERE d.datname = '$2' AND (d.datdba IS DISTINCT FROM (SELECT oid FROM pg_roles WHERE rolname = '$3') OR EXISTS (SELECT 1 FROM aclexplode(d.datacl) a WHERE a.grantee NOT IN (0, d.datdba)));
SELECT 'granted=' || count(*) FROM pg_database d, pg_roles r WHERE d.datname = '$2' AND r.rolname = '$3' AND d.datdba = r.oid;
SELECT 'user_socket=' || count(*) FROM pg_authid WHERE rolname = '$3' AND rolpassword IS NULL;
SQL
    return
  fi
  esc=$(printf '%s' "$2" | sed 's/_/\\\\_/g')
  cat <<SQL
SET SESSION sql_mode = '';
SELECT CONCAT('mariadb=', IF(VERSION() LIKE '%MariaDB%', 1, 0));
SELECT CONCAT('db_exists=', COUNT(*)) FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = '$2';
SELECT CONCAT('user_exists=', COUNT(*)) FROM mysql.user WHERE User = '$3' AND Host = 'localhost';
SELECT CONCAT('user_global=', COUNT(*)) FROM information_schema.USER_PRIVILEGES WHERE SUBSTRING_INDEX(GRANTEE, '@', 1) = '''$3''' AND PRIVILEGE_TYPE <> 'USAGE';
SELECT CONCAT('user_elsewhere=', (SELECT COUNT(*) FROM mysql.db WHERE User = '$3' AND Db NOT IN ('$2', '$esc')) + (SELECT COUNT(*) FROM mysql.tables_priv WHERE User = '$3' AND Db <> '$2'));
SELECT CONCAT('db_others=', (SELECT COUNT(*) FROM mysql.db WHERE Db IN ('$2', '$esc') AND NOT (User = '$3' AND Host IN ('localhost', '127.0.0.1'))) + (SELECT COUNT(*) FROM mysql.tables_priv WHERE Db = '$2' AND NOT (User = '$3' AND Host IN ('localhost', '127.0.0.1'))));
SELECT CONCAT('granted=', COUNT(*)) FROM mysql.db WHERE Db IN ('$2', '$esc') AND User = '$3' AND Host = 'localhost';
SELECT CONCAT('tcp_user_exists=', COUNT(*)) FROM mysql.user WHERE User = '$3' AND Host = '127.0.0.1';
SELECT CONCAT('tcp_granted=', COUNT(*)) FROM mysql.db WHERE Db IN ('$2', '$esc') AND User = '$3' AND Host = '127.0.0.1';
SELECT CONCAT('user_socket=', COUNT(*)) FROM mysql.user WHERE User = '$3' AND Host = 'localhost' AND plugin IN ('auth_socket', 'unix_socket');
SELECT CONCAT('socket_plugin=', COUNT(*)) FROM information_schema.PLUGINS WHERE PLUGIN_NAME = IF(VERSION() LIKE '%MariaDB%', 'unix_socket', 'auth_socket') AND PLUGIN_STATUS = 'ACTIVE';
SQL
}

# db_state <engine> <name> <user>: run the checks and set S_<key>. Only known key=count lines are read.
# user_socket: the user logs in over the socket (no password); socket_plugin: MySQL's auth_socket or
# MariaDB's unix_socket is active; tcp_user_exists, tcp_granted: the user and its grant on 127.0.0.1.
# In a dry run the state comes from EEPLOI_HELPER_DB_STATE, or is a server with neither and the socket
# plugin active.
db_state() {
  local out line key var keys='db_exists user_exists user_global user_elsewhere db_others granted user_socket'
  local re='^(mariadb|db_exists|user_exists|user_global|user_elsewhere|db_others|granted|user_socket|socket_plugin|tcp_user_exists|tcp_granted)=([0-9]+)$'
  [ "$1" = pgsql ] || keys="mariadb $keys socket_plugin tcp_user_exists tcp_granted"
  S_mariadb='' S_db_exists='' S_user_exists='' S_user_global='' S_user_elsewhere='' S_db_others='' S_granted=''
  S_user_socket='' S_socket_plugin='' S_tcp_user_exists='' S_tcp_granted=''
  if [ -n "$DRY" ]; then
    echo "check: what the $1 server has (on stdin of: ${DB_CLIENT[*]})"
    db_check_sql "$@" | sed 's/^/  /'
    if [ -n "$DB_STATE" ]; then
      out=$(cat "$DB_STATE")
    else
      out=$(for key in $keys; do echo "$key=0"; done)
      [ "$1" != mariadb ] || out=${out/mariadb=0/mariadb=1}
      out=${out/socket_plugin=0/socket_plugin=1}
    fi
  else
    out=$(db_check_sql "$@" | "${DB_CLIENT[@]}") || fail "$1 failed: cannot read what the server has"
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [[ $line =~ $re ]] || fail "cannot read the $1 checks: $line"
    printf -v "S_${BASH_REMATCH[1]}" '%s' "${BASH_REMATCH[2]}"
  done <<< "$out"
  for key in $keys; do
    var="S_$key"
    [ -n "${!var}" ] || fail "cannot read the $1 checks: no $key"
  done
}

# db_create_sql <engine> <name> <user> <password>: only what is missing (DB_PLUGIN, DB_NEW_USER,
# DB_NEW_DB, DB_GRANT, DB_NEW_TCP_USER, DB_TCP_GRANT). With DB_LOGIN=socket the user gets no password:
# Postgres peer auth, MariaDB unix_socket, MySQL auth_socket. The session first turns off the server's statement logs, so a
# password stays out of them.
db_create_sql() {
  local esc
  if [ "$1" = pgsql ]; then
    echo "SET log_statement = 'none';"
    echo "SET log_min_duration_statement = -1;"
    echo "SET log_min_error_statement = 'panic';"
    echo "SET pg_stat_statements.track_utility = off;"
    if [ -n "$DB_NEW_USER" ] && [ "$DB_LOGIN" = socket ]; then
      echo "CREATE ROLE \"$3\" LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;"
    elif [ -n "$DB_NEW_USER" ]; then
      printf '%s\n' "CREATE ROLE \"$3\" LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD '$4';"
    fi
    if [ -n "$DB_NEW_DB" ]; then
      echo "CREATE DATABASE \"$2\" OWNER \"$3\" ENCODING 'UTF8' TEMPLATE template0;"
      echo "REVOKE ALL ON DATABASE \"$2\" FROM PUBLIC;"
    fi
    return
  fi
  esc=$(printf '%s' "$2" | sed 's/_/\\_/g')
  echo "SET SESSION sql_log_off = 1;"
  [ -z "$DB_PLUGIN" ] || echo "INSTALL PLUGIN auth_socket SONAME 'auth_socket.so';"
  if [ -n "$DB_NEW_USER" ] && [ "$DB_LOGIN" = socket ] && [ "$1" = mariadb ]; then
    echo "CREATE USER '$3'@'localhost' IDENTIFIED VIA unix_socket;"
  elif [ -n "$DB_NEW_USER" ] && [ "$DB_LOGIN" = socket ]; then
    echo "CREATE USER '$3'@'localhost' IDENTIFIED WITH auth_socket;"
  elif [ -n "$DB_NEW_USER" ]; then
    printf '%s\n' "CREATE USER '$3'@'localhost' IDENTIFIED BY '$4';"
  fi
  # Laravel's default DB_HOST is 127.0.0.1, which matches 'localhost' only through a name lookup.
  [ -z "$DB_NEW_TCP_USER" ] || printf '%s\n' "CREATE USER '$3'@'127.0.0.1' IDENTIFIED BY '$4';"
  [ -z "$DB_NEW_DB" ] || echo "CREATE DATABASE \`$2\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
  [ -z "$DB_GRANT" ] || echo "GRANT ALL PRIVILEGES ON \`$esc\`.* TO '$3'@'localhost';"
  [ -z "$DB_TCP_GRANT" ] || echo "GRANT ALL PRIVILEGES ON \`$esc\`.* TO '$3'@'127.0.0.1';"
}

[ "$CALLER" = "$DEPLOY_USER" ] || fail "run through sudo as the deploy user $DEPLOY_USER"
[ $# -ge 1 ] || fail "usage: eeploi-helper <subcommand> [arguments]"

command=$1
shift

# Every call that can change something goes to the system log: who, the subcommand and its
# arguments, never what comes on stdin (a certificate, a command, a file). A dry run says so
# on stderr instead.
if [ "$command" != "version" ]; then
  if [ -n "$DRY" ]; then
    echo "log: eeploi-helper: $CALLER: $command $*" >&2
  else
    logger -t eeploi-helper -- "$CALLER: $command $*" 2> /dev/null || true
  fi
fi

case "$command" in
  version)
    echo "$VERSION" ;;

  nginx-test)
    run nginx -t ;;

  nginx-reload)
    run service nginx reload ;;

  php-fpm-reload)
    [ $# -eq 1 ] || fail "usage: php-fpm-reload <version>"
    php_version "$1"
    run service "php$1-fpm" reload ;;

  vhost-write)
    [ $# -eq 3 ] || fail "usage: vhost-write <domain> <user> <php-version>"
    file=$(vhost_file "$1")
    site_user "$2" "$1"
    php_version "$3"
    sock="/run/php/php$3-fpm-$2.sock"
    if [ -n "$DRY" ]; then vhost_conf "$1" "$2" "$sock" | sed 's/^/  /'; fi
    vhost_conf "$1" "$2" "$sock" | put "$file" 644
    registry_edit "$2" set "VHOST=$file" ;;

  vhost-backup)
    [ $# -eq 1 ] || fail "usage: vhost-backup <domain>"
    file=$(vhost_file "$1")
    dir="$STATE/nginx/$1"
    run mkdir -p -m 700 "$dir"
    run cp "$file" "$dir/vhost"
    if [ -f "/etc/nginx/ssl/$1" ] || [ -n "$DRY" ]; then run cp "/etc/nginx/ssl/$1" "$dir/ssl"; else run rm -f "$dir/ssl"; fi ;;

  vhost-restore)
    [ $# -eq 1 ] || fail "usage: vhost-restore <domain>"
    file=$(vhost_file "$1")
    dir="$STATE/nginx/$1"
    [ -f "$dir/vhost" ] || [ -n "$DRY" ] || fail "no backup for $1: $dir/vhost"
    run cp "$dir/vhost" "$file"
    if [ -f "$dir/ssl" ] || [ -n "$DRY" ]; then run cp "$dir/ssl" "/etc/nginx/ssl/$1"; fi ;;

  vhost-enable)
    [ $# -eq 1 ] || fail "usage: vhost-enable <domain>"
    domain "$1"
    run ln -sfn "/etc/nginx/sites-available/$1" "/etc/nginx/sites-enabled/$1" ;;

  vhost-disable)
    [ $# -eq 1 ] || fail "usage: vhost-disable <domain>"
    domain "$1"
    run rm -f "/etc/nginx/sites-enabled/$1" ;;

  vhost-remove)
    [ $# -eq 1 ] || fail "usage: vhost-remove <domain>"
    domain "$1"
    # Every check first: a refused call removes nothing.
    registry_lock
    registry_find "DOMAIN=$1"
    user=$REG_FOUND
    run rm -f "/etc/nginx/sites-enabled/$1" "/etc/nginx/sites-available/$1"
    [ -z "$user" ] || registry_edit "$user" clear VHOST
    registry_unlock ;;

  vhost-set-root)
    [ $# -eq 3 ] || fail "usage: vhost-set-root <domain> <old-root> <new-root>"
    file=$(vhost_file "$1")
    home_path "$2"
    home_path "$3"
    site_root "$2" "$1"
    site_root "$3" "$1"
    owner=''
    if [[ $3 =~ ^/srv/eeploi/([a-z][a-z0-9_]{0,31})/ ]]; then owner=${BASH_REMATCH[1]}; fi
    if [ -n "$DRY" ]; then
      if [ -n "$VHOST_STAND_IN" ]; then
        conf=$(vhost_root_conf "$2" "$3" "$owner" < "$VHOST_STAND_IN")
        vhost_paths "$VHOST_STAND_IN"
        echo "write: $file (644)"
        printf '%s\n' "$conf" | sed 's/^/  /'
      else
        echo "check: the vhost's includes and logs"
        echo "rewrite: $file: root $2; to root $3;"
        [ -z "$owner" ] || echo "  disable_symlinks if_not_owner from=/srv/eeploi/$owner;"
      fi
      run nginx -t
      exit 0
    fi
    [ -f "$file" ] || fail "no vhost for $1: $file"
    conf=$(vhost_root_conf "$2" "$3" "$owner" < "$file")
    vhost_paths "$file"
    # The copy stays out of sites-enabled, so nginx never reads it.
    backup=$(mktemp)
    TMP_PATHS="$TMP_PATHS $backup"
    cp -p "$file" "$backup"
    printf '%s\n' "$conf" | put "$file" 644
    if ! out=$(nginx -t 2>&1); then
      cp -p "$backup" "$file"
      echo "$out" >&2
      fail "nginx -t failed, vhost restored: $file"
    fi ;;

  vhost-set-socket)
    [ $# -eq 3 ] || fail "usage: vhost-set-socket <domain> <from-socket> <to-socket>"
    file=$(vhost_file "$1")
    socket "$2" "$1" from
    socket "$3" "$1" to
    [ "$2" != "$3" ] || fail "from and to are the same socket: $2"
    from=$(escape_dots "$2")
    line="^[[:space:]]*fastcgi_pass unix:$from;[[:space:]]*\$"
    if [ -z "$DRY" ]; then
      [ -f "$file" ] || fail "no vhost for $1: $file"
      grep -qE "$line" "$file" || fail "no 'fastcgi_pass unix:$2;' line in $file"
      vhost_paths "$file"
      backup=$(mktemp)
      TMP_PATHS="$TMP_PATHS $backup"
      cp -p "$file" "$backup"
    elif [ -n "$VHOST_STAND_IN" ]; then
      vhost_paths "$VHOST_STAND_IN"
    else
      echo "check: the vhost's includes and logs"
    fi
    run sed -i -E "s#^([[:space:]]*)fastcgi_pass unix:$from;([[:space:]]*)\$#\\1fastcgi_pass unix:$3;\\2#" "$file"
    if [ -n "$DRY" ]; then
      run nginx -t
    elif ! out=$(nginx -t 2>&1); then
      cp -p "$backup" "$file"
      echo "$out" >&2
      fail "nginx -t failed, vhost restored: $file"
    fi
    run service nginx reload ;;

  vhost-set-cert)
    [ $# -eq 1 ] || fail "usage: vhost-set-cert <domain>"
    file=$(vhost_file "$1")
    for f in "$file" "/etc/nginx/ssl/$1"; do
      [ -f "$f" ] || [ -n "$DRY" ] || continue
      run sed -i -E "s#^(\s*)ssl_certificate\s+[^;]+;#\1ssl_certificate /etc/nginx/ssl/eeploi-$1.crt;#; s#^(\s*)ssl_certificate_key\s+[^;]+;#\1ssl_certificate_key /etc/nginx/ssl/eeploi-$1.key;#" "$f"
    done ;;

  ssl-csr)
    [ $# -eq 1 ] || fail "usage: ssl-csr <name>"
    cert_name "$1"
    key="/etc/nginx/ssl/$1.key"
    run mkdir -p /etc/nginx/ssl
    if [ ! -f "$key" ]; then
      # The key is private from the first byte: umask 077 while it is made.
      # shellcheck disable=SC2016 # $1 is for the inner shell
      run sh -c 'umask 077 && exec openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:prime256v1 -out "$1"' sh "$key"
    fi
    run chmod 600 "$key"
    run openssl req -new -key "$key" -subj "/CN=${1#eeploi-}" ;;

  ssl-write)
    [ $# -eq 1 ] || fail "usage: ssl-write <name> < certificate"
    cert_name "$1"
    pem=$(cat)
    pem_re='^-----BEGIN CERTIFICATE-----'$'\n''([A-Za-z0-9+/=]{1,76}'$'\n'')+''-----END CERTIFICATE-----$'
    [[ $pem =~ $pem_re ]] || fail "not one PEM certificate"
    printf '%s\n' "$pem" | put "/etc/nginx/ssl/$1.crt" 644 ;;

  ssl-remove)
    [ $# -eq 1 ] || fail "usage: ssl-remove <name>"
    cert_name "$1"
    run rm -f "/etc/nginx/ssl/$1.crt" "/etc/nginx/ssl/$1.key" ;;

  supervisor-write)
    [ $# -eq 4 ] || fail "usage: supervisor-write <program> <user> <directory> <processes> < command"
    program "$1"
    site_user "$2"
    site_domain=$REG_DOMAIN
    case "$1" in "eeploi-$site_domain-"?*) ;; *) fail "the program of site user $2 must start with eeploi-$site_domain-: $1" ;; esac
    # No dot after the domain, and no other listed domain that fits too: each name has one site.
    [[ ${1#"eeploi-$site_domain-"} =~ ^[a-z0-9-]+$ ]] || fail "after eeploi-$site_domain- only a-z, 0-9 and -: $1"
    case "$3" in "/srv/eeploi/$2/$site_domain/"?*) ;; *) fail "not in /srv/eeploi/$2/$site_domain: $3" ;; esac
    site_path "$2" "$3"
    [[ $4 =~ ^([1-9]|[12][0-9]|3[0-2])$ ]] || fail "processes must be 1 to 32: $4"
    worker=$(cat)
    [ -n "$worker" ] || fail "empty command"
    [[ $worker != *$'\n'* && $worker != *$'\r'* ]] || fail "the command must be one line"
    [[ $worker =~ ^[[:print:]]+$ ]] || fail "the command has control characters"
    # supervisord expands %(name)s in a command; a bad one stops it reading its config.
    [[ $worker != *%* ]] || fail "the command cannot contain %"
    file="/etc/supervisor/conf.d/$1.conf"
    # Under the lock, together with the write: who owns the name, and no other listed domain that fits.
    registry_lock
    registry_find "SUPERVISOR=$file"
    [ -z "$REG_FOUND" ] || [ "$REG_FOUND" = "$2" ] || fail "$1 belongs to site user $REG_FOUND"
    domains=$(registry_domains)
    while read -r other other_domain; do
      [ -n "$other" ] && [ "$other" != "$2" ] || continue
      case "$1" in
        "eeploi-$other_domain-"?*)
          [[ ${1#"eeploi-$other_domain-"} == *.* ]] || fail "$1 also fits site user $other ($other_domain)" ;;
      esac
    done <<< "$domains"
    # Root:<user> 750: the site reads its own worker logs, no other site does.
    logs="/var/log/supervisor/eeploi/$2"
    root_dir /var/log/supervisor/eeploi
    run install -d -o root -g "$2" -m 750 "$logs"
    if [ -n "$DRY" ]; then supervisor_conf "$1" "$2" "$3" "$4" "$worker" | sed 's/^/  /'; fi
    supervisor_conf "$1" "$2" "$3" "$4" "$worker" | put "$file" 644
    registry_edit "$2" add "SUPERVISOR=$file" set "LOGS=$logs"
    registry_unlock ;;

  supervisor-remove)
    [ $# -eq 1 ] || fail "usage: supervisor-remove <program>"
    program "$1"
    registry_lock
    registry_find "SUPERVISOR=/etc/supervisor/conf.d/$1.conf"
    run rm -f "/etc/supervisor/conf.d/$1.conf"
    [ -z "$REG_FOUND" ] || registry_edit "$REG_FOUND" del "SUPERVISOR=/etc/supervisor/conf.d/$1.conf"
    registry_unlock ;;

  supervisor-remove-site)
    [ $# -eq 1 ] || fail "usage: supervisor-remove-site <domain>"
    domain "$1"
    # Only the programs the site's registry lists (and their .paused copies): a name prefix could also
    # fit another site. Every line is checked before anything is removed.
    registry_lock
    registry_find "DOMAIN=$1"
    [ -n "$REG_FOUND" ] || exit 0
    user=$REG_FOUND
    registry_read "$user"
    files=''
    while IFS= read -r line; do
      case "$line" in SUPERVISOR=*) ;; *) continue ;; esac
      f=${line#SUPERVISOR=}
      [[ $f =~ ^/etc/supervisor/conf\.d/eeploi-[a-z0-9.-]+\.conf$ ]] || fail "invalid Supervisor config in $REG_FILE: $f"
      files="$files $f"
    done <<< "$REG_LINES"
    [ -n "$files" ] || exit 0
    for f in $files; do run rm -f "$f" "$f.paused"; done
    registry_edit "$user" clear SUPERVISOR
    registry_unlock ;;

  supervisor-pause)
    [ $# -eq 1 ] || fail "usage: supervisor-pause <config>"
    supervisor_file "$1"
    run mv "$1" "$1.paused" ;;

  supervisor-resume)
    [ $# -eq 1 ] || fail "usage: supervisor-resume <config>"
    supervisor_file "$1"
    if [ -f "$1.paused" ] || [ -n "$DRY" ]; then run mv "$1.paused" "$1"; fi ;;

  supervisor-update)
    run supervisorctl reread
    run supervisorctl update ;;

  cron-write)
    [ $# -eq 1 ] || fail "usage: cron-write <user> < line"
    site_user "$1"
    line=$(cat)
    artisan="/srv/eeploi/$1/$REG_DOMAIN/current/artisan"
    re="^\* \* \* \* \* $1 php([0-9]\.[0-9])? $(escape_dots "$artisan") schedule:run > /dev/null 2>&1$"
    [[ $line =~ $re ]] || fail "only '* * * * * $1 php $artisan schedule:run > /dev/null 2>&1' is allowed"
    # No dots in the file name: cron skips files in /etc/cron.d whose name has one.
    [ -z "$DRY" ] || printf '  %s\n' "$line"
    printf '%s\n' "$line" | put "/etc/cron.d/eeploi-$1" 644
    registry_edit "$1" set "CRON=/etc/cron.d/eeploi-$1" ;;

  cron-remove)
    [ $# -eq 1 ] || fail "usage: cron-remove <user>"
    site_user "$1"
    run rm -f "/etc/cron.d/eeploi-$1"
    registry_edit "$1" clear CRON ;;

  crontab-remove-lines)
    [ $# -eq 1 ] || fail "usage: crontab-remove-lines <domain> < lines"
    domain "$1"
    patterns=$(mktemp)
    TMP_PATHS="$TMP_PATHS $patterns"
    cat > "$patterns"
    # Only a panel's own jobs: run as ploi or forge, on a path in their home. Never system lines.
    line_re='^[^#[:space:]]+([[:space:]]+[^[:space:]]+){4}[[:space:]]+(ploi|forge)[[:space:]]+.*/home/(ploi|forge)/.*$'
    count=0
    while IFS= read -r line || [ -n "$line" ]; do
      [ -n "$line" ] || continue
      [[ $line =~ $line_re ]] || fail "only ploi or forge jobs in their home can be removed: $line"
      count=$((count + 1))
    done < "$patterns"
    [ $count -gt 0 ] || fail "no lines given"
    saved="$STATE/crontab/$1"
    if [ -n "$DRY" ]; then
      while IFS= read -r line; do [ -n "$line" ] && echo "remove from /etc/crontab: $line"; done < "$patterns"
      echo "save: $saved"
    else
      install -d -m 700 "$STATE/crontab"
      grep -xF -f "$patterns" /etc/crontab | put "$saved" 600 || true
      tmp=$(mktemp /etc/crontab.eeploi.XXXXXX)
      grep -vxF -f "$patterns" /etc/crontab > "$tmp" || true
      chmod 644 "$tmp"
      mv -f "$tmp" /etc/crontab
    fi ;;

  crontab-restore)
    [ $# -eq 1 ] || fail "usage: crontab-restore <domain>"
    domain "$1"
    saved="$STATE/crontab/$1"
    if [ -n "$DRY" ]; then
      echo "add back to /etc/crontab: the lines in $saved"
    elif [ -f "$saved" ]; then
      # Only the lines crontab-remove-lines took out, each once; later changes to /etc/crontab stay.
      tmp=$(mktemp /etc/crontab.eeploi.XXXXXX)
      cp -p /etc/crontab "$tmp"
      while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        grep -qxF -- "$line" "$tmp" || printf '%s\n' "$line" >> "$tmp"
      done < "$saved"
      chmod 644 "$tmp"
      mv -f "$tmp" /etc/crontab
      rm -f "$saved"
    fi ;;

  env-install)
    [ $# -eq 3 ] || fail "usage: env-install <from-file> <to-file> <owner>"
    source_path "$1" .env
    site_user "$3"
    site_path "$3" "$2"
    [ -f "$SRC" ] || [ -n "$DRY" ] || fail "no file: $1"
    # The panel's user reads the source (no link at the end), the site user writes the copy: root
    # opens neither path.
    # shellcheck disable=SC2016 # $1 is for the inner shell
    write='umask 027 && cat > "$1" && chmod 640 "$1"'
    cd / || fail "cannot change to /"
    if [ -n "$DRY" ]; then
      echo "run: runuser -u $SRC_OWNER -- dd if=$SRC iflag=nofollow | runuser -u $3 -- sh -c '$write' sh $2"
    else
      runuser -u "$SRC_OWNER" -- dd if="$SRC" iflag=nofollow status=none | runuser -u "$3" -- sh -c "$write" sh "$2"
    fi ;;

  storage-copy)
    [ $# -eq 3 ] || fail "usage: storage-copy <from-dir> <to-dir> <owner>"
    source_path "$1" storage
    site_user "$3"
    site_path "$3" "$2"
    # The panel's user reads the source with tar (links stay links), the site user unpacks it in its own
    # folder: root opens neither path.
    cd / || fail "cannot change to /"
    if [ -n "$DRY" ]; then
      echo "run: runuser -u $SRC_OWNER -- tar -C $SRC -cf - . | runuser -u $3 -- tar -C $2 -xf - --no-same-owner"
    elif [ -d "$SRC" ]; then
      runuser -u "$SRC_OWNER" -- tar -C "$SRC" -cf - . | runuser -u "$3" -- tar -C "$2" -xf - --no-same-owner
    fi ;;

  db-create)
    [ $# -eq 4 ] || fail "usage: db-create <engine> <name> <user> <socket|password> [< password]"
    db_engine "$1"
    db_name database "$2"
    db_name user "$3"
    db_login "$4"
    # Socket login trusts every process of that Linux user: only a site user the helper made, never
    # one that runs more than one site or a system user.
    [ "$DB_LOGIN" != socket ] || site_user "$3"
    cd / || fail "cannot change to /"
    db_client "$1"
    db_state "$1" "$2" "$3"
    case "$1" in
      mysql) [ "$S_mariadb" = 0 ] || fail "this server runs MariaDB, not MySQL" ;;
      mariadb) [ "$S_mariadb" = 1 ] || fail "this server runs MySQL, not MariaDB" ;;
    esac
    # The user gets that one database and nothing else; a database someone else can use is not taken.
    [ "$S_user_global" = 0 ] || fail "user $3 has rights beyond one database, refusing"
    [ "$S_user_elsewhere" = 0 ] || fail "user $3 has rights on another database, refusing"
    [ "$S_db_others" = 0 ] || fail "database $2 belongs to another user, refusing"
    [ "$S_db_exists" = 0 ] || [ "$S_granted" != 0 ] || fail "database $2 exists and is not $3's, refusing"
    # An existing user keeps its way in: never switched between socket and password login.
    if [ "$S_user_exists" != 0 ] && [ "$DB_LOGIN" = socket ] && [ "$S_user_socket" = 0 ]; then
      fail "user $3 exists with password login, not socket login: refusing, it is not switched"
    fi
    if [ "$S_user_exists" != 0 ] && [ "$DB_LOGIN" = password ] && [ "$S_user_socket" != 0 ]; then
      fail "user $3 exists with socket login, not password login: refusing, it is not switched"
    fi
    # A socket has no IP, so socket login never has a 127.0.0.1 user. A user there alone has a
    # password the caller can't know.
    if [ "$1" != pgsql ] && [ "$DB_LOGIN" = socket ] && [ "$S_tcp_user_exists$S_tcp_granted" != 00 ]; then
      fail "user $3 exists on 127.0.0.1 with password login, not socket login: refusing, it is not switched"
    fi
    if [ "$1" != pgsql ] && [ "$DB_LOGIN" = password ] && [ "$S_user_exists" = 0 ] && [ "$S_tcp_user_exists" != 0 ]; then
      fail "user $3 exists on 127.0.0.1 only, refusing"
    fi
    # MySQL's auth_socket is a plugin; Ubuntu installs it unless root got a password. MariaDB has
    # unix_socket built in and on since 10.4.
    DB_PLUGIN=
    if [ "$DB_LOGIN" = socket ] && [ "$1" = mysql ] && [ "$S_socket_plugin" = 0 ]; then DB_PLUGIN=1; fi
    if [ "$DB_LOGIN" = socket ] && [ "$1" = mariadb ] && [ "$S_socket_plugin" = 0 ]; then
      fail "the unix_socket plugin is not active on this MariaDB server, refusing"
    fi
    DB_NEW_USER=
    DB_NEW_DB=
    DB_GRANT=
    [ "$S_user_exists" != 0 ] || DB_NEW_USER=1
    [ "$S_db_exists" != 0 ] || DB_NEW_DB=1
    [ "$S_granted" != 0 ] || DB_GRANT=1
    # Password login on MySQL and MariaDB: a new user gets the same user on 127.0.0.1, with the same
    # password and grant. Never for a user that exists: the password on stdin could be anyone's, so a
    # 1.0.0 user stays on localhost only.
    DB_NEW_TCP_USER=
    DB_TCP_GRANT=
    if [ "$1" != pgsql ] && [ "$DB_LOGIN" = password ]; then
      [ -z "$DB_NEW_USER" ] || DB_NEW_TCP_USER=1
      if [ -n "$DB_NEW_TCP_USER" ] || [ "$S_tcp_user_exists" != 0 ]; then
        [ "$S_tcp_granted" != 0 ] || DB_TCP_GRANT=1
      fi
    fi
    if [ -z "$DB_PLUGIN$DB_NEW_USER$DB_NEW_DB$DB_GRANT$DB_NEW_TCP_USER$DB_TCP_GRANT" ]; then
      echo "exists: $1 database $2 for user $3, nothing changed ($DB_LOGIN login)"
      exit 0
    fi
    # The SQL goes on the client's stdin (printf is a shell builtin), so the password is on no command line.
    if [ -n "$DRY" ]; then
      echo "run: ${DB_CLIENT[*]} (SQL on stdin)"
      db_create_sql "$1" "$2" "$3" '<password>' | sed 's/^/  /'
    elif ! out=$(db_create_sql "$1" "$2" "$3" "$DB_PASSWORD" | "${DB_CLIENT[@]}" 2>&1); then
      # Only the error lines, without the password: psql repeats the failing statement.
      [ -z "$DB_PASSWORD" ] || out=${out//"$DB_PASSWORD"/<password>}
      printf '%s\n' "$out" | grep -E 'ERROR|FATAL' >&2 || true
      fail "$1 failed: database $2 for user $3 not created"
    fi
    if [ -n "$DB_NEW_USER" ]; then
      echo "created: $1 database $2 for user $3 ($DB_LOGIN login)"
    elif [ "$DB_LOGIN" = socket ]; then
      echo "created: $1 database $2 for user $3 (socket login, the user existed)"
    elif [ "$1" != pgsql ] && [ "$S_tcp_user_exists" = 0 ]; then
      echo "created: $1 database $2 for user $3 (password login, the user existed on localhost only, its password is unchanged)"
    else
      echo "created: $1 database $2 for user $3 (password login, the user existed, its password is unchanged)"
    fi ;;

  firewall-close-22)
    [ $# -eq 0 ] || fail "usage: firewall-close-22"
    trusted "$ETC/new-server" || fail "firewall-close-22 only runs on a server eeploi created ($ETC/new-server is missing or not root-owned)"
    run ufw delete allow 22/tcp ;;

  site-user-create)
    [ $# -eq 2 ] || fail "usage: site-user-create <user> <domain>"
    site_user_name "$1"
    domain "$2"
    home="/srv/eeploi/$1"
    # Under the lock from the domain check until the registry file is written (or taken out again):
    # two calls at once can't list one domain twice.
    root_dir "$ETC/sites"
    registry_lock
    registry_find "DOMAIN=$2"
    [ -z "$REG_FOUND" ] || [ "$REG_FOUND" = "$1" ] || fail "$2 is listed for site user $REG_FOUND"
    new=1
    if [ -e "$ETC/sites/$1" ] || [ -L "$ETC/sites/$1" ]; then
      registry_read "$1"
      [ "$REG_DOMAIN" = "$2" ] || fail "site user $1 is for $REG_DOMAIN, not $2"
      new=0
      if passwd_of "$1" > /dev/null; then
        registry_unlock
        site_user "$1" "$2"
        site_home "$1"
        echo "exists: site user $1 for $2, nothing changed"
        exit 0
      fi
    fi
    # Without a user (a new site, or a call that stopped halfway) nothing of that name may be there.
    if passwd_of "$1" > /dev/null || group_of "$1" > /dev/null || present "$home"; then
      fail "$1 exists (a user, group or $home) and is not an eeploi site user"
    fi
    if [ $new -eq 1 ]; then
      REG_FILE="$ETC/sites/$1"
      REG_LINES="DOMAIN=$2"$'\n'"HOME=$home"$'\n'
      registry_write
    fi
    root_dir /srv/eeploi
    if [ -n "$DRY" ]; then
      run useradd --home-dir "$home" --create-home --user-group --shell /usr/sbin/nologin "$1"
      echo "check: site user $1 (uid 1000 or higher, home $home, only its own group)"
    else
      if ! useradd --home-dir "$home" --create-home --user-group --shell /usr/sbin/nologin "$1"; then
        [ $new -eq 0 ] || rm -f "$ETC/sites/$1"
        fail "useradd failed: site user $1 not created"
      fi
    fi
    registry_unlock
    [ -n "$DRY" ] || site_user "$1" "$2"
    site_home "$1"
    echo "created: site user $1 for $2, home $home" ;;

  run-as)
    [ $# -eq 1 ] || fail "usage: run-as <user> < script"
    site_user "$1"
    [ ! -t 0 ] || fail "run-as needs the script on stdin, not a terminal"
    { [ ! -t 1 ] && [ ! -t 2 ]; } || fail "run-as needs its output in a pipe or a file, not a terminal"
    cd / || fail "cannot change to /"
    # setsid: the site user's shell starts in a new session, without a controlling terminal.
    # --wait keeps its exit code.
    as=(setsid --wait runuser -u "$1" -- env -i HOME="/srv/eeploi/$1" USER="$1" LOGNAME="$1" PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 /bin/bash -s)
    if [ -n "$DRY" ]; then
      run "${as[@]}"
      exit 0
    fi
    exec "${as[@]}" ;;

  releases-own)
    [ $# -eq 1 ] || fail "usage: releases-own <user>"
    site_user "$1"
    dir="/srv/eeploi/$1/$REG_DOMAIN"
    # Root works from inside the checked site folder, and chown changes a link itself, never where it
    # points (-P, -h). Only files root or the deploy user owns, and only with the kernel's hard link
    # protection on.
    if [ -n "$DRY" ]; then
      echo "check: fs.protected_hardlinks is 1"
      echo "run: cd $dir"
    else
      [ "$(cat /proc/sys/fs/protected_hardlinks 2> /dev/null)" = 1 ] || fail "fs.protected_hardlinks is off, refusing"
      cd -P -- "$dir" 2> /dev/null || fail "no site folder: $dir"
      [ "$(pwd -P)" = "$dir" ] || fail "$dir is a link, refusing"
      [[ -d releases && ! -L releases ]] || fail "no releases folder in $dir"
    fi
    for from in root "$DEPLOY_USER"; do
      run chown -R -P -h "--from=$from" "$1:" -- releases
    done ;;

  redis-create)
    [ $# -eq 1 ] || [ $# -eq 2 ] || fail "usage: redis-create <user> [<mb>]"
    site_user "$1"
    mb=128
    [ $# -eq 1 ] || mb=$2
    { [[ $mb =~ ^[1-9][0-9]{1,3}$ ]] && [ "$mb" -ge 32 ] && [ "$mb" -le 1024 ]; } \
      || fail "the Redis size must be a whole number of MB from 32 to 1024: $mb"
    unit="eeploi-redis@$1"
    dropin="/etc/systemd/system/$unit.service.d/memory.conf"
    conf="$ETC/redis/$1.conf"
    data="/srv/eeploi/$1/.redis"
    root_dir "$ETC/redis"
    root_dir "${dropin%/*}"
    # The template, the config and the drop-in are kept first: a failed restart puts all three back.
    [ -n "$DRY" ] || keep "$REDIS_TEMPLATE" "$conf" "$dropin"
    # The template is the same for every site: written when it is missing or differs.
    if [ -n "$DRY" ] || ! redis_unit | cmp -s - "$REDIS_TEMPLATE"; then
      [ -z "$DRY" ] || redis_unit | sed 's/^/  /'
      redis_unit | put "$REDIS_TEMPLATE" 644
    fi
    [ -z "$DRY" ] || redis_conf "$1" "$mb" | sed 's/^/  /'
    redis_conf "$1" "$mb" | put "$conf" 644
    [ -z "$DRY" ] || redis_dropin "$mb" | sed 's/^/  /'
    redis_dropin "$mb" | put "$dropin" 644
    run systemctl daemon-reload
    # The site user makes its own folder: root writes nothing inside the home.
    cd / || fail "cannot change to /"
    run runuser -u "$1" -- install -d -m 700 "$data"
    state=stopped
    if running "$unit.service"; then
      if [ -n "$DRY" ]; then
        run systemctl restart "$unit"
      elif ! out=$(systemctl restart "$unit" 2>&1); then
        restore_kept
        systemctl daemon-reload
        systemctl restart "$unit" > /dev/null 2>&1 || true
        echo "$out" >&2
        fail "Redis of $1 did not restart, previous unit, config and drop-in restored"
      fi
      state=restarted
    fi
    # Only after a good restart, or when nothing was running.
    registry_edit "$1" set "REDIS_UNIT=$unit.service" "REDIS_DROPIN=$dropin" "REDIS_CONF=$conf" "REDIS_SOCKET=$data/redis.sock"
    echo "prepared: Redis of site user $1, $mb MB, $state" ;;

  redis-start)
    [ $# -eq 1 ] || fail "usage: redis-start <user>"
    site_user "$1"
    case $'\n'"$REG_LINES" in *$'\n'REDIS_CONF=*) ;; *) fail "no Redis for site user $1 yet: run redis-create first" ;; esac
    if [ -z "$DRY" ]; then
      { trusted "$ETC/redis/$1.conf" && trusted "/etc/systemd/system/eeploi-redis@$1.service.d/memory.conf" && [ -f "$REDIS_TEMPLATE" ]; } \
        || fail "no Redis for site user $1 yet: run redis-create first"
      [ -x /usr/bin/redis-server ] || fail "Redis is not installed on this server (no /usr/bin/redis-server): install the redis-server package first"
    else
      present /usr/bin/redis-server || fail "Redis is not installed on this server (no /usr/bin/redis-server): install the redis-server package first"
    fi
    run systemctl enable --now "eeploi-redis@$1" ;;

  redis-stop)
    [ $# -eq 1 ] || fail "usage: redis-stop <user>"
    site_user "$1"
    # Its data stays in the home, so it is there again when Redis is switched back on.
    run systemctl disable --now "eeploi-redis@$1" ;;

  php-pool-write)
    [ $# -eq 2 ] || fail "usage: php-pool-write <version> <user>"
    php_version "$1"
    site_user "$2"
    dir="/etc/php/$1/fpm/pool.d"
    file="$dir/eeploi-$2.conf"
    ini="/etc/php/$1/fpm/conf.d/90-eeploi.ini"
    # One pool per site: the pool of another PHP version that the registry lists goes, once the new one
    # passes its test.
    old='' old_version=''
    while IFS= read -r line; do
      case "$line" in POOL=*) old=${line#POOL=} ;; esac
    done <<< "$REG_LINES"
    if [ -n "$old" ] && [ "$old" != "$file" ]; then
      [[ $old =~ ^/etc/php/([0-9]\.[0-9])/fpm/pool\.d/eeploi-$2\.conf$ ]] || fail "invalid POOL in $REG_FILE: $old"
      old_version=${BASH_REMATCH[1]}
    else
      old=''
    fi
    if [ -n "$DRY" ]; then
      echo "write: $file (644)"
      pool_conf "$1" "$2" | sed 's/^/  /'
      echo "write: $ini (644)"
      opcache_ini | sed 's/^/  /'
      run "php-fpm$1" -t
      if [ -n "$old" ]; then
        run rm -f "$old"
        run "php-fpm$old_version" -t
      fi
      registry_edit "$2" set "POOL=$file"
      run service "php$1-fpm" reload
      [ -z "$old" ] || run service "php$old_version-fpm" reload
      exit 0
    fi
    [[ -d $dir && ! -L $dir ]] || fail "PHP $1 FPM is not installed: $dir"
    [[ -d ${ini%/*} && ! -L ${ini%/*} ]] || fail "PHP $1 FPM is not installed: ${ini%/*}"
    command -v "php-fpm$1" > /dev/null || fail "php-fpm$1 not found"
    keep "$file" "$ini"
    pool_conf "$1" "$2" | put "$file" 644
    opcache_ini | put "$ini" 644
    if ! out=$("php-fpm$1" -t 2>&1); then
      restore_kept
      echo "$out" >&2
      fail "php-fpm$1 -t failed, previous pool restored"
    fi
    if [ -n "$old" ] && [ -f "$old" ]; then
      old_backup=$(mktemp "${old%/*}/.${old##*/}.backup.XXXXXX")
      TMP_PATHS="$TMP_PATHS $old_backup"
      cp -p "$old" "$old_backup"
      rm -f "$old"
      if command -v "php-fpm$old_version" > /dev/null && ! out=$("php-fpm$old_version" -t 2>&1); then
        mv -f "$old_backup" "$old"
        restore_kept
        echo "$out" >&2
        fail "php-fpm$old_version -t failed without the PHP $old_version pool, both pools restored"
      fi
    fi
    registry_edit "$2" set "POOL=$file"
    service "php$1-fpm" reload
    if [ -n "$old" ]; then
      service "php$old_version-fpm" reload || echo "eeploi-helper: php$old_version-fpm did not reload, the PHP $old_version pool stays until it does" >&2
    fi ;;

  self-update)
    [ $# -eq 1 ] || fail "usage: self-update <version>"
    semver='^(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})$'
    [[ $1 =~ $semver ]] || fail "invalid version: $1"
    version_lt "$VERSION" "$1" || fail "only a newer version: $VERSION is installed, $1 is not newer"
    key_re='^RW[A-Za-z0-9+/]{54}$'
    case "$PUBKEY" in *REPLACE_WITH_RELEASE_KEY*) fail "no release key in this build (PUBKEY is the placeholder), self-update refused" ;; esac
    [[ $PUBKEY =~ $key_re ]] || fail "invalid release key in this build, self-update refused"
    url="$RELEASES/v$1/eeploi-helper"
    # -q first: curl reads no curlrc.
    fetch=(curl -q --fail --silent --show-error --location --proto '=https' --proto-redir '=https'
      --connect-timeout 10 --max-time 120 --max-filesize 1048576)
    if [ -n "$DRY" ]; then
      echo "download: $url"
      echo "download: $url.minisig"
      echo "run: ${fetch[*]} -o <download>/<file> <url>"
      echo "run: minisign -V -q -P $PUBKEY -m <download>/eeploi-helper -x <download>/eeploi-helper.minisig"
      echo "run: bash -n <download>/eeploi-helper"
      echo "check: <download>/eeploi-helper version = $1"
      echo "install: $INSTALL_PATH (root:root 755)"
      exit 0
    fi
    command -v curl > /dev/null || fail "curl not found"
    command -v minisign > /dev/null || fail "minisign not found"
    work=$(mktemp -d)
    TMP_PATHS="$TMP_PATHS $work"
    for f in eeploi-helper eeploi-helper.minisig; do
      "${fetch[@]}" -o "$work/$f" "$RELEASES/v$1/$f" || fail "download failed: $RELEASES/v$1/$f"
    done
    minisign -V -q -P "$PUBKEY" -m "$work/eeploi-helper" -x "$work/eeploi-helper.minisig" \
      || fail "signature check failed, nothing changed"
    bash -n "$work/eeploi-helper" || fail "the new helper is not valid bash, nothing changed"
    got=$(env -i PATH="$PATH" SUDO_USER="$CALLER" bash "$work/eeploi-helper" version 2>&1) \
      || fail "the new helper does not run, nothing changed"
    [ "$got" = "$1" ] || fail "the new helper says version $got, expected $1, nothing changed"
    new=$(mktemp "$INSTALL_PATH.eeploi.XXXXXX")
    TMP_PATHS="$TMP_PATHS $new"
    cp "$work/eeploi-helper" "$new"
    chown root:root "$new"
    chmod 755 "$new"
    mv -f "$new" "$INSTALL_PATH"
    echo "eeploi-helper $VERSION -> $1"
    exit 0 ;;

  *)
    fail "unknown subcommand: $command" ;;
esac
