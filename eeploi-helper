#!/bin/bash
# eeploi-helper: the only command the deploy user may run as root (/etc/sudoers.d/eeploi).
# Every argument is checked, every action is fixed. Content comes on stdin.
# Source, releases and signatures: https://github.com/eeploi/helper
set -euo pipefail
# D-3: the umask, PATH, HOME, TMPDIR and the locale are the helper's, never the caller's.
umask 022
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TMPDIR=/tmp HOME=/root LC_ALL=C

VERSION='1.3.0'

# The minisign public key releases are signed with (minisign.pub, key id A2C97024AB6219A8).
PUBKEY='RWSoGWKrJHDJoknVaEcX3dz5ew9zWZPqae2Qn2d3M+SGxNBT99NZGiLA'
RELEASES='https://github.com/eeploi/helper/releases/download'
# The minisign public key recipes releases are signed with (key id D03C6EB200F583F7), apart from
# the helper's own.
# D-17: a key of its own for the recipes.
RECIPES_PUBKEY='RWT3g/UAsm480Ibrzxyna96ZDXOB5syhhY8q5+bir9rhKkA02c3rqRkD'
RECIPES_RELEASES='https://github.com/eeploi/recipes/releases/download'
# Downloads: HTTPS only, also after a redirect; -q first, so curl reads no curlrc. Each caller adds
# --max-filesize.
FETCH=(curl -q --fail --silent --show-error --location --proto '=https' --proto-redir '=https'
  --connect-timeout 10 --max-time 120)
# A release version: three numbers, no leading zeros, small enough to compare as numbers.
SEMVER_RE='^(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})\.(0|[1-9][0-9]{0,3})$'
INSTALL_PATH=/usr/local/sbin/eeploi-helper

# D-12: the dry run and its overrides come from the environment, which sudo resets.
DRY="${EEPLOI_HELPER_DRY_RUN:-}"
CALLER="${SUDO_USER:-}"

# Root-owned eeploi state: helper.conf (DEPLOY_USER=...), the new-server marker, the site registry
# (sites/<user>) and the Redis configs (redis/<user>.conf).
# The overrides are for tests and only count in dry-run mode. EEPLOI_HELPER_DB_STATE stands in for
# what db-create's checks would find on the database server, EEPLOI_HELPER_SYSTEM for the users,
# groups, paths and running units the site-user checks would find (see stand_in),
# EEPLOI_HELPER_VHOST for the vhost vhost-set-root rewrites (the result is printed) and
# vhost-set-socket checks,
# EEPLOI_HELPER_NGINX_LOGS for nginx's log folder, EEPLOI_HELPER_OS_RELEASE for os-release,
# EEPLOI_HELPER_RECIPES_STATE for recipe-run's state folder, EEPLOI_HELPER_RECIPES_DOWNLOAD for the
# recipes release (a folder with its files) and EEPLOI_HELPER_RECIPES_RESULTS for which steps and
# checks fail ("fail <path>" lines) and whether another run holds the lock ("locked"),
# EEPLOI_HELPER_MINISIGN for a minisign outside PATH, EEPLOI_HELPER_NOW for the time recipe-run writes
# in its state, EEPLOI_HELPER_REPORT for what server-report reads from the system (a folder with the
# files kernel, uptime, failed and ss, the output of uname -r, /proc/uptime, systemctl --failed and ss),
# EEPLOI_HELPER_REBOOT_STATE for the file with the time of the last reboot server-reboot started.
ETC=/etc/eeploi
NGINX_CONF=/etc/nginx/nginx.conf
NGINX_LOGS=/var/log/nginx
OS_RELEASE=/etc/os-release
RECIPES_STATE=/var/lib/eeploi/recipes
REBOOT_STATE=/var/lib/eeploi/reboot
DB_STATE=
SYSTEM=
VHOST_STAND_IN=
RECIPES_DOWNLOAD=
RECIPES_RESULTS=
MINISIGN=minisign
NOW=
REPORT_STAND_IN=
# D-13: every signature check: -H accepts only a prehashed (ED) signature, a legacy (Ed) one is refused.
VERIFY=(-V -H -q)
if [ -n "$DRY" ]; then
  MINISIGN="${EEPLOI_HELPER_MINISIGN:-$MINISIGN}"
  RECIPES_DOWNLOAD="${EEPLOI_HELPER_RECIPES_DOWNLOAD:-}"
  RECIPES_RESULTS="${EEPLOI_HELPER_RECIPES_RESULTS:-}"
  NOW="${EEPLOI_HELPER_NOW:-}"
  REPORT_STAND_IN="${EEPLOI_HELPER_REPORT:-}"
  ETC="${EEPLOI_HELPER_ETC:-$ETC}"
  NGINX_CONF="${EEPLOI_HELPER_NGINX_CONF:-$NGINX_CONF}"
  NGINX_LOGS="${EEPLOI_HELPER_NGINX_LOGS:-$NGINX_LOGS}"
  OS_RELEASE="${EEPLOI_HELPER_OS_RELEASE:-$OS_RELEASE}"
  RECIPES_STATE="${EEPLOI_HELPER_RECIPES_STATE:-$RECIPES_STATE}"
  REBOOT_STATE="${EEPLOI_HELPER_REBOOT_STATE:-$REBOOT_STATE}"
  DB_STATE="${EEPLOI_HELPER_DB_STATE:-}"
  SYSTEM="${EEPLOI_HELPER_SYSTEM:-}"
  VHOST_STAND_IN="${EEPLOI_HELPER_VHOST:-}"
fi

# A refusal exits 64. recipe-run sets FAIL_EXIT to 1 once its steps start: then something ran.
FAIL_EXIT=64
fail() { echo "eeploi-helper: $*" >&2; exit "$FAIL_EXIT"; }

# Temporary files and folders, removed on every exit.
TMP_PATHS=""
cleanup() {
  local p
  for p in $TMP_PATHS; do rm -rf -- "$p"; done
}
trap cleanup EXIT

run() {
  if [ -n "$DRY" ]; then printf 'run:'; printf ' %s' "$@"; printf '\n'; else "$@"; fi
}

# put <file> <mode>: write stdin to the file, atomically, owned by root.
put() {
  if [ -n "$DRY" ]; then cat > /dev/null; echo "write: $1 ($2)"; return; fi
  local tmp
  tmp=$(mktemp "$1.eeploi.XXXXXX")
  cat > "$tmp"
  chmod "$2" "$tmp"
  chown root:root "$tmp"
  mv -f "$tmp" "$1"
}

# closed <-d|-f> <path>: a folder or regular file (no link), owned by the user running the helper
# (root through sudo) and not writable by group or others.
# D-4: root reads and runs only files root alone can change.
closed() {
  if [ "$1" = -d ]; then [ -d "$2" ]; else [ -f "$2" ]; fi && [[ ! -L $2 && -O $2 ]] && [ -z "$(find "$2" -maxdepth 0 \( -perm -020 -o -perm -002 \) 2> /dev/null)" ]
}

# trusted <path>: a closed file in a closed folder.
trusted() { closed -f "$1" && closed -d "$(dirname -- "$1")"; }


# The deploy user: eeploi, or DEPLOY_USER from helper.conf. The file is parsed, never sourced.
# recipes.conf names it too, by the same rule.
DEPLOY_USER_NAME='[a-z][a-z0-9_-]{1,31}'
DEPLOY_USER=eeploi
CONF="$ETC/helper.conf"
if [ -e "$CONF" ] || [ -L "$CONF" ]; then
  trusted "$CONF" || fail "untrusted config: $CONF (must be a root-owned file, not writable by others)"
  conf_re="^DEPLOY_USER=($DEPLOY_USER_NAME)$"
  seen=0
  # D-5: parsed line by line, never sourced.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    [[ $line =~ $conf_re ]] || fail "invalid line in $CONF: $line"
    [ $seen -eq 0 ] || fail "DEPLOY_USER is set twice in $CONF"
    DEPLOY_USER=${BASH_REMATCH[1]}
    seen=1
  done < "$CONF"
  [ "$DEPLOY_USER" != root ] || fail "the deploy user cannot be root"
fi

HOMES='ploi|forge|eeploi'
case "|$HOMES|" in *"|$DEPLOY_USER|"*) ;; *) HOMES="$HOMES|$DEPLOY_USER" ;; esac

domain() {
  local re='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'
  [[ $1 =~ $re ]] || fail "invalid domain: $1"
}

# A certificate name: the domain, or eeploi-<domain> for one made at a take-over.
cert_name() { domain "${1#eeploi-}"; }

program() {
  local re='^eeploi-[a-z0-9.-]+$'
  [[ $1 =~ $re ]] || fail "invalid program: $1"
}

php_version() {
  local re='^[0-9]\.[0-9]$'
  [[ $1 =~ $re ]] || fail "invalid PHP version: $1"
}

# socket <socket> <domain> <from|to>: a PHP-FPM socket in /run/php or /var/run/php. to: only the pool of
# the site user listed for that domain. from: also a socket a vhost may still use: the default one per
# version, eeploi 1.0.1's php<v>-fpm-eeploi.sock, or a panel's pool per user (php<v>-fpm-<user>.sock).
# Another site user's pool is never a from-socket.
socket() {
  local re='^(/var)?/run/php/php[0-9]+\.[0-9]+-fpm(-([a-z][a-z0-9_-]{0,31}))?\.sock$'
  [[ $1 =~ $re ]] || fail "invalid PHP-FPM socket: $1"
  local user=${BASH_REMATCH[3]}
  if [ "$3" = from ]; then
    [ -n "$user" ] || return 0
    [ -e "$ETC/sites/$user" ] || [ -L "$ETC/sites/$user" ] || return 0
  else
    [ -n "$user" ] || fail "invalid PHP-FPM socket: $1 (the new socket is the pool of the site user of $2)"
  fi
  ( site_user "$user" "$2" ) > /dev/null 2>&1 \
    || fail "invalid PHP-FPM socket: $1 ($user is not the eeploi site user of $2)"
}

# site_root <path> <domain>: a path in a site user's home must be in the folder of that user's own
# listed domain, /srv/eeploi/<user>/<domain>/. Other paths pass unchanged.
site_root() {
  local re='^/srv/eeploi/([a-z][a-z0-9_]{0,31})/'
  [[ $1 =~ $re ]] || return 0
  local user=${BASH_REMATCH[1]}
  site_user "$user" "$2"
  case "$1" in "/srv/eeploi/$user/$2/"?*) ;; *) fail "not in /srv/eeploi/$user/$2: $1" ;; esac
}

# home_path <path>: a path inside one of the allowed home folders, or in the home of a listed site
# user (/srv/eeploi/<user>/...).
home_path() {
  local p=$1 re="^/home/($HOMES)/[A-Za-z0-9._/-]+$" site_re='^/srv/eeploi/([a-z][a-z0-9_]{0,31})/[A-Za-z0-9._/-]+$'
  case "$p/" in */../*|*/./*|*//*) fail "invalid path: $p" ;; esac
  if [[ $p =~ $site_re ]]; then
    re="^/srv/eeploi/${BASH_REMATCH[1]}/[A-Za-z0-9._/-]+$"
    site_user "${BASH_REMATCH[1]}"
  fi
  [[ $p =~ $re ]] || fail "outside the allowed home folders: $p"
  if realpath -m / > /dev/null 2>&1; then
    local resolved
    resolved=$(realpath -m -- "$p")
    [[ $resolved =~ $re ]] || fail "resolves outside the allowed home folders: $p"
  fi
}

# site_path <user> <path>: a path inside the home of that listed site user.
site_path() {
  case "$2" in "/srv/eeploi/$1/"*) ;; *) fail "not in /srv/eeploi/$1: $2" ;; esac
  home_path "$2"
}

supervisor_file() {
  local re='^/etc/supervisor/conf\.d/(worker|daemon|eeploi)-[A-Za-z0-9._-]+\.conf$'
  [[ $1 =~ $re ]] || fail "invalid Supervisor config: $1"
}

# The vhost a domain uses: the target of sites-enabled/<domain>, else sites-available/<domain>.
vhost_file() {
  domain "$1"
  local enabled="/etc/nginx/sites-enabled/$1" target
  if [ -L "$enabled" ]; then
    target=$(readlink -f "$enabled")
    case "$target" in /etc/nginx/sites-available/*|/etc/nginx/sites-enabled/*) echo "$target" ;; *) fail "vhost link points outside nginx: $enabled" ;; esac
  elif [ -f "$enabled" ]; then
    echo "$enabled"
  else
    echo "/etc/nginx/sites-available/$1"
  fi
}

# acl_package: install the acl package (setfacl) when it is missing, and only that package.
acl_package() {
  if [ -n "$DRY" ]; then
    echo "check: setfacl installed, else apt-get install acl"
  elif ! command -v setfacl > /dev/null 2>&1; then
    { apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq acl > /dev/null; } < /dev/null \
      || fail "cannot install the acl package"
  fi
}

# nginx_user: set NGINX_USER and NGINX_GROUP from the one `user` line in nginx.conf (www-data without one).
nginx_user() {
  local line found=0 start_re='^[[:space:]]*user([[:space:]]|;|$)'
  local re='^[[:space:]]*user[[:space:]]+([a-z_][a-z0-9_-]{0,31})([[:space:]]+([a-z_][a-z0-9_-]{0,31}))?[[:space:]]*;[[:space:]]*(#.*)?$'
  [ -f "$NGINX_CONF" ] || fail "nginx config not found: $NGINX_CONF"
  NGINX_USER=www-data
  NGINX_GROUP=
  while IFS= read -r line || [ -n "$line" ]; do
    [[ $line =~ $start_re ]] || continue
    [ $found -eq 0 ] || fail "more than one user line in $NGINX_CONF"
    [[ $line =~ $re ]] || fail "cannot read the user line in $NGINX_CONF: $line"
    NGINX_USER=${BASH_REMATCH[1]}
    NGINX_GROUP=${BASH_REMATCH[3]:-}
    found=1
  done < "$NGINX_CONF"
  [ -n "$NGINX_GROUP" ] || NGINX_GROUP=$NGINX_USER
  [[ $NGINX_USER != root && $NGINX_GROUP != root ]] || fail "nginx runs as root, refusing"
  if [ -n "$DRY" ]; then
    echo "check: user $NGINX_USER and group $NGINX_GROUP exist"
  else
    id -u "$NGINX_USER" > /dev/null 2>&1 || fail "nginx user does not exist: $NGINX_USER"
    getent group "$NGINX_GROUP" > /dev/null 2>&1 || fail "nginx group does not exist: $NGINX_GROUP"
  fi
}

# stand_in <prefix>: in a dry run, the rest of the first EEPLOI_HELPER_SYSTEM line that starts with
# <prefix>. The lines: "passwd <getent passwd line>", "group <getent group line>",
# "id <user>:<id -G output>", "path <path that exists>", "active <running unit>" and
# "description <unit> <text>" and "boot-id <id>".
stand_in() {
  local line
  [ -n "$SYSTEM" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "$1"*) printf '%s\n' "${line#"$1"}"; return 0 ;; esac
  done < "$SYSTEM"
  return 1
}

# What the server has: a user's passwd line, its group's line, its groups, a path, a running unit.
passwd_of() {
  local rest
  if [ -z "$DRY" ]; then getent passwd "$1"; return; fi
  rest=$(stand_in "passwd $1:") || return 1
  echo "$1:$rest"
}
group_of() {
  local rest
  if [ -z "$DRY" ]; then getent group "$1"; return; fi
  rest=$(stand_in "group $1:") || return 1
  echo "$1:$rest"
}
groups_of() {
  if [ -z "$DRY" ]; then id -G "$1"; else stand_in "id $1:"; fi
}
present() {
  if [ -z "$DRY" ]; then [ -e "$1" ] || [ -L "$1" ]; else [ -n "$SYSTEM" ] && grep -qxF -- "path $1" "$SYSTEM"; fi
}
running() {
  if [ -z "$DRY" ]; then systemctl is-active --quiet "$1"; else [ -n "$SYSTEM" ] && grep -qxF -- "active $1" "$SYSTEM"; fi
}

# root_dir <folder>: a root-owned folder (755), made when missing. One that is there must be
# root-owned, not a link and not writable by others.
root_dir() {
  if [ -n "$DRY" ]; then
    [ -d "$1" ] || present "$1" || echo "run: install -d -o root -g root -m 755 $1"
  elif [ -e "$1" ] || [ -L "$1" ]; then
    closed -d "$1" || fail "$1 must be a root-owned folder, not writable by others"
  else
    install -d -o root -g root -m 755 "$1"
  fi
}

# A site user: one Linux user per site, home /srv/eeploi/<user>, listed in the registry.
SITE_USER_RE='^[a-z][a-z0-9_]{0,31}$'

# Names a site user never gets: the system's own users, panels and services, and the standard groups
# that grant root or close to it. useradd makes a group of the user's name, and a package installed
# later keeps a group that is already there, so these are refused also while the group doesn't exist.
RESERVED_USERS='root|eeploi|ploi|forge|ubuntu|www-data|postgres|mysql|redis|nobody|nogroup'
RESERVED_GROUPS='admin|wheel|sudo|adm|staff|shadow|disk|kmem|tty|utmp|crontab|docker|lxd|incus|incus-admin|libvirt|libvirt-qemu|kvm|video|render|input|sgx|systemd-journal|systemd-network|lpadmin|sambashare|operator|daemon|bin|sys|backup|syslog|ssl-cert'

# site_user_name <user>: a valid name with an _ after the first letter, and not one of the system's, a
# panel's, a powerful group or the deploy user.
# D-24: one Linux user per site, named with an _, in no group but its own.
site_user_name() {
  [[ $1 =~ $SITE_USER_RE ]] || fail "invalid site user: $1 (a-z, 0-9 and _, starting with a letter, at most 32)"
  nginx_user
  case "|$RESERVED_USERS|$RESERVED_GROUPS|$DEPLOY_USER|$NGINX_USER|$NGINX_GROUP|" in
    *"|$1|"*) fail "reserved name, not a site user: $1" ;;
  esac
  # No standard user or group of the system or of a package has one.
  case "${1:1}" in *_*) ;; *) fail "a site user needs an _ after its first letter, like shop_example: $1" ;; esac
}

# The registry, $ETC/sites/<user>: DOMAIN=<domain> and every file and place of the site, one
# KEY=value line each. Root-owned, parsed line by line, never sourced. Only DOMAIN is used for checks.
REG_KEYS='DOMAIN|HOME|VHOST|POOL|CRON|SUPERVISOR|LOGS|REDIS_UNIT|REDIS_DROPIN|REDIS_CONF|REDIS_SOCKET'
REG_FILE='' REG_DOMAIN='' REG_LINES='' REG_FOUND='' REG_ALL='' REG_SCANNED=0 REG_LOCKS=0 SITE_USER_OK=''

# registry_read <user>: sets REG_FILE, REG_DOMAIN and REG_LINES (the KEY=value lines, in order).
registry_read() {
  local line re="^($REG_KEYS)=([A-Za-z0-9@._/-]+)$"
  REG_FILE="$ETC/sites/$1"
  REG_DOMAIN=
  REG_LINES=
  [ -e "$REG_FILE" ] || [ -L "$REG_FILE" ] || fail "$1 is not an eeploi site user (not in $ETC/sites)"
  trusted "$REG_FILE" || fail "untrusted site registry: $REG_FILE (must be a root-owned file, not writable by others)"
  # D-5: parsed line by line, never sourced.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    [[ $line =~ $re ]] || fail "invalid line in $REG_FILE: $line"
    if [ "${BASH_REMATCH[1]}" = DOMAIN ]; then
      [ -z "$REG_DOMAIN" ] || fail "DOMAIN is set twice in $REG_FILE"
      REG_DOMAIN=${BASH_REMATCH[2]}
    fi
    REG_LINES="$REG_LINES$line"$'\n'
  done < "$REG_FILE"
  [ -n "$REG_DOMAIN" ] || fail "no DOMAIN in $REG_FILE"
  domain "$REG_DOMAIN"
}

# registry_write: REG_LINES to REG_FILE (a dry run prints them).
registry_write() {
  local text
  text="# Written by eeploi-helper: this site's domain and every file and place of it. Do not edit."$'\n'"$REG_LINES"
  [ -z "$DRY" ] || printf '%s' "$text" | sed 's/^/  /'
  printf '%s' "$text" | put "$REG_FILE" 644
  REG_SCANNED=0
}

# registry_edit <user> <set|add|del|clear> <KEY=value|KEY>... [<mode> <KEY=value|KEY>...]: change the
# site's registry in one write, under a lock. set: one line for KEY, replaced in place or added;
# add: the line, once; del: that line out; clear: every line of KEY out.
registry_edit() {
  local user=$1 mode pair key line new found
  shift
  registry_lock
  registry_read "$user"
  for pair in "$@"; do
    case "$pair" in set|add|del|clear) mode=$pair; continue ;; esac
    key=${pair%%=*}
    new=''
    found=0
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      case "$mode" in
        set) if [ "${line%%=*}" = "$key" ]; then [ $found -eq 0 ] || continue; line=$pair; found=1; fi ;;
        add) [ "$line" != "$pair" ] || found=1 ;;
        del) [ "$line" != "$pair" ] || continue ;;
        clear) [ "${line%%=*}" != "$key" ] || continue ;;
      esac
      new="$new$line"$'\n'
    done <<< "$REG_LINES"
    case "$mode" in set|add) [ $found -eq 1 ] || new="$new$pair"$'\n' ;; esac
    REG_LINES=$new
  done
  registry_write
  registry_unlock
}

# registry_lock, registry_unlock: one writer of the registry at a time (fd 9, closed before any runuser).
# They nest: only the outer pair takes and drops the lock. Taking it starts a fresh scan.
registry_lock() {
  REG_LOCKS=$((REG_LOCKS + 1))
  [ $REG_LOCKS -eq 1 ] || return 0
  REG_SCANNED=0
  [ -z "$DRY" ] || return 0
  root_dir "$ETC/sites"
  exec 9> "$ETC/sites/.lock"
  flock 9 || fail "cannot lock $ETC/sites"
}
registry_unlock() {
  REG_LOCKS=$((REG_LOCKS - 1))
  [ $REG_LOCKS -eq 0 ] || return 0
  [ -n "$DRY" ] || exec 9>&-
}

# registry_scan: read every registry once per call into REG_ALL ("<user> KEY=value" lines). Any
# untrusted or invalid registry stops the call. REG_FILE, REG_DOMAIN and REG_LINES stay as they were.
registry_scan() {
  [ $REG_SCANNED -eq 0 ] || return 0
  local f user line file=$REG_FILE dom=$REG_DOMAIN lines=$REG_LINES
  REG_ALL=''
  if [ -d "$ETC/sites" ]; then
    for f in "$ETC/sites"/*; do
      user=${f##*/}
      [[ $user =~ $SITE_USER_RE ]] || continue
      registry_read "$user"
      while IFS= read -r line; do
        [ -z "$line" ] || REG_ALL="$REG_ALL$user $line"$'\n'
      done <<< "$REG_LINES"
    done
  fi
  REG_FILE=$file REG_DOMAIN=$dom REG_LINES=$lines REG_SCANNED=1
}

# registry_find <KEY=value>: REG_FOUND is the site user whose registry has that exact line, or empty.
registry_find() {
  local user line
  registry_scan
  REG_FOUND=''
  while read -r user line; do
    if [ -n "$user" ] && [ "$line" = "$1" ]; then REG_FOUND=$user; return 0; fi
  done <<< "$REG_ALL"
}

# registry_domains: every listed site user and its domain, as "<user> <domain>" lines.
registry_domains() {
  local user line
  registry_scan
  while read -r user line; do
    case "$line" in DOMAIN=*) echo "$user ${line#DOMAIN=}" ;; esac
  done <<< "$REG_ALL"
}

# registry_forget <KEY=value>: that line out of the registry that has it.
registry_forget() {
  registry_find "$1"
  [ -z "$REG_FOUND" ] || registry_edit "$REG_FOUND" del "$1"
}

# site_account <user>: the Linux user exists with uid 1000 or higher and home /srv/eeploi/<user>,
# and is in no group but its own.
site_account() {
  local pw name uid gid home gr gname ggid groups
  pw=$(passwd_of "$1") || fail "no Linux user $1 on this server"
  IFS=: read -r name _ uid gid _ home _ <<< "$pw"
  [ "$name" = "$1" ] && [[ $uid =~ ^[0-9]+$ && $gid =~ ^[0-9]+$ ]] || fail "cannot read the Linux user $1"
  [ "$uid" -ge 1000 ] || fail "$1 is a system user (uid $uid), not a site user"
  [ "$home" = "/srv/eeploi/$1" ] || fail "$1 has home $home, not /srv/eeploi/$1"
  gr=$(group_of "$1") || fail "no group $1 on this server"
  IFS=: read -r gname _ ggid _ <<< "$gr"
  [ "$gname" = "$1" ] && [ "$ggid" = "$gid" ] || fail "the group of $1 is not its own group $1"
  groups=$(groups_of "$1") || fail "cannot read the groups of $1"
  [ "$groups" = "$gid" ] || fail "$1 is in other groups too (ids $groups), not a site user"
}

# site_user <user> [<domain>]: a site user eeploi made. Its name is valid and not reserved, its
# registry is trusted (and lists <domain>, when given), and site_account passes. Sets REG_*. A user
# that passed once in this call isn't checked again; its registry is still read.
site_user() {
  [ "$SITE_USER_OK" = "ok:$1" ] || site_user_name "$1"
  registry_read "$1"
  [ -z "${2:-}" ] || [ "$REG_DOMAIN" = "$2" ] || fail "site user $1 is for $REG_DOMAIN, not $2"
  [ "$SITE_USER_OK" = "ok:$1" ] || site_account "$1"
  SITE_USER_OK="ok:$1"
}

# site_home <user>: the home is 750, and only the nginx user may pass through (an ACL with x).
# Root changes the folder itself, never anything in it; /srv/eeploi is root's, so it can't be swapped.
site_home() {
  local home="/srv/eeploi/$1" uid
  if [ -z "$DRY" ]; then
    [[ -d $home && ! -L $home ]] || fail "no home folder: $home"
    uid=$(passwd_of "$1" | cut -d: -f3)
    [ "$(stat -c %u -- "$home")" = "$uid" ] || fail "$home is not owned by $1"
  fi
  acl_package
  run chmod 750 "$home"
  run setfacl -m "u:$NGINX_USER:x" "$home"
}

# keep <file>...: copy each file that exists aside, so restore_kept can put them back (or remove a
# new one). Checked paths only: no spaces or colons.
keep() {
  local f b
  KEPT=''
  for f in "$@"; do
    b=-
    if [ -f "$f" ]; then
      b=$(mktemp "${f%/*}/.${f##*/}.backup.XXXXXX")
      TMP_PATHS="$TMP_PATHS $b"
      cp -p "$f" "$b"
    fi
    KEPT="$KEPT $f:$b"
  done
}
restore_kept() {
  local pair
  for pair in $KEPT; do
    if [ "${pair#*:}" != - ]; then mv -f "${pair#*:}" "${pair%%:*}"; else rm -f "${pair%%:*}"; fi
  done
}

# source_path <path> <name>: a path named <name> (.env, storage) in another panel's home (/home/ploi,
# /home/forge), never the caller's own. Sets SRC to where it really is (Ploi's site folder is a link),
# which must still be in that same home and still be named <name>, and SRC_OWNER to that panel's user.
# The source is read as SRC_OWNER, never as root: a folder swapped after this check gives it only what
# it may read anyway.
source_path() {
  home_path "$1"
  local re='^/home/(ploi|forge)/[A-Za-z0-9._/-]+$'
  [[ $1 =~ $re ]] || fail "source must be in /home/ploi or /home/forge: $1"
  SRC_OWNER=${BASH_REMATCH[1]}
  case "$1" in "/home/$CALLER/"*) fail "source cannot be in /home/$CALLER: $1" ;; esac
  [ "${1##*/}" = "$2" ] || fail "source must end in /$2: $1"
  SRC=$1
  if [ -z "$DRY" ]; then
    SRC=$(realpath -e -- "$1") || fail "source not found: $1"
    [[ $SRC =~ $re ]] || fail "source resolves outside /home/ploi and /home/forge: $1"
    [ "${BASH_REMATCH[1]}" = "$SRC_OWNER" ] || fail "source resolves into another panel's home: $1"
    case "$SRC" in "/home/$CALLER/"*) fail "source resolves into /home/$CALLER: $1" ;; esac
    [ "${SRC##*/}" = "$2" ] || fail "source resolves to a path not ending in /$2: $1"
    id -u "$SRC_OWNER" > /dev/null 2>&1 || fail "no user $SRC_OWNER on this server"
  fi
}

# version_lt <a> <b>: true when version a is lower than version b (both checked x.y.z).
version_lt() {
  local a1 a2 a3 b1 b2 b3
  IFS=. read -r a1 a2 a3 <<< "$1"
  IFS=. read -r b1 b2 b3 <<< "$2"
  (( a1 != b1 )) && { (( a1 < b1 )); return; }
  (( a2 != b2 )) && { (( a2 < b2 )); return; }
  (( a3 < b3 ))
}

# release_key <key> <what> <variable>: a minisign public key, not the placeholder.
release_key() {
  local re='^RW[A-Za-z0-9+/]{54}$'
  case "$1" in *REPLACE_WITH_*) fail "no $2 key in this build ($3 is the placeholder), $command refused" ;; esac
  [[ $1 =~ $re ]] || fail "invalid $2 key in this build, $command refused"
}

# dry_result <line>: a dry run's stand-in for recipe-run, true when EEPLOI_HELPER_RECIPES_RESULTS has
# that line.
dry_result() { [ -n "$RECIPES_RESULTS" ] && grep -qxF -- "$1" "$RECIPES_RESULTS"; }

# Every recipes release has these files: a step runs after both, a check after the values, each
# then under set -euo pipefail.
RECIPE_START=stack/start.sh
RECIPE_VALUES=stack/values.sh

# A path in a recipes release: relative, no empty part, no part that starts with . (so no . or ..) or -.
# D-21: the recipes repo checks its paths by this same rule.
RECIPE_PART='[A-Za-z0-9_][A-Za-z0-9._-]*'
RECIPE_PATH_RE="^$RECIPE_PART(/$RECIPE_PART)*\$"

# recipes_conf: the values the steps use, from $ETC/recipes.conf, in R_USER, R_PORT and R_PHP. Written
# at first boot, root's, parsed line by line, never sourced, each key once. DEPLOY_USER must be the
# helper's own.
recipes_conf() {
  local file="$ETC/recipes.conf" line key value re='^(DEPLOY_USER|SSH_PORT|PHP)=(.*)$'
  R_USER='' R_PORT='' R_PHP=''
  # D-22: a server without this file is refused.
  [ -e "$file" ] || [ -L "$file" ] || fail "no $file: this server was not built from a recipe that writes it, recipe-run refused"
  trusted "$file" || fail "untrusted values file: $file (must be a root-owned file, not writable by others)"
  # D-20: the values come from this file on the server, never from the caller. D-5: parsed, never sourced.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    [[ $line =~ $re ]] || fail "invalid line in $file: $line"
    key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    case "$key" in
      DEPLOY_USER)
        [ -z "$R_USER" ] || fail "DEPLOY_USER is set twice in $file"
        [[ $value =~ ^$DEPLOY_USER_NAME$ && $value != root ]] || fail "invalid DEPLOY_USER in $file: $value"
        R_USER=$value ;;
      SSH_PORT)
        [ -z "$R_PORT" ] || fail "SSH_PORT is set twice in $file"
        { [ "$value" = 22 ] || { [[ $value =~ ^[1-9][0-9]{4}$ ]] && [ "$value" -ge 10000 ] && [ "$value" -le 32767 ]; }; } \
          || fail "invalid SSH_PORT in $file: $value (22, or 10000 to 32767)"
        R_PORT=$value ;;
      PHP)
        [ -z "$R_PHP" ] || fail "PHP is set twice in $file"
        [[ $value =~ ^[0-9]\.[0-9]$ ]] || fail "invalid PHP in $file: $value"
        R_PHP=$value ;;
    esac
  done < "$file"
  for key in DEPLOY_USER:$R_USER SSH_PORT:$R_PORT PHP:$R_PHP; do
    [ -n "${key#*:}" ] || fail "no ${key%%:*} in $file"
  done
  [ "$R_USER" = "$DEPLOY_USER" ] || fail "DEPLOY_USER is $R_USER in $file but $DEPLOY_USER for the helper, recipe-run refused"
}

# os_target: R_OS, this server's OS as a recipes target such as ubuntu-26.04, and R_VERSION (26.04),
# from ID and VERSION_ID in os-release, parsed line by line, never sourced. On Ubuntu /etc/os-release
# links to /usr/lib/os-release.
os_target() {
  local file line id='' version='' start_re='^(ID|VERSION_ID)=' re='^(ID|VERSION_ID)=("?)([a-z0-9][a-z0-9.]{0,15})("?)$'
  if ! file=$(readlink -f -- "$OS_RELEASE") || ! trusted "$file"; then
    fail "untrusted or missing os-release: $OS_RELEASE"
  fi
  # D-5: parsed line by line, never sourced.
  while IFS= read -r line || [ -n "$line" ]; do
    [[ $line =~ $start_re ]] || continue
    [[ $line =~ $re && ${BASH_REMATCH[2]} == "${BASH_REMATCH[4]}" ]] || fail "cannot read os-release: $line"
    if [ "${BASH_REMATCH[1]}" = ID ]; then
      [ -z "$id" ] || fail "ID is set twice in $file"
      id=${BASH_REMATCH[3]}
    else
      [ -z "$version" ] || fail "VERSION_ID is set twice in $file"
      version=${BASH_REMATCH[3]}
    fi
  done < "$file"
  [ -n "$id" ] && [ -n "$version" ] || fail "no ID or VERSION_ID in $file"
  R_OS="$id-$version" R_VERSION=$version
}

# recipes_lock: one recipe-run at a time (fd 8), in the root-owned state folder. A dry run prints it,
# and finds it taken when EEPLOI_HELPER_RECIPES_RESULTS has "locked".
recipes_lock() {
  root_dir "${RECIPES_STATE%/*}"
  root_dir "$RECIPES_STATE"
  if [ -n "$DRY" ]; then
    echo "lock: $RECIPES_STATE/.lock"
    ! dry_result locked || fail "another recipe-run is running, or a server-report: try again when it is done"
    return 0
  fi
  exec 8> "$RECIPES_STATE/.lock" || fail "cannot open $RECIPES_STATE/.lock"
  # server-report holds the lock shared while it runs.
  flock -n 8 || fail "another recipe-run is running, or a server-report: try again when it is done"
}

# A time in the state: UTC, to the second.
DATE_PART='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z'
DATE_RE="^$DATE_PART\$"
DATE_FORMAT='+%Y-%m-%dT%H:%M:%SZ'

# now_utc: the time now, as the state writes it. A dry run takes EEPLOI_HELPER_NOW when set.
now_utc() { if [ -n "$NOW" ]; then echo "$NOW"; else date -u "$DATE_FORMAT"; fi; }

# recipes_state: the last good run from $RECIPES_STATE/state, root's, parsed line by line: R_LAST, its
# release (empty before the first run), R_RAN, a "<sha256> <path>" line per step it left in place,
# R_WHEN, when it ran, and R_FIRST, when the first good run here was (both empty in a state written
# before the helper wrote them).
recipes_state() {
  local file="$RECIPES_STATE/state" line release_re='^release (.*)$' step_re='^step ([0-9a-f]{64}) (.*)$'
  local date_re='^(first|ran) (.*)$'
  R_LAST='' R_RAN='' R_WHEN='' R_FIRST=''
  [ -e "$file" ] || [ -L "$file" ] || return 0
  trusted "$file" || fail "untrusted recipes state: $file (must be a root-owned file, not writable by others)"
  # D-5: parsed line by line, never sourced.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    if [[ $line =~ $release_re ]]; then
      [ -z "$R_LAST" ] || fail "release is set twice in $file"
      R_LAST=${BASH_REMATCH[1]}
      [[ $R_LAST =~ $SEMVER_RE ]] || fail "invalid line in $file: $line"
    elif [[ $line =~ $step_re && ${BASH_REMATCH[2]} =~ $RECIPE_PATH_RE ]]; then
      R_RAN="$R_RAN${line#step }"$'\n'
    elif [[ $line =~ $date_re && ${BASH_REMATCH[2]} =~ $DATE_RE ]]; then
      if [ "${line%% *}" = first ]; then
        [ -z "$R_FIRST" ] || fail "first is set twice in $file"
        R_FIRST=${line#first }
      else
        [ -z "$R_WHEN" ] || fail "ran is set twice in $file"
        R_WHEN=${line#ran }
      fi
    else
      fail "invalid line in $file: $line"
    fi
  done < "$file"
  [ -n "$R_LAST" ] || fail "no release in $file"
}

# recipes_state_write <version> <lines>: the state after a good run: when the first good run here was,
# when this one ran, the release and a step line per "<sha256> <path>" line. The first run's time is
# kept from the state before; a state from before the times has none, and gets none.
# D-29: the first good run's time is never guessed.
recipes_state_write() {
  local line now first='' text="# Written by eeploi-helper (recipe-run): the last good run here. Do not edit."$'\n'
  now=$(now_utc)
  if [ -z "$R_LAST" ]; then first=$now; else first=$R_FIRST; fi
  [ -z "$first" ] || text="${text}first $first"$'\n'
  text="${text}ran $now"$'\n'"release $1"$'\n'
  while IFS= read -r line; do
    [ -z "$line" ] || text="${text}step $line"$'\n'
  done <<< "$2"
  [ -z "$DRY" ] || printf '%s' "$text" | sed 's/^/  /'
  printf '%s' "$text" | put "$RECIPES_STATE/state" 644
}

# recipes_fetch <file> <most bytes>: one file of the release, from $R_BASE into $R_WORK. A dry run copies
# it from EEPLOI_HELPER_RECIPES_DOWNLOAD.
recipes_fetch() {
  if [ -n "$DRY" ]; then
    echo "download: $R_BASE/$1"
    if [ -z "$RECIPES_DOWNLOAD" ] || ! cp -- "$RECIPES_DOWNLOAD/$1" "$R_WORK/$1" 2> /dev/null; then
      fail "download failed: $R_BASE/$1"
    fi
  else
    "${FETCH[@]}" --max-filesize "$2" -o "$R_WORK/$1" "$R_BASE/$1" || fail "download failed: $R_BASE/$1"
  fi
  [ "$(wc -c < "$R_WORK/$1")" -le "$2" ] || fail "download too large: $R_BASE/$1"
}

# recipes_manifest <file> <version> <provider>: the signed manifest, line by line, into R_PATH, R_SHA
# and R_KIND (the step's marker, or file), R_N entries in order. The release, target and min-helper
# must fit this call, this server and this helper; each path once.
recipes_manifest() {
  local line='' n=0 release='' target='' min='' i p
  local head_re='^(release|target|min-helper) (.+)$' ver_re='[0-9]+\.[0-9]+\.[0-9]+'
  local step_re="^step ([0-9a-f]{64}) (first-boot|always|window) $ver_re $ver_re [a-z,-]+ (.+\.sh)$"
  local file_re='^file ([0-9a-f]{64}) (.+)$'
  R_PATH=() R_SHA=() R_KIND=()
  {
  IFS= read -r line || true
  [ "$line" = 'format 1' ] || fail "not a format 1 manifest: $line"
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line =~ $head_re ]]; then
      case "${BASH_REMATCH[1]}" in
        release) [ -z "$release" ] || fail "release is set twice in the manifest"; release=${BASH_REMATCH[2]} ;;
        target) [ -z "$target" ] || fail "target is set twice in the manifest"; target=${BASH_REMATCH[2]} ;;
        min-helper) [ -z "$min" ] || fail "min-helper is set twice in the manifest"; min=${BASH_REMATCH[2]} ;;
      esac
      continue
    elif [[ $line =~ $step_re ]]; then
      R_SHA[n]=${BASH_REMATCH[1]} R_KIND[n]=${BASH_REMATCH[2]} R_PATH[n]=${BASH_REMATCH[3]}
    elif [[ $line =~ $file_re ]]; then
      R_SHA[n]=${BASH_REMATCH[1]} R_KIND[n]=file R_PATH[n]=${BASH_REMATCH[2]}
    else
      fail "invalid line in the manifest: $line"
    fi
    [ $n -lt 200 ] || fail "more than 200 files in the manifest"
    p=${R_PATH[n]}
    [[ $p =~ $RECIPE_PATH_RE ]] || fail "a manifest path that is absolute, has a part that starts with . or -, or can't be read safely: $p"
    for ((i = 0; i < n; i++)); do
      [ "${R_PATH[i]}" != "$p" ] || fail "a path twice in the manifest: $p"
    done
    n=$((n + 1))
  done
  } < "$1"
  R_N=$n
  [ "$release" = "$2" ] || fail "the manifest is for release $release, not $2"
  [ "$target" = "$3 $R_OS" ] || fail "the manifest is for $target, not $3 $R_OS"
  [[ $min =~ $SEMVER_RE ]] || fail "invalid min-helper in the manifest: $min"
  ! version_lt "$VERSION" "$min" || fail "recipes $2 needs eeploi-helper $min or newer, this is $VERSION"
  for p in "$RECIPE_START" "$RECIPE_VALUES"; do
    if ! recipes_index "$p" || [ "${R_KIND[R_I]}" != file ]; then fail "no $p in the manifest"; fi
  done
}

# recipes_index <path>: R_I is that path's entry in the manifest; false when it has none.
recipes_index() {
  for ((R_I = 0; R_I < R_N; R_I++)); do
    [ "${R_PATH[R_I]}" != "$1" ] || return 0
  done
  return 1
}

# recipes_is_check <i>: entry i is a check, a file <step>.check.sh.
recipes_is_check() { [[ ${R_KIND[$1]} == file && ${R_PATH[$1]} == *.check.sh ]]; }

# recipes_runs <i>: entry i is a file a run uses: an always step, start.sh, values.sh or a check.
recipes_runs() {
  [[ ${R_KIND[$1]} == always ]] || recipes_is_check "$1" \
    || { [[ ${R_KIND[$1]} == file ]] && [[ ${R_PATH[$1]} == "$RECIPE_START" || ${R_PATH[$1]} == "$RECIPE_VALUES" ]]; }
}

# recipes_unpack <package>: the package unzipped once (8 MB at most), only plain files and folders in
# it, then every file the manifest lists read out of it one by one into $R_WORK/files, never unpacked
# as it is and cut off past 1 MB while it is read (a sparse file unpacks to more than it takes up in the
# package). Each must match its SHA-256. In the files a run uses, the only placeholders are the values
# recipes_render fills in, and never in bash's own braces (${user}, $x{user}), which it would fill in too.
# D-18: never unpacked as it is, each file capped while it is read.
recipes_unpack() {
  local i p f found unread max=1048576 tar="$R_WORK/package.tar"
  # D-20: only the values recipe-run fills in itself.
  local values_re='^\{(user|port|php|version|name)\}$'
  # shellcheck disable=SC2016 # the $ is in a regex
  local bash_re='[$A-Za-z0-9_]\{[a-z_]+\}' value_in_bash_re='[$A-Za-z0-9_]\{(user|port|php|version|name)\}'
  gzip -dc < "$1" 2> /dev/null | head -c 8388609 > "$tar" || true
  [ "$(wc -c < "$tar")" -le 8388608 ] || fail "the package is too large unpacked"
  tar -tvf "$tar" > "$R_WORK/package.list" 2> /dev/null || fail "cannot read the package"
  ! cut -c1 "$R_WORK/package.list" | grep -qv '^[-d]$' || fail "the package holds a link or another file that is not a plain file"
  R_FILES="$R_WORK/files"
  for ((i = 0; i < R_N; i++)); do
    p=${R_PATH[i]}
    f="$R_FILES/$p"
    mkdir -p -- "${f%/*}" 2> /dev/null || fail "cannot read $p from the package"
    unread=
    tar -xOf "$tar" -- "$p" 2> /dev/null | head -c $((max + 1)) > "$f" || unread=1
    [ -f "$f" ] || fail "cannot read $p from the package"
    # The size first: a head that stops early makes tar fail too.
    [ "$(wc -c < "$f")" -le "$max" ] || fail "a file too large in the package: $p"
    [ -z "$unread" ] || fail "cannot read $p from the package"
    [ "$(sha256sum < "$f" | cut -d' ' -f1)" = "${R_SHA[i]}" ] || fail "changed file: $p (its SHA-256 is not the manifest's)"
    recipes_runs "$i" || continue
    ! grep -qE "$value_in_bash_re" "$f" || fail "a value in bash's own braces, which recipe-run can't fill in safely: $p"
    while IFS= read -r found; do
      [ -z "$found" ] || [[ $found =~ $values_re ]] || fail "a placeholder recipe-run can't fill in: $found in $p"
    done <<< "$(sed -E "s/$bash_re//g" "$f" | grep -oE '\{[a-z_]+\}' || true)"
  done
}

# recipes_render <file>...: those files of the release, an empty line between each, the values filled in
# (the ones recipes_unpack allows).
recipes_render() {
  local f
  for f; do
    [ "$f" = "$1" ] || echo
    sed -e "s/{user}/$R_USER/g; s/{port}/$R_PORT/g; s/{php}/$R_PHP/g; s/{version}/$R_VERSION/g; s/{name}/recipe-run/g" "$R_FILES/$f"
  done
}

# recipes_exec <path> <script>: run the script of a step or check as root, from /, with a clean
# environment and no stdin; what it prints goes to stderr. A dry run prints it, and it fails only when
# EEPLOI_HELPER_RECIPES_RESULTS has "fail <path>".
recipes_exec() {
  if [ -n "$DRY" ]; then
    echo "run: $1" >&2
    sed 's/^/  /' "$2" >&2
    if dry_result "fail $1"; then return 1; fi
    return 0
  fi
  clean_bash "$2" >&2
}

# clean_bash <script> [<command>...]: bash runs the script as root, from /, with a clean environment
# and no stdin, behind the command when one is given (server-report's timeout). recipe-run's steps
# and checks and server-report's checks and probes all run this way.
clean_bash() {
  local script=$1
  shift
  ( cd / && exec env -i PATH="$PATH" HOME=/root LC_ALL=C TMPDIR=/tmp "$@" /bin/bash "$script" ) < /dev/null 8>&-
}

# recipes_check <check>: run one check under set -e, after the values.
recipes_check() {
  recipes_check_script "$1"
  recipes_exec "$1" "$R_WORK/check.sh"
}

# recipes_check_script <check>: the script a check runs as, in $R_WORK/check.sh: the values, then the
# check under set -e. server-report runs the kept checks from this same script.
recipes_check_script() {
  {
    echo '#!/usr/bin/env bash'
    recipes_render "$RECIPE_VALUES"
    echo
    echo 'set -euo pipefail'
    # shellcheck disable=SC2016 # for the check's shell
    echo 'trap '\''echo "  $BASH_COMMAND" >&2'\'' ERR'
    recipes_render "$1"
  } > "$R_WORK/check.sh"
}

# recipes_is_probe <i>: entry i is a probe, a file NN-name.probe.sh (eeploi/recipes PROBES.md).
recipes_is_probe() { [[ ${R_KIND[$1]} == file && ${R_PATH[$1]} == *.probe.sh ]]; }

# The checks and probes of the last good run, kept for server-report: $RECIPES_STATE/kept, with a
# list file ("release <version>", "target <provider> <os>", then "<sha256> <path>" per file in manifest
# order) and the files.
KEPT="$RECIPES_STATE/kept"

# recipes_is_kept <i>: entry i is kept for server-report: values.sh, a check or a probe.
recipes_is_kept() { [ "${R_PATH[$1]}" = "$RECIPE_VALUES" ] || recipes_is_check "$1" || recipes_is_probe "$1"; }

# recipes_keep <version> <target>: after a good run, the release's checks, probes and values.sh, as
# verified against the signed manifest, in place of the ones kept before. Built beside the old set,
# then swapped in, so a set is whole or not there; server-report waits for the lock recipe-run holds.
# Runs after the state is written. False when it can't: the set before stays, and the run goes on.
# D-27: only what a verified release holds, kept by root after a good run.
recipes_keep() {
  local i p new list="# Written by eeploi-helper (recipe-run): the checks and probes of the last good run. Do not edit."$'\n'"release $1"$'\n'"target $2"$'\n'
  if [ -n "$DRY" ]; then
    for ((i = 0; i < R_N; i++)); do
      ! recipes_is_kept "$i" || echo "keep: $KEPT/${R_PATH[i]}"
    done
    echo "write: $KEPT/list (644)"
    ! dry_result "fail keep" || return 1
    return 0
  fi
  new=$(mktemp -d "$RECIPES_STATE/kept.new.XXXXXX") || return 1
  TMP_PATHS="$TMP_PATHS $new"
  for ((i = 0; i < R_N; i++)); do
    recipes_is_kept "$i" || continue
    p=${R_PATH[i]}
    if [[ $p == */* ]]; then mkdir -p -- "$new/${p%/*}" || return 1; fi
    cp -- "$R_FILES/$p" "$new/$p" || return 1
    list="$list${R_SHA[i]} $p"$'\n'
  done
  printf '%s' "$list" > "$new/list" && chown -R root:root "$new" && chmod -R u=rwX,go=rX "$new" || return 1
  rm -rf -- "$KEPT.old" || return 1
  if [ -e "$KEPT" ] || [ -L "$KEPT" ]; then mv -f -- "$KEPT" "$KEPT.old" || return 1; fi
  if ! mv -- "$new" "$KEPT"; then
    [ ! -e "$KEPT.old" ] || mv -f -- "$KEPT.old" "$KEPT" || true
    return 1
  fi
  rm -rf -- "$KEPT.old" || true
}

# server-report: what eeploi did, whether every kept check passes, and how the server is set up now.
# It reads, never writes (but a work folder in /tmp, removed on exit), needs no network, restarts
# nothing.
# D-28: read-only, only the checks and probes recipe-run kept, each checked again before it runs.

# A probe's line: a key, a space, a printable value with no space at its end (PROBES.md).
# D-30: a probe's lines only by this pattern, never its stderr; a failed probe shows no lines.
PROBE_LINE_RE='^[a-z][a-z0-9_-]* [[:print:]]*[^[:space:]]$'
# The most a check or probe may print, and the most lines shown of each.
REPORT_BYTES=65536
REPORT_LINES=500
NOTE_LINES=20
# A check or probe that hangs is stopped: timeout is in coreutils on every Linux. A dry run on a
# system without it runs without.
TIMEOUT=(timeout -k 5 60)
[ -z "$DRY" ] || command -v timeout > /dev/null || TIMEOUT=()

# recipes_lock_there: recipe-run's .lock is there, and trusted; one it can't trust is refused. Without
# it, no recipe-run ever ran here (return 1). server-report and server-reboot wait for it.
recipes_lock_there() {
  local lock="$RECIPES_STATE/.lock"
  [ -e "$lock" ] || [ -L "$lock" ] || return 1
  trusted "$lock" || fail "untrusted recipe-run lock: $lock (must be a root-owned file, not writable by others)"
  [ -n "$DRY" ] || command -v flock > /dev/null || fail "flock not found"
}

# report_lock: wait for a recipe-run that is running here (a shared lock on its .lock), so the report
# never reads a state or kept set halfway through. Without a .lock, no recipe-run ever ran here.
report_lock() {
  local lock="$RECIPES_STATE/.lock"
  recipes_lock_there || return 0
  if [ -n "$DRY" ]; then
    echo "lock: shared $lock" >&2
    ! dry_result locked || fail "a recipe-run is running here, try again when it is done"
    return 0
  fi
  exec 8< "$lock" || fail "cannot open $lock"
  flock -s -w 120 8 || fail "a recipe-run is running here, try again when it is done"
}

# report_kept: the kept set, checked: K_RELEASE, K_TARGET ("<provider> <os>") and K_PATH, its files in
# order. Every folder and file root's and closed, every path by the manifest's rule and once, every
# file's SHA-256 the one in the list. Nothing kept: K_RELEASE is empty. A set that fails any of this is
# not used: K_ERROR says why, and K_RELEASE, K_TARGET and K_PATH are empty.
report_kept() {
  K_ERROR=''
  report_kept_read || K_RELEASE='' K_TARGET='' K_PATH=()
}

# report_kept_read: report_kept's reading; false, with K_ERROR, on a set it can't use.
report_kept_read() {
  local line n=0 i p sha sub rest list="$KEPT/list" sha_re='^([0-9a-f]{64}) (.+)$' release_re='^release (.*)$'
  local target_re='^target ([a-z0-9-]{1,32} [a-z0-9][a-z0-9.-]{0,32})$'
  K_RELEASE='' K_TARGET='' K_PATH=()
  [ -e "$KEPT" ] || [ -L "$KEPT" ] || return 0
  if ! closed -d "$RECIPES_STATE" || ! closed -d "$KEPT" || ! closed -f "$list"; then
    K_ERROR="untrusted kept set: $KEPT (must be root-owned folders and files, not writable by others)"
    return 1
  fi
  # D-5: parsed line by line, never sourced.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    if [[ $line =~ $release_re ]]; then
      [ -z "$K_RELEASE" ] || { K_ERROR="release is set twice in $list"; return 1; }
      K_RELEASE=${BASH_REMATCH[1]}
      [[ $K_RELEASE =~ $SEMVER_RE ]] || { K_ERROR="invalid release line in $list"; return 1; }
      continue
    elif [[ $line =~ $target_re ]]; then
      [ -z "$K_TARGET" ] || { K_ERROR="target is set twice in $list"; return 1; }
      K_TARGET=${BASH_REMATCH[1]}
      continue
    fi
    [[ $line =~ $sha_re ]] || { K_ERROR="invalid line in $list"; return 1; }
    sha=${BASH_REMATCH[1]} p=${BASH_REMATCH[2]}
    [[ $p =~ $RECIPE_PATH_RE ]] || { K_ERROR="invalid path in $list"; return 1; }
    [ $n -lt 200 ] || { K_ERROR="more than 200 files in $list"; return 1; }
    for ((i = 0; i < n; i++)); do
      [ "${K_PATH[i]}" != "$p" ] || { K_ERROR="a path twice in $list: $p"; return 1; }
    done
    # Every folder on the way, then the file.
    sub=$KEPT rest=$p
    while [[ $rest == */* ]]; do
      sub="$sub/${rest%%/*}" rest=${rest#*/}
      closed -d "$sub" || { K_ERROR="untrusted kept folder: $sub"; return 1; }
    done
    closed -f "$KEPT/$p" || { K_ERROR="untrusted kept file: $KEPT/$p"; return 1; }
    [ "$(sha256sum < "$KEPT/$p" | cut -d' ' -f1)" = "$sha" ] || { K_ERROR="changed kept file: $KEPT/$p (its SHA-256 is not the list's)"; return 1; }
    K_PATH[n]=$p
    n=$((n + 1))
  done < "$list"
  [ -n "$K_RELEASE" ] || { K_ERROR="no release in $list"; return 1; }
  [ -n "$K_TARGET" ] || { K_ERROR="no target in $list"; return 1; }
  # A check runs after the values.
  for ((i = 0; i < n; i++)); do
    [ "${K_PATH[i]}" != "$RECIPE_VALUES" ] || return 0
  done
  for ((i = 0; i < n; i++)); do
    [[ ${K_PATH[i]} != *.check.sh ]] || { K_ERROR="no $RECIPE_VALUES in $list"; return 1; }
  done
}

# report_exec <script> <keep|drop>: run a kept check or probe as recipe-run runs a check: as root, from /,
# with a clean environment and no stdin, stopped when it hangs. Its stdout, capped, NUL bytes made
# unprintable; its stderr too with keep (a check's notes), never with drop (a probe's).
report_exec() {
  (
    if [ "$2" = keep ]; then exec 2>&1; else exec 2> /dev/null; fi
    clean_bash "$1" ${TIMEOUT[@]+"${TIMEOUT[@]}"}
  ) | head -c $((REPORT_BYTES + 1)) | tr '\000' '\001'
}

# report_notes: what a check printed, as notes: printable lines only, tabs as spaces, trimmed, at most
# NOTE_LINES of 300 characters.
report_notes() {
  tr '\t' ' ' | tr -cd '\n\40-\176' | sed 's/^ *//; s/ *$//; /^$/d' | head -n "$NOTE_LINES" | cut -c1-300
}

# report_read <stand-in> <command...>: what a command prints, its stderr dropped. A dry run reads the
# stand-in file in EEPLOI_HELPER_REPORT, and fails without it.
report_read() {
  local file=$1
  shift
  if [ -n "$DRY" ]; then
    [ -n "$REPORT_STAND_IN" ] && [ -f "$REPORT_STAND_IN/$file" ] && cat -- "$REPORT_STAND_IN/$file"
  else
    command -v "$1" > /dev/null && "$@" 2> /dev/null < /dev/null
  fi
}

# report_base: what any Linux with systemd shows. REP_KERNEL, REP_UPTIME (seconds, or empty),
# REP_UNITS (the failed units' names, a line each; REP_UNITS_STATE ok or unknown) and REP_PORTS ("<port>
# <process>,<process>" lines, REP_PORTS_STATE ok or unknown).
# D-31: listening ports with their port and process names only; failed units by name only.
report_base() {
  local text line port users names name
  REP_KERNEL=unknown REP_UPTIME='' REP_UNITS='' REP_UNITS_STATE=unknown REP_PORTS='' REP_PORTS_STATE=unknown
  if text=$(report_read kernel uname -r) && [[ $text =~ ^[[:graph:]]{1,100}$ ]]; then REP_KERNEL=$text; fi
  if text=$(report_read uptime cat /proc/uptime); then
    text=${text%%[. ]*}
    [[ $text =~ ^[0-9]{1,12}$ ]] && REP_UPTIME=$text
  fi
  if text=$(report_read failed systemctl --failed --no-legend --plain --no-pager); then
    REP_UNITS_STATE=ok
    while read -r name _; do
      [[ $name =~ ^[A-Za-z0-9@._:\\-]{1,200}$ ]] && REP_UNITS="$REP_UNITS$name"$'\n'
    done <<< "$text"
  fi
  if text=$(report_read ss ss -tlnpH); then
    REP_PORTS_STATE=ok
    # State, Recv-Q, Send-Q, the local address, the peer's, then users:(("name",pid=…,fd=…),…).
    while read -r _ _ _ port _ users; do
      port=${port##*:}
      [[ $port =~ ^[0-9]{1,5}$ ]] || continue
      port=$((10#$port))
      names=$(grep -oE '\("[^"]*"' <<< "$users" | sed 's/^("//; s/"$//' | grep -E '^[A-Za-z0-9._:+@-]{1,64}$' | sort -u | paste -sd, - || true)
      REP_PORTS="$REP_PORTS$port ${names:-unknown}"$'\n'
    done <<< "$text"
    REP_PORTS=$(printf '%s' "$REP_PORTS" | sort -u | sort -k1,1n -k2,2)
    [ -z "$REP_PORTS" ] || REP_PORTS="$REP_PORTS"$'\n'
  fi
}

# report_uptime <seconds>: in words.
report_uptime() {
  [ -n "$1" ] || { echo unknown; return; }
  local d=$(($1 / 86400)) h=$(($1 % 86400 / 3600)) m=$(($1 % 3600 / 60)) text=''
  [ $d -eq 0 ] || text="$d day$([ $d -eq 1 ] || echo s) "
  [ $h -eq 0 ] || text="$text$h hour$([ $h -eq 1 ] || echo s) "
  text="$text$m minute$([ $m -eq 1 ] || echo s)"
  echo "$text"
}

# report_checks: every kept check, run after the values as recipe-run runs it: C_STATE (ok or failed),
# C_PATH, C_NOTES (a line each).
report_checks() {
  local i p out n=0
  C_STATE=() C_PATH=() C_NOTES=()
  for ((i = 0; i < ${#K_PATH[@]}; i++)); do
    p=${K_PATH[i]}
    [[ $p == *.check.sh ]] || continue
    C_PATH[n]=$p
    recipes_check_script "$p"
    if out=$(report_exec "$R_WORK/check.sh" keep) && [ ${#out} -le $REPORT_BYTES ]; then C_STATE[n]=ok; else C_STATE[n]=failed; fi
    C_NOTES[n]=$(report_notes <<< "$out")
    n=$((n + 1))
  done
}

# report_probes: every kept probe, in order: P_NAME (NN-name.probe.sh without NN- and .probe.sh), P_STATE
# (ok, failed or not-installed), P_LINES (its lines that match PROBE_LINE_RE) and P_REJECTED (how many
# didn't).
report_probes() {
  local i p name out line lines shown rejected n=0
  P_NAME=() P_STATE=() P_LINES=() P_REJECTED=()
  for ((i = 0; i < ${#K_PATH[@]}; i++)); do
    p=${K_PATH[i]}
    [[ $p == *.probe.sh ]] || continue
    name=${p##*/}
    name=${name%.probe.sh}
    [[ ! $name =~ ^[0-9][0-9]-(.+)$ ]] || name=${BASH_REMATCH[1]}
    P_NAME[n]=$name lines='' shown=0 rejected=0
    if ! out=$(report_exec "$KEPT/$p" drop) || [ ${#out} -gt $REPORT_BYTES ]; then
      P_STATE[n]=failed
    elif [ -z "$out" ]; then
      # PROBES.md: no lines, its software isn't there.
      P_STATE[n]=not-installed
    else
      P_STATE[n]=ok
      while IFS= read -r line; do
        if [[ $line =~ $PROBE_LINE_RE ]] && [ $shown -lt $REPORT_LINES ]; then
          lines="$lines$line"$'\n' shown=$((shown + 1))
        else
          rejected=$((rejected + 1))
        fi
      done <<< "$out"
    fi
    P_LINES[n]=$lines P_REJECTED[n]=$rejected
    n=$((n + 1))
  done
}

# json <text>: a JSON string. Every text in the report is printable ASCII, so only \ and " need escaping.
json() {
  case "$1" in
    *[\\\"]*) printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\"]/\\&/g')" ;;
    *) printf '"%s"' "$1" ;;
  esac
}

# json_lines <lines>: a JSON array of strings, one per line.
json_lines() {
  local line sep=''
  printf '['
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    printf '%s' "$sep"
    json "$line"
    sep=','
  done <<< "$1"
  printf ']'
}

# row <first column> <rest>: a line of the text report, the first column padded.
row() { printf '%-14s %s\n' "$1" "$2"; }

# report_when <time>: a time from the state, none without a state, not-recorded in a state from
# before the helper wrote times.
report_when() {
  if [ -z "$R_LAST" ]; then echo none; elif [ -z "$1" ]; then echo not-recorded; else echo "$1"; fi
}

# report_fits: the kept set fits this server: it was kept for this server's OS (from os-release).
# False with REP_FIT_WHY when it doesn't, or when os-release can't be read.
# D-27: the OS only; the provider isn't checked on the server, until recipes.conf names it.
report_fits() {
  REP_FIT_WHY=''
  if [ "$REP_OS" = unknown ]; then REP_FIT_WHY="os-release can't be read"
  elif [ "${K_TARGET#* }" != "$R_OS" ]; then REP_FIT_WHY="the kept set is for ${K_TARGET#* }, this server is $R_OS"
  fi
  [ -z "$REP_FIT_WHY" ]
}

# report_setup: one eeploi set up, or not.
report_setup() {
  if [ "$REP_SETUP" = eeploi ]; then echo eeploi; else echo "not set up by eeploi"; fi
}

# report_text: the report for people, in plain words, the first column padded.
report_text() {
  local i line
  echo "Part 1: what eeploi did"
  row helper "$VERSION"
  row setup "$(report_setup)"
  row recipes "${R_LAST:-none}"
  row last-run "$(report_when "$R_WHEN")"
  row first-run "$(report_when "$R_FIRST")"
  # The state holds the always steps only: recipe-run runs no other.
  while read -r _ line; do
    [ -z "$line" ] || row step "always $line"
  done <<< "$R_RAN"
  row os "$REP_OS"
  row kernel "$REP_KERNEL"
  row uptime "$(report_uptime "$REP_UPTIME")"
  row values "$REP_VALUES"
  if [ "$REP_VALUES" = ok ]; then
    row value "DEPLOY_USER $R_USER"
    row value "SSH_PORT $R_PORT"
    row value "PHP $R_PHP"
  fi
  echo
  if [ "$REP_CHECKS" != ran ]; then
    echo "Part 2: is it right?"
    row "$REP_CHECKS" "checks: $REP_CHECKS_WHY"
  else
    echo "Part 2: is it right? (the checks of recipes $K_RELEASE for $K_TARGET)"
    [ ${#C_PATH[@]} -gt 0 ] || row none "no checks in the kept set"
    for ((i = 0; i < ${#C_PATH[@]}; i++)); do
      row "${C_STATE[i]}" "${C_PATH[i]}"
      while IFS= read -r line; do
        [ -z "$line" ] || row '' "  $line"
      done <<< "${C_NOTES[i]}"
    done
  fi
  echo
  echo "Part 3: how it is set up now"
  if [ "$REP_UNITS_STATE" = unknown ]; then row failed-units unknown
  elif [ -z "$REP_UNITS" ]; then row failed-units none
  else
    while IFS= read -r line; do [ -z "$line" ] || row failed-unit "$line"; done <<< "$REP_UNITS"
  fi
  if [ "$REP_PORTS_STATE" = unknown ]; then row ports unknown
  elif [ -z "$REP_PORTS" ]; then row ports none
  else
    while IFS= read -r line; do [ -z "$line" ] || row port "$line"; done <<< "$REP_PORTS"
  fi
  [ "$REP_PROBES" = ran ] || row "$REP_PROBES" "probes: $REP_PROBES_WHY"
  for ((i = 0; i < ${#P_NAME[@]}; i++)); do
    case "${P_STATE[i]}" in
      failed) row failed "${P_NAME[i]}: probe failed" ;;
      *) row "${P_STATE[i]}" "${P_NAME[i]}" ;;
    esac
    while IFS= read -r line; do
      [ -z "$line" ] || row '' "  $line"
    done <<< "${P_LINES[i]}"
    [ "${P_REJECTED[i]}" -eq 0 ] || row '' "  (not shown: ${P_REJECTED[i]}, not a <key> <value> line or past line $REPORT_LINES)"
  done
}

# report_json: the same report, the same words, for eeploi.
report_json() {
  local i sep line port names
  printf '{"helper":%s,"setup":%s' "$(json "$VERSION")" "$(json "$REP_SETUP")"
  printf ',"recipes":{"release":%s,"last_run":%s,"first_run":%s,"steps":[' \
    "$(json "${R_LAST:-none}")" "$(json "$(report_when "$R_WHEN")")" "$(json "$(report_when "$R_FIRST")")"
  sep=''
  while read -r _ line; do
    [ -n "$line" ] || continue
    printf '%s{"marker":"always","path":%s}' "$sep" "$(json "$line")"
    sep=','
  done <<< "$R_RAN"
  printf ']},"os":%s,"kernel":%s,"uptime":%s,"uptime_seconds":%s' "$(json "$REP_OS")" "$(json "$REP_KERNEL")" \
    "$(json "$(report_uptime "$REP_UPTIME")")" "${REP_UPTIME:-null}"
  printf ',"values":{"state":%s' "$(json "$REP_VALUES")"
  [ "$REP_VALUES" != ok ] || printf ',"DEPLOY_USER":%s,"SSH_PORT":%s,"PHP":%s' "$(json "$R_USER")" "$(json "$R_PORT")" "$(json "$R_PHP")"
  printf '},"checks":{"state":%s,"reason":%s,"release":%s,"target":%s,"results":[' \
    "$(json "$REP_CHECKS")" "$(json "$REP_CHECKS_WHY")" "$(json "${K_RELEASE:-none}")" "$(json "${K_TARGET:-none}")"
  for ((i = 0; i < ${#C_PATH[@]}; i++)); do
    [ "$i" -eq 0 ] || printf ','
    printf '{"state":%s,"path":%s,"notes":%s}' "$(json "${C_STATE[i]}")" "$(json "${C_PATH[i]}")" "$(json_lines "${C_NOTES[i]}")"
  done
  printf ']},"failed_units":{"state":%s,"units":%s}' "$(json "$REP_UNITS_STATE")" "$(json_lines "$REP_UNITS")"
  printf ',"ports":{"state":%s,"ports":[' "$(json "$REP_PORTS_STATE")"
  sep=''
  while read -r port names; do
    [ -n "$port" ] || continue
    printf '%s{"port":%s,"processes":%s}' "$sep" "$port" "$(json_lines "$(tr , '\n' <<< "$names")")"
    sep=','
  done <<< "$REP_PORTS"
  printf ']},"probes":{"state":%s,"reason":%s,"results":[' "$(json "$REP_PROBES")" "$(json "$REP_PROBES_WHY")"
  for ((i = 0; i < ${#P_NAME[@]}; i++)); do
    [ "$i" -eq 0 ] || printf ','
    printf '{"name":%s,"state":%s,"lines":%s,"rejected":%s}' "$(json "${P_NAME[i]}")" "$(json "${P_STATE[i]}")" \
      "$(json_lines "${P_LINES[i]}")" "${P_REJECTED[i]}"
  done
  printf ']}}\n'
}

# server-reboot: a clean reboot a few seconds after the call answers, never in the middle of a
# recipe-run.
# D-37: a transient timer and service, so the answer reaches the caller before the connection drops.
REBOOT_UNIT=eeploi-reboot
REBOOT_DELAY=5
# D-41: the reboot waits at most 30 minutes for recipe-run's lock.
REBOOT_WAIT=1800
REBOOT_REQUIRED=/var/run/reboot-required
REBOOT_DUE_RE="^eeploi-helper: reboot due ($DATE_PART)\$"

# unit_description <unit>: the description systemd has for the unit. A dry run reads the line
# "description <unit> <text>" of EEPLOI_HELPER_SYSTEM.
unit_description() {
  if [ -z "$DRY" ]; then systemctl show -p Description --value "$1" 2> /dev/null; else stand_in "description $1 "; fi
}

# utc_at <seconds since 1970>: that time, UTC, as the state writes it. utc_in <seconds>: the time that
# many seconds from now. epoch_of <time as the state writes it>: its seconds since 1970. GNU date on a
# server, BSD date in a dry run on macOS.
utc_at() { date -u -d "@$1" "$DATE_FORMAT" 2> /dev/null || date -u -r "$1" "$DATE_FORMAT"; }
utc_in() { utc_at $(($(date +%s) + $1)); }
epoch_of() { date -u -d "$1" +%s 2> /dev/null || date -u -j -f "${DATE_FORMAT#+}" "$1" +%s 2> /dev/null; }

# D-42: at most one reboot per 15 minutes, from the time the unit writes right before systemctl reboot.
REBOOT_GAP=900
REBOOT_LINE_RE="^rebooted ($DATE_PART)\$"

# reboot_last: B_LAST, when the last reboot server-reboot started was, from $REBOOT_STATE, root's,
# parsed line by line, and B_AT, its seconds since 1970; both empty when there is no file (no reboot
# started here yet). A file it can't trust is refused. A trusted file it can't read (empty, a line it
# doesn't know, the time twice, a time date can't read) is ignored and logged: both are empty then too.
reboot_last() {
  local file=$REBOOT_STATE line
  B_LAST='' B_AT=''
  [ -e "$file" ] || [ -L "$file" ] || return 0
  trusted "$file" || fail "untrusted reboot state: $file (must be a root-owned file, not writable by others)"
  # D-5: parsed line by line, never sourced.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    if [[ $line =~ $REBOOT_LINE_RE ]] && [ -z "$B_LAST" ]; then
      B_LAST=${BASH_REMATCH[1]}
    else
      B_LAST=''
      break
    fi
  done < "$file"
  [ -z "$B_LAST" ] || B_AT=$(epoch_of "$B_LAST") || B_LAST=''
  [ -n "$B_LAST" ] || audit "server-reboot: the last reboot time in $file can't be read, ignored"
}

# reboot_allowed: refuses a call within 15 minutes of the last reboot. A time more than 15 minutes
# ahead of now is ignored and logged. A dry run takes now from EEPLOI_HELPER_NOW when set.
reboot_allowed() {
  local now
  reboot_last
  [ -n "$B_LAST" ] || return 0
  if [ -n "$NOW" ]; then now=$(epoch_of "$NOW") || fail "cannot read the time now"; else now=$(date +%s); fi
  if [ "$B_AT" -gt $((now + REBOOT_GAP)) ]; then
    audit "server-reboot: the last reboot time is in the future, ignored"
  elif [ "$now" -lt $((B_AT + REBOOT_GAP)) ]; then
    fail "the last reboot was at $B_LAST: the next is allowed from $(utc_at $((B_AT + REBOOT_GAP)))"
  fi
}

# reboot_pending: a reboot server-reboot started is pending: its timer waits, or its service waits
# for the lock or reboots.
reboot_pending() { running "$REBOOT_UNIT.timer" || running "$REBOOT_UNIT.service"; }

# pending_due: when the pending reboot is due, from its unit's description, or unknown.
pending_due() {
  local desc
  desc=$(unit_description "$REBOOT_UNIT.service") || desc=''
  if [[ $desc =~ $REBOOT_DUE_RE ]]; then echo "${BASH_REMATCH[1]}"; else echo unknown; fi
}

# reboot_required: yes when the system says a reboot is needed (an update wrote the file), else no.
reboot_required() { if present "$REBOOT_REQUIRED"; then echo yes; else echo no; fi; }

# boot_id: the kernel's id of this boot, which a reboot changes, or unknown. A dry run reads the line
# "boot-id <id>" of EEPLOI_HELPER_SYSTEM.
BOOT_ID=/proc/sys/kernel/random/boot_id
BOOT_ID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
boot_id() {
  local id
  if [ -z "$DRY" ]; then id=$(cat "$BOOT_ID" 2> /dev/null) || id=''; else id=$(stand_in "boot-id ") || id=''; fi
  if [[ $id =~ $BOOT_ID_RE ]]; then echo "$id"; else echo unknown; fi
}

# audit <text>: one line in the system log (a dry run prints it on stderr).
# D-11: every call is logged, never what comes on stdin.
audit() {
  if [ -n "$DRY" ]; then echo "log: eeploi-helper: $*" >&2; else logger -t eeploi-helper -- "$*" 2> /dev/null || true; fi
}

# vhost_conf <domain> <user> <socket>: eeploi's one vhost, HTTPS only behind Cloudflare, built here from
# checked arguments. Root, certificate and log paths are fixed: logs go to /var/log/nginx, never into a
# folder the caller can write (nginx opens log files as root).
vhost_conf() {
  cat <<VHOST
# Written by eeploi-helper (vhost-write). eeploi rewrites this file, do not edit.
server {
    listen 80;
    listen [::]:80;
    server_name $1;
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name $1;
    root /srv/eeploi/$2/$1/current/public;
    # nginx follows a link in the site only when the link and its target have the same owner.
    disable_symlinks if_not_owner from=/srv/eeploi/$2;

    ssl_certificate /etc/nginx/ssl/$1.crt;
    ssl_certificate_key /etc/nginx/ssl/$1.key;

    index index.php;
    charset utf-8;

    access_log /var/log/nginx/eeploi-$1-access.log;
    error_log /var/log/nginx/eeploi-$1-error.log;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \\.php\$ {
        fastcgi_pass unix:$3;
        fastcgi_param SCRIPT_FILENAME \$realpath_root\$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\\.(?!well-known).* {
        deny all;
    }
}
VHOST
}

# supervisor_conf <program> <user> <directory> <processes> <command>: a worker config built here. Only
# these keys; the log goes to the site's folder in /var/log/supervisor/eeploi (supervisord opens it as root).
supervisor_conf() {
  cat <<CONF
[program:$1]
process_name=%(program_name)s_%(process_num)02d
command=$5
directory=$3
user=$2
numprocs=$4
autostart=true
autorestart=true
stopwaitsecs=3600
redirect_stderr=true
stdout_logfile=/var/log/supervisor/eeploi/$2/$1.log
CONF
}

# Where root keeps take-over backups: root-owned, never in a folder the caller can write.
STATE=/var/lib/eeploi

# escape_dots <text>: dots escaped for a sed pattern (the input is already checked: no other special characters).
escape_dots() { printf '%s' "$1" | sed 's/[.]/\\./g'; }

# vhost_root_conf <old> <new> <site user or empty>: the vhost on stdin with its one root line (root <old>;
# or, run again, root <new>;) set to root <new>;. For a site user, eeploi's disable_symlinks line goes
# right after it, once; that root must sit at the top level of a server block that listens on port 443,
# and the vhost may have no disable_symlinks line of its own. eeploi's earlier disable_symlinks lines are
# taken out. Quotes aren't parsed, so for a site user a line with a quote and a {, } or # is refused.
vhost_root_conf() {
  local line t n=0 i depth=0 block=0 roots=0 root_i=-1 root_block=0 root_depth=0 ob='{' cb='}' opens closes
  local -a lines ssl
  local ours='^[[:space:]]*disable_symlinks[[:space:]]+if_not_owner[[:space:]]+from=/srv/eeploi/[a-z0-9_]+;[[:space:]]*$'
  local root_re listen_re='^[[:space:]]*listen[[:space:]]+([^;]*[[:space:]:])?443([[:space:];]|$)'
  root_re="^([[:space:]]*)root[[:space:]]+($(escape_dots "$1")|$(escape_dots "$2"));[[:space:]]*$"
  while IFS= read -r line || [ -n "$line" ]; do
    [[ ! $line =~ $ours ]] || continue
    lines[n]=$line
    t=${line%%#*}
    # D-9: quotes aren't parsed, so a line they could change is refused.
    if [ -n "$3" ] && [[ $t == *[\"\']* && $line == *[{}#]* ]]; then
      fail "a vhost line with a quote and a {, } or # can't be read safely, disable_symlinks can't be placed: $line"
    fi
    # Every block that opens at the top level is a new one, also when its { is on a line of its own.
    if [ $depth -eq 0 ] && [[ $t == *$ob* ]]; then block=$((block + 1)); fi
    if [[ $t =~ $listen_re ]]; then ssl[block]=1; fi
    if [[ $line =~ $root_re ]]; then roots=$((roots + 1)); root_i=$n; root_block=$block; root_depth=$depth; fi
    if [ -n "$3" ] && [[ $t == *disable_symlinks* ]]; then
      fail "the vhost has a disable_symlinks line of its own, eeploi's can't be placed: $line"
    fi
    opens=${t//[!$ob]/}
    closes=${t//[!$cb]/}
    depth=$((depth + ${#opens} - ${#closes}))
    n=$((n + 1))
  done
  [ $roots -eq 1 ] || fail "expected one 'root $1;' line in the vhost, found $roots"
  if [ -n "$3" ] && [ "${ssl[root_block]:-}" != 1 ]; then
    fail "the root line is not in a server block on port 443, disable_symlinks can't be placed"
  fi
  if [ -n "$3" ] && [ $root_depth -ne 1 ]; then
    fail "the root line is not at the top level of its server block, disable_symlinks can't be placed"
  fi
  for ((i = 0; i < n; i++)); do
    if [ $i -ne $root_i ]; then printf '%s\n' "${lines[i]}"; continue; fi
    [[ ${lines[i]} =~ $root_re ]]
    printf '%sroot %s;\n' "${BASH_REMATCH[1]}" "$2"
    [ -z "$3" ] || printf '%sdisable_symlinks if_not_owner from=/srv/eeploi/%s;\n' "${BASH_REMATCH[1]}" "$3"
  done
}

# inside <path> <base> <what>: the path is in <base>, without . or .. parts, and every folder from its
# own up to <base> is closed.
inside() {
  local dir=${1%/*} re='^/[A-Za-z0-9._/*?-]+$'
  [[ $1 =~ $re ]] || fail "a $3 that can't be read safely: $1"
  case "$1/" in */../*|*/./*|*//*) fail "a $3 with . or ..: $1" ;; esac
  case "$1" in "$2/"?*) ;; *) fail "a $3 outside $2: $1" ;; esac
  while :; do
    closed -d "$dir" || fail "a $3 in a folder that is not root-owned, or open to group or others: $1 ($dir)"
    [ "$dir" != "$2" ] || return 0
    dir=${dir%/*}
  done
}

# vhost_paths <file> [<depth>]: every include, access_log and error_log in the file, and in what it
# includes, stays root's alone: nginx reads and opens them as root. An include is in the nginx folder
# (a relative one counts from there), and each file it matches is closed. So is every file an ssl_ or
# auth_ directive names (certificate, key, CRL, dhparam, ticket key, key log, password or auth file),
# in the nginx folder too: a bad one fails nginx -t, and with it
# every site's reload. eeploi's certificates are in /etc/nginx/ssl; certbot's are refused. A log is in
# nginx's log folder, root's alone, and no link; the log file itself belongs to nginx's user. Temp and
# cache paths, njs, Perl, XSLT, GeoIP and Lua are refused: eeploi needs none of them.
# Statements may span lines; quotes aren't parsed, so a line with a quote and a #, an open quote, or a
# # inside a word is refused. A path in one pair of quotes, with no other quote, is read without them;
# inside refuses any other quote. Words split on a carriage return too, as nginx splits them.
vhost_paths() {
  local file=$1 depth=${2:-0} line t dq sq text='' stmt name arg match nginx_dir=${NGINX_CONF%/*} ob='{' cb='}'
  local word_end='(^|[[:space:];{}])$' quoted='^"([^"'\'']*)"$|^'\''([^"'\'']*)'\''$'
  local -a words
  [ "$depth" -le 8 ] || fail "vhost includes nested deeper than 8: $file"
  while IFS= read -r line || [ -n "$line" ]; do
    t=${line%%#*}
    dq=${t//[!\"]/} sq=${t//[!\']/}
    # D-9: a line the check could read otherwise than nginx is refused.
    if [[ $t == *[\"\']* && $line == *#* ]]; then fail "a vhost line with a quote and a # can't be read safely: $line"; fi
    if [ $((${#dq} % 2 + ${#sq} % 2)) -ne 0 ]; then fail "a vhost line with an open quote can't be read safely: $line"; fi
    if [[ $line == *#* && ! $t =~ $word_end ]]; then fail "a vhost line with a # inside a word can't be read safely: $line"; fi
    text="$text ${t//$'\r'/ }"
  done < "$file"
  while IFS= read -r -d ';' stmt; do
    read -r -a words <<< "$stmt"
    # nginx takes a quoted name too: "include" is include.
    name=${words[0]:-} arg=${words[1]:-}
    name=${name//[\"\'\\]/}
    if [[ $arg =~ $quoted ]]; then arg=${BASH_REMATCH[1]}${BASH_REMATCH[2]}; fi
    case "$name" in
      # D-6: what nginx reads as root is in /etc/nginx and root's alone.
      include)
        [[ $arg == /* ]] || arg="$nginx_dir/$arg"
        [[ ${arg%/*} != *[*?]* ]] || fail "a vhost include with a wildcard in its folder: $arg"
        inside "$arg" "$nginx_dir" "vhost include"
        while IFS= read -r match; do
          [ -n "$match" ] || continue
          closed -f "$match" || fail "a vhost include that is not root-owned, or open to group or others: $match"
          vhost_paths "$match" $((depth + 1))
        done <<< "$(compgen -G "$arg" || true)" ;;
      # By pattern, so a file directive nginx adds later is checked too: proxy_, grpc_ and uwsgi_ as well.
      *ssl_*certificate|*ssl_*key|*ssl_crl|*ssl_dhparam|*ssl_*file|*ssl_key_log|auth_*_file)
        [[ $arg == /* ]] || arg="$nginx_dir/$arg"
        [[ $arg != *[*?]* ]] || fail "a vhost $name with a wildcard: $arg"
        inside "$arg" "$nginx_dir" "vhost $name"
        closed -f "$arg" || fail "a vhost $name that is not root-owned, or open to group or others: $arg" ;;
      # D-7: nginx's log folder is root's alone.
      access_log|error_log)
        case "$arg" in off|stderr|syslog:*|memory:*) continue ;; esac
        [[ $arg != *[*?]* ]] || fail "a vhost log with a wildcard: $arg"
        inside "$arg" "$NGINX_LOGS" "vhost log"
        [[ ! -L $arg && ( -f $arg || ! -e $arg ) ]] || fail "a vhost log that is a link or not a file: $arg" ;;
      # nginx's root process makes these folders and gives them to nginx's user, or loads code or data.
      # D-8: refused in every vhost.
      *_temp_path|*_cache_path|js_*|perl*|xslt_*|geoip*|*lua*)
        fail "a vhost with $name, which eeploi doesn't allow: nginx's root process makes its folder or reads its code" ;;
    esac
  done <<< "${text//[$ob$cb]/;};"
}

# pool_conf <version> <user>: the site's own PHP-FPM pool, running as the site user. Only the nginx user
# may use its socket (0600, no group access).
# D-43: session upload progress is locked off; a site's .user.ini or ini_set() can't change a php_admin_flag.
pool_conf() {
  cat <<POOL
; Written by eeploi-helper (php-pool-write). eeploi rewrites this file, do not edit.
[$2]
user = $2
group = $2
listen = /run/php/php$1-fpm-$2.sock
listen.owner = $NGINX_USER
listen.mode = 0600
pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 10s
pm.max_requests = 500
request_terminate_timeout = 60
php_admin_flag[session.upload_progress.enabled] = off
POOL
}

# opcache_ini: the pools share one OPcache, so a cached script is only served to a pool whose user may
# read the file.
opcache_ini() {
  cat <<INI
; Written by eeploi-helper (php-pool-write). eeploi rewrites this file, do not edit.
opcache.validate_permission = 1
INI
}

# The Redis of a site: a template unit for all sites, a memory drop-in and a config per site, all
# root-owned. The socket and data live in the site's home.
REDIS_TEMPLATE=/etc/systemd/system/eeploi-redis@.service

redis_unit() {
  cat <<'UNIT'
# Written by eeploi-helper (redis-create). eeploi rewrites this file, do not edit.
[Unit]
Description=Redis of eeploi site user %i
After=network.target

[Service]
Type=notify
User=%i
Group=%i
ExecStart=/usr/bin/redis-server /etc/eeploi/redis/%i.conf --supervised systemd --daemonize no
Restart=on-failure
UMask=0077
MemorySwapMax=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# Only Unix sockets: its own, and systemd's notify socket. No TCP or UDP.
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/srv/eeploi/%i/.redis

[Install]
WantedBy=multi-user.target
UNIT
}

# redis_dropin <mb>: the memory cap, <mb> plus 36 MB for Redis itself and the child its rewrite forks.
redis_dropin() {
  cat <<DROPIN
# Written by eeploi-helper (redis-create). eeploi rewrites this file, do not edit.
[Service]
MemoryMax=$(($1 + 36))M
DROPIN
}

# redis_conf <user> <mb>: no TCP, a socket only the site user can open, append-only, and writes that fail
# when full instead of keys that vanish.
redis_conf() {
  cat <<CONF
# Written by eeploi-helper (redis-create). eeploi rewrites this file, do not edit.
port 0
unixsocket /srv/eeploi/$1/.redis/redis.sock
unixsocketperm 600
dir /srv/eeploi/$1/.redis
appendonly yes
maxmemory $2mb
maxmemory-policy noeviction
enable-module-command no
enable-debug-command no
CONF
}

# db_engine <engine>: mysql, mariadb or pgsql.
db_engine() {
  case "$1" in mysql|mariadb|pgsql) ;; *) fail "invalid database engine: $1 (mysql, mariadb or pgsql)" ;; esac
}

# db_name <database|user> <name>: a lowercase letter, then a-z, 0-9 or _, at most 32 in all. Names the
# engines keep for themselves are refused, and so is Postgres' pg_ prefix.
DB_RESERVED='mysql|information_schema|performance_schema|sys|postgres|template0|template1|root'
db_name() {
  local re='^[a-z][a-z0-9_]{0,31}$'
  [[ $2 =~ $re ]] || fail "invalid $1 name: $2 (a-z, 0-9 and _, starting with a letter, at most 32)"
  case "|$DB_RESERVED|" in *"|$2|"*) fail "reserved $1 name: $2" ;; esac
  case "$2" in pg_*) fail "reserved $1 name: $2" ;; esac
}

# db_login <socket|password>: how the user logs in, in DB_LOGIN. socket: as the Unix user of the same
# name, with no password; stdin is never read. password: the password from stdin in DB_PASSWORD, only
# characters that are safe inside an SQL string, never printed, logged, written to a file or put on a
# command line. A missing password fails; it never falls back to socket login.
db_login() {
  local re='^[A-Za-z0-9._~+/=-]{16,128}$'
  DB_PASSWORD=
  DB_LOGIN=$1
  case "$1" in
    socket) return ;;
    password) ;;
    *) fail "invalid login: $1 (socket or password)" ;;
  esac
  [ ! -t 0 ] || fail "password login needs the password on stdin, not a terminal"
  DB_PASSWORD=$(head -c 256)
  [[ $DB_PASSWORD =~ $re ]] || fail "the password on stdin must be 16 to 128 characters: A-Z a-z 0-9 . _ ~ + / = -"
}

# db_client <engine>: the client command in DB_CLIENT. Through the local socket only, with a clean
# environment: no option file, history or plugin from the caller's home, no PG* or MYSQL_* variables.
# MySQL and MariaDB log in as root (socket auth), Postgres as the postgres user (peer auth).
db_client() {
  case "$1" in
    mysql|mariadb)
      DB_BIN=mysql
      if [ "$1" = mariadb ] && { [ -n "$DRY" ] || command -v mariadb > /dev/null; }; then DB_BIN=mariadb; fi
      DB_CLIENT=(env -i PATH="$PATH" HOME=/root LC_ALL=C "$DB_BIN" --protocol=socket --user=root --batch --skip-column-names) ;;
    pgsql)
      DB_BIN=psql
      DB_CLIENT=(env -i PATH="$PATH" LC_ALL=C runuser -u postgres -- psql -X -q -A -t --no-password -v ON_ERROR_STOP=1 -d postgres) ;;
  esac
  [ -z "$DRY" ] || return 0
  command -v "$DB_BIN" > /dev/null || fail "$DB_BIN not found: is $1 installed?"
  [ "$1" != pgsql ] || id -u postgres > /dev/null 2>&1 || fail "no postgres user: is Postgres installed?"
}

# db_check_sql <engine> <name> <user>: what the server has, as key=count lines (see db_state).
# MySQL keeps a grant on `a\_b` for the database a_b, so both spellings are looked up.
db_check_sql() {
  local esc
  if [ "$1" = pgsql ]; then
    cat <<SQL
SELECT 'db_exists=' || count(*) FROM pg_database WHERE datname = '$2';
SELECT 'user_exists=' || count(*) FROM pg_roles WHERE rolname = '$3';
SELECT 'user_global=' || count(*) FROM pg_roles r WHERE r.rolname = '$3' AND (r.rolsuper OR r.rolcreatedb OR r.rolcreaterole OR r.rolreplication OR r.rolbypassrls OR EXISTS (SELECT 1 FROM pg_auth_members m WHERE m.member = r.oid));
SELECT 'user_elsewhere=' || count(*) FROM pg_database d, pg_roles r WHERE r.rolname = '$3' AND d.datname <> '$2' AND (d.datdba = r.oid OR EXISTS (SELECT 1 FROM aclexplode(d.datacl) a WHERE a.grantee = r.oid));
SELECT 'db_others=' || count(*) FROM pg_database d WHERE d.datname = '$2' AND (d.datdba IS DISTINCT FROM (SELECT oid FROM pg_roles WHERE rolname = '$3') OR EXISTS (SELECT 1 FROM aclexplode(d.datacl) a WHERE a.grantee NOT IN (0, d.datdba)));
SELECT 'granted=' || count(*) FROM pg_database d, pg_roles r WHERE d.datname = '$2' AND r.rolname = '$3' AND d.datdba = r.oid;
SELECT 'user_socket=' || count(*) FROM pg_authid WHERE rolname = '$3' AND rolpassword IS NULL;
SQL
    return
  fi
  esc=$(printf '%s' "$2" | sed 's/_/\\\\_/g')
  cat <<SQL
SET SESSION sql_mode = '';
SELECT CONCAT('mariadb=', IF(VERSION() LIKE '%MariaDB%', 1, 0));
SELECT CONCAT('db_exists=', COUNT(*)) FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = '$2';
SELECT CONCAT('user_exists=', COUNT(*)) FROM mysql.user WHERE User = '$3' AND Host = 'localhost';
SELECT CONCAT('user_global=', COUNT(*)) FROM information_schema.USER_PRIVILEGES WHERE SUBSTRING_INDEX(GRANTEE, '@', 1) = '''$3''' AND PRIVILEGE_TYPE <> 'USAGE';
SELECT CONCAT('user_elsewhere=', (SELECT COUNT(*) FROM mysql.db WHERE User = '$3' AND Db NOT IN ('$2', '$esc')) + (SELECT COUNT(*) FROM mysql.tables_priv WHERE User = '$3' AND Db <> '$2'));
SELECT CONCAT('db_others=', (SELECT COUNT(*) FROM mysql.db WHERE Db IN ('$2', '$esc') AND NOT (User = '$3' AND Host IN ('localhost', '127.0.0.1'))) + (SELECT COUNT(*) FROM mysql.tables_priv WHERE Db = '$2' AND NOT (User = '$3' AND Host IN ('localhost', '127.0.0.1'))));
SELECT CONCAT('granted=', COUNT(*)) FROM mysql.db WHERE Db IN ('$2', '$esc') AND User = '$3' AND Host = 'localhost';
SELECT CONCAT('tcp_user_exists=', COUNT(*)) FROM mysql.user WHERE User = '$3' AND Host = '127.0.0.1';
SELECT CONCAT('tcp_granted=', COUNT(*)) FROM mysql.db WHERE Db IN ('$2', '$esc') AND User = '$3' AND Host = '127.0.0.1';
SELECT CONCAT('user_socket=', COUNT(*)) FROM mysql.user WHERE User = '$3' AND Host = 'localhost' AND plugin IN ('auth_socket', 'unix_socket');
SELECT CONCAT('socket_plugin=', COUNT(*)) FROM information_schema.PLUGINS WHERE PLUGIN_NAME = IF(VERSION() LIKE '%MariaDB%', 'unix_socket', 'auth_socket') AND PLUGIN_STATUS = 'ACTIVE';
SQL
}

# db_state <engine> <name> <user>: run the checks and set S_<key>. Only known key=count lines are read.
# user_socket: the user logs in over the socket (no password); socket_plugin: MySQL's auth_socket or
# MariaDB's unix_socket is active; tcp_user_exists, tcp_granted: the user and its grant on 127.0.0.1.
# In a dry run the state comes from EEPLOI_HELPER_DB_STATE, or is a server with neither and the socket
# plugin active.
db_state() {
  local out line key var keys='db_exists user_exists user_global user_elsewhere db_others granted user_socket'
  local re='^(mariadb|db_exists|user_exists|user_global|user_elsewhere|db_others|granted|user_socket|socket_plugin|tcp_user_exists|tcp_granted)=([0-9]+)$'
  [ "$1" = pgsql ] || keys="mariadb $keys socket_plugin tcp_user_exists tcp_granted"
  S_mariadb='' S_db_exists='' S_user_exists='' S_user_global='' S_user_elsewhere='' S_db_others='' S_granted=''
  S_user_socket='' S_socket_plugin='' S_tcp_user_exists='' S_tcp_granted=''
  if [ -n "$DRY" ]; then
    echo "check: what the $1 server has (on stdin of: ${DB_CLIENT[*]})"
    db_check_sql "$@" | sed 's/^/  /'
    if [ -n "$DB_STATE" ]; then
      out=$(cat "$DB_STATE")
    else
      out=$(for key in $keys; do echo "$key=0"; done)
      [ "$1" != mariadb ] || out=${out/mariadb=0/mariadb=1}
      out=${out/socket_plugin=0/socket_plugin=1}
    fi
  else
    out=$(db_check_sql "$@" | "${DB_CLIENT[@]}") || fail "$1 failed: cannot read what the server has"
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [[ $line =~ $re ]] || fail "cannot read the $1 checks: $line"
    printf -v "S_${BASH_REMATCH[1]}" '%s' "${BASH_REMATCH[2]}"
  done <<< "$out"
  for key in $keys; do
    var="S_$key"
    [ -n "${!var}" ] || fail "cannot read the $1 checks: no $key"
  done
}

# db_create_sql <engine> <name> <user> <password>: only what is missing (DB_PLUGIN, DB_NEW_USER,
# DB_NEW_DB, DB_GRANT, DB_NEW_TCP_USER, DB_TCP_GRANT). With DB_LOGIN=socket the user gets no password:
# Postgres peer auth, MariaDB unix_socket, MySQL auth_socket. The session first turns off the server's statement logs, so a
# password stays out of them.
db_create_sql() {
  local esc
  if [ "$1" = pgsql ]; then
    echo "SET log_statement = 'none';"
    echo "SET log_min_duration_statement = -1;"
    echo "SET log_min_error_statement = 'panic';"
    echo "SET pg_stat_statements.track_utility = off;"
    if [ -n "$DB_NEW_USER" ] && [ "$DB_LOGIN" = socket ]; then
      echo "CREATE ROLE \"$3\" LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;"
    elif [ -n "$DB_NEW_USER" ]; then
      printf '%s\n' "CREATE ROLE \"$3\" LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD '$4';"
    fi
    if [ -n "$DB_NEW_DB" ]; then
      echo "CREATE DATABASE \"$2\" OWNER \"$3\" ENCODING 'UTF8' TEMPLATE template0;"
      echo "REVOKE ALL ON DATABASE \"$2\" FROM PUBLIC;"
    fi
    return
  fi
  esc=$(printf '%s' "$2" | sed 's/_/\\_/g')
  echo "SET SESSION sql_log_off = 1;"
  [ -z "$DB_PLUGIN" ] || echo "INSTALL PLUGIN auth_socket SONAME 'auth_socket.so';"
  if [ -n "$DB_NEW_USER" ] && [ "$DB_LOGIN" = socket ] && [ "$1" = mariadb ]; then
    echo "CREATE USER '$3'@'localhost' IDENTIFIED VIA unix_socket;"
  elif [ -n "$DB_NEW_USER" ] && [ "$DB_LOGIN" = socket ]; then
    echo "CREATE USER '$3'@'localhost' IDENTIFIED WITH auth_socket;"
  elif [ -n "$DB_NEW_USER" ]; then
    printf '%s\n' "CREATE USER '$3'@'localhost' IDENTIFIED BY '$4';"
  fi
  # Laravel's default DB_HOST is 127.0.0.1, which matches 'localhost' only through a name lookup.
  [ -z "$DB_NEW_TCP_USER" ] || printf '%s\n' "CREATE USER '$3'@'127.0.0.1' IDENTIFIED BY '$4';"
  [ -z "$DB_NEW_DB" ] || echo "CREATE DATABASE \`$2\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
  [ -z "$DB_GRANT" ] || echo "GRANT ALL PRIVILEGES ON \`$esc\`.* TO '$3'@'localhost';"
  [ -z "$DB_TCP_GRANT" ] || echo "GRANT ALL PRIVILEGES ON \`$esc\`.* TO '$3'@'127.0.0.1';"
}

# D-2: only the deploy user, through sudo.
[ "$CALLER" = "$DEPLOY_USER" ] || fail "run through sudo as the deploy user $DEPLOY_USER"
[ $# -ge 1 ] || fail "usage: eeploi-helper <subcommand> [arguments]"

command=$1
shift

# Every call that can change something goes to the system log: who, the subcommand and its
# arguments, never what comes on stdin (a certificate, a command, a file). A dry run says so
# on stderr instead.
[ "$command" = "version" ] || audit "$CALLER: $command $*"

# D-1: a fixed list of subcommands, each with checked arguments and one fixed action.
case "$command" in
  version)
    echo "$VERSION" ;;

  nginx-test)
    run nginx -t ;;

  nginx-reload)
    run service nginx reload ;;

  php-fpm-reload)
    [ $# -eq 1 ] || fail "usage: php-fpm-reload <version>"
    php_version "$1"
    run service "php$1-fpm" reload ;;

  vhost-write)
    [ $# -eq 3 ] || fail "usage: vhost-write <domain> <user> <php-version>"
    file=$(vhost_file "$1")
    site_user "$2" "$1"
    php_version "$3"
    sock="/run/php/php$3-fpm-$2.sock"
    if [ -n "$DRY" ]; then vhost_conf "$1" "$2" "$sock" | sed 's/^/  /'; fi
    vhost_conf "$1" "$2" "$sock" | put "$file" 644
    registry_edit "$2" set "VHOST=$file" ;;

  vhost-backup)
    [ $# -eq 1 ] || fail "usage: vhost-backup <domain>"
    file=$(vhost_file "$1")
    dir="$STATE/nginx/$1"
    run mkdir -p -m 700 "$dir"
    run cp "$file" "$dir/vhost"
    if [ -f "/etc/nginx/ssl/$1" ] || [ -n "$DRY" ]; then run cp "/etc/nginx/ssl/$1" "$dir/ssl"; else run rm -f "$dir/ssl"; fi ;;

  vhost-restore)
    [ $# -eq 1 ] || fail "usage: vhost-restore <domain>"
    file=$(vhost_file "$1")
    dir="$STATE/nginx/$1"
    [ -f "$dir/vhost" ] || [ -n "$DRY" ] || fail "no backup for $1: $dir/vhost"
    run cp "$dir/vhost" "$file"
    if [ -f "$dir/ssl" ] || [ -n "$DRY" ]; then run cp "$dir/ssl" "/etc/nginx/ssl/$1"; fi ;;

  vhost-enable)
    [ $# -eq 1 ] || fail "usage: vhost-enable <domain>"
    domain "$1"
    run ln -sfn "/etc/nginx/sites-available/$1" "/etc/nginx/sites-enabled/$1" ;;

  vhost-disable)
    [ $# -eq 1 ] || fail "usage: vhost-disable <domain>"
    domain "$1"
    run rm -f "/etc/nginx/sites-enabled/$1" ;;

  vhost-remove)
    [ $# -eq 1 ] || fail "usage: vhost-remove <domain>"
    domain "$1"
    # Every check first: a refused call removes nothing.
    registry_lock
    registry_find "DOMAIN=$1"
    user=$REG_FOUND
    run rm -f "/etc/nginx/sites-enabled/$1" "/etc/nginx/sites-available/$1"
    [ -z "$user" ] || registry_edit "$user" clear VHOST
    registry_unlock ;;

  vhost-set-root)
    [ $# -eq 3 ] || fail "usage: vhost-set-root <domain> <old-root> <new-root>"
    file=$(vhost_file "$1")
    home_path "$2"
    home_path "$3"
    site_root "$2" "$1"
    site_root "$3" "$1"
    owner=''
    if [[ $3 =~ ^/srv/eeploi/([a-z][a-z0-9_]{0,31})/ ]]; then owner=${BASH_REMATCH[1]}; fi
    if [ -n "$DRY" ]; then
      if [ -n "$VHOST_STAND_IN" ]; then
        conf=$(vhost_root_conf "$2" "$3" "$owner" < "$VHOST_STAND_IN")
        vhost_paths "$VHOST_STAND_IN"
        echo "write: $file (644)"
        printf '%s\n' "$conf" | sed 's/^/  /'
      else
        echo "check: the vhost's includes and logs"
        echo "rewrite: $file: root $2; to root $3;"
        [ -z "$owner" ] || echo "  disable_symlinks if_not_owner from=/srv/eeploi/$owner;"
      fi
      run nginx -t
      exit 0
    fi
    [ -f "$file" ] || fail "no vhost for $1: $file"
    conf=$(vhost_root_conf "$2" "$3" "$owner" < "$file")
    vhost_paths "$file"
    # The copy stays out of sites-enabled, so nginx never reads it.
    backup=$(mktemp)
    TMP_PATHS="$TMP_PATHS $backup"
    cp -p "$file" "$backup"
    printf '%s\n' "$conf" | put "$file" 644
    if ! out=$(nginx -t 2>&1); then
      cp -p "$backup" "$file"
      echo "$out" >&2
      fail "nginx -t failed, vhost restored: $file"
    fi ;;

  vhost-set-socket)
    [ $# -eq 3 ] || fail "usage: vhost-set-socket <domain> <from-socket> <to-socket>"
    file=$(vhost_file "$1")
    socket "$2" "$1" from
    socket "$3" "$1" to
    [ "$2" != "$3" ] || fail "from and to are the same socket: $2"
    from=$(escape_dots "$2")
    line="^[[:space:]]*fastcgi_pass unix:$from;[[:space:]]*\$"
    if [ -z "$DRY" ]; then
      [ -f "$file" ] || fail "no vhost for $1: $file"
      grep -qE "$line" "$file" || fail "no 'fastcgi_pass unix:$2;' line in $file"
      vhost_paths "$file"
      backup=$(mktemp)
      TMP_PATHS="$TMP_PATHS $backup"
      cp -p "$file" "$backup"
    elif [ -n "$VHOST_STAND_IN" ]; then
      vhost_paths "$VHOST_STAND_IN"
    else
      echo "check: the vhost's includes and logs"
    fi
    run sed -i -E "s#^([[:space:]]*)fastcgi_pass unix:$from;([[:space:]]*)\$#\\1fastcgi_pass unix:$3;\\2#" "$file"
    if [ -n "$DRY" ]; then
      run nginx -t
    elif ! out=$(nginx -t 2>&1); then
      cp -p "$backup" "$file"
      echo "$out" >&2
      fail "nginx -t failed, vhost restored: $file"
    fi ;;

  vhost-set-cert)
    [ $# -eq 1 ] || fail "usage: vhost-set-cert <domain>"
    file=$(vhost_file "$1")
    for f in "$file" "/etc/nginx/ssl/$1"; do
      [ -f "$f" ] || [ -n "$DRY" ] || continue
      run sed -i -E "s#^(\s*)ssl_certificate\s+[^;]+;#\1ssl_certificate /etc/nginx/ssl/eeploi-$1.crt;#; s#^(\s*)ssl_certificate_key\s+[^;]+;#\1ssl_certificate_key /etc/nginx/ssl/eeploi-$1.key;#" "$f"
    done ;;

  ssl-csr)
    [ $# -eq 1 ] || fail "usage: ssl-csr <name>"
    cert_name "$1"
    key="/etc/nginx/ssl/$1.key"
    run mkdir -p /etc/nginx/ssl
    if [ ! -f "$key" ]; then
      # The key is private from the first byte: umask 077 while it is made.
      # shellcheck disable=SC2016 # $1 is for the inner shell
      run sh -c 'umask 077 && exec openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:prime256v1 -out "$1"' sh "$key"
    fi
    run chmod 600 "$key"
    run openssl req -new -key "$key" -subj "/CN=${1#eeploi-}" ;;

  ssl-write)
    [ $# -eq 1 ] || fail "usage: ssl-write <name> < certificate"
    cert_name "$1"
    pem=$(cat)
    pem_re='^-----BEGIN CERTIFICATE-----'$'\n''([A-Za-z0-9+/=]{1,76}'$'\n'')+''-----END CERTIFICATE-----$'
    [[ $pem =~ $pem_re ]] || fail "not one PEM certificate"
    printf '%s\n' "$pem" | put "/etc/nginx/ssl/$1.crt" 644 ;;

  ssl-remove)
    [ $# -eq 1 ] || fail "usage: ssl-remove <name>"
    cert_name "$1"
    run rm -f "/etc/nginx/ssl/$1.crt" "/etc/nginx/ssl/$1.key" ;;

  supervisor-write)
    [ $# -eq 4 ] || fail "usage: supervisor-write <program> <user> <directory> <processes> < command"
    program "$1"
    site_user "$2"
    site_domain=$REG_DOMAIN
    case "$1" in "eeploi-$site_domain-"?*) ;; *) fail "the program of site user $2 must start with eeploi-$site_domain-: $1" ;; esac
    # No dot after the domain, and no other listed domain that fits too: each name has one site.
    [[ ${1#"eeploi-$site_domain-"} =~ ^[a-z0-9-]+$ ]] || fail "after eeploi-$site_domain- only a-z, 0-9 and -: $1"
    case "$3" in "/srv/eeploi/$2/$site_domain/"?*) ;; *) fail "not in /srv/eeploi/$2/$site_domain: $3" ;; esac
    site_path "$2" "$3"
    [[ $4 =~ ^([1-9]|[12][0-9]|3[0-2])$ ]] || fail "processes must be 1 to 32: $4"
    worker=$(cat)
    [ -n "$worker" ] || fail "empty command"
    [[ $worker != *$'\n'* && $worker != *$'\r'* ]] || fail "the command must be one line"
    [[ $worker =~ ^[[:print:]]+$ ]] || fail "the command has control characters"
    # supervisord expands %(name)s in a command; a bad one stops it reading its config.
    [[ $worker != *%* ]] || fail "the command cannot contain %"
    file="/etc/supervisor/conf.d/$1.conf"
    # Under the lock, together with the write: who owns the name, and no other listed domain that fits.
    registry_lock
    registry_find "SUPERVISOR=$file"
    [ -z "$REG_FOUND" ] || [ "$REG_FOUND" = "$2" ] || fail "$1 belongs to site user $REG_FOUND"
    domains=$(registry_domains)
    while read -r other other_domain; do
      [ -n "$other" ] && [ "$other" != "$2" ] || continue
      case "$1" in
        "eeploi-$other_domain-"?*)
          [[ ${1#"eeploi-$other_domain-"} == *.* ]] || fail "$1 also fits site user $other ($other_domain)" ;;
      esac
    done <<< "$domains"
    # Root:<user> 750: the site reads its own worker logs, no other site does.
    logs="/var/log/supervisor/eeploi/$2"
    root_dir /var/log/supervisor/eeploi
    run install -d -o root -g "$2" -m 750 "$logs"
    if [ -n "$DRY" ]; then supervisor_conf "$1" "$2" "$3" "$4" "$worker" | sed 's/^/  /'; fi
    supervisor_conf "$1" "$2" "$3" "$4" "$worker" | put "$file" 644
    registry_edit "$2" add "SUPERVISOR=$file" set "LOGS=$logs"
    registry_unlock ;;

  supervisor-remove)
    [ $# -eq 1 ] || fail "usage: supervisor-remove <program>"
    program "$1"
    registry_lock
    registry_find "SUPERVISOR=/etc/supervisor/conf.d/$1.conf"
    run rm -f "/etc/supervisor/conf.d/$1.conf"
    [ -z "$REG_FOUND" ] || registry_edit "$REG_FOUND" del "SUPERVISOR=/etc/supervisor/conf.d/$1.conf"
    registry_unlock ;;

  supervisor-remove-site)
    [ $# -eq 1 ] || fail "usage: supervisor-remove-site <domain>"
    domain "$1"
    # Only the programs the site's registry lists (and their .paused copies): a name prefix could also
    # fit another site. Every line is checked before anything is removed.
    registry_lock
    registry_find "DOMAIN=$1"
    [ -n "$REG_FOUND" ] || exit 0
    user=$REG_FOUND
    registry_read "$user"
    files=''
    while IFS= read -r line; do
      case "$line" in SUPERVISOR=*) ;; *) continue ;; esac
      f=${line#SUPERVISOR=}
      [[ $f =~ ^/etc/supervisor/conf\.d/eeploi-[a-z0-9.-]+\.conf$ ]] || fail "invalid Supervisor config in $REG_FILE: $f"
      files="$files $f"
    done <<< "$REG_LINES"
    [ -n "$files" ] || exit 0
    for f in $files; do run rm -f "$f" "$f.paused"; done
    registry_edit "$user" clear SUPERVISOR
    registry_unlock ;;

  supervisor-pause)
    [ $# -eq 1 ] || fail "usage: supervisor-pause <config>"
    supervisor_file "$1"
    run mv "$1" "$1.paused" ;;

  supervisor-resume)
    [ $# -eq 1 ] || fail "usage: supervisor-resume <config>"
    supervisor_file "$1"
    if [ -f "$1.paused" ] || [ -n "$DRY" ]; then run mv "$1.paused" "$1"; fi ;;

  supervisor-update)
    run supervisorctl reread
    run supervisorctl update ;;

  cron-write)
    [ $# -eq 1 ] || fail "usage: cron-write <user> < line"
    site_user "$1"
    line=$(cat)
    artisan="/srv/eeploi/$1/$REG_DOMAIN/current/artisan"
    re="^\* \* \* \* \* $1 php([0-9]\.[0-9])? $(escape_dots "$artisan") schedule:run > /dev/null 2>&1$"
    [[ $line =~ $re ]] || fail "only '* * * * * $1 php $artisan schedule:run > /dev/null 2>&1' is allowed"
    # No dots in the file name: cron skips files in /etc/cron.d whose name has one.
    [ -z "$DRY" ] || printf '  %s\n' "$line"
    printf '%s\n' "$line" | put "/etc/cron.d/eeploi-$1" 644
    registry_edit "$1" set "CRON=/etc/cron.d/eeploi-$1" ;;

  cron-remove)
    [ $# -eq 1 ] || fail "usage: cron-remove <user>"
    site_user "$1"
    run rm -f "/etc/cron.d/eeploi-$1"
    registry_edit "$1" clear CRON ;;

  crontab-remove-lines)
    [ $# -eq 1 ] || fail "usage: crontab-remove-lines <domain> < lines"
    domain "$1"
    patterns=$(mktemp)
    TMP_PATHS="$TMP_PATHS $patterns"
    cat > "$patterns"
    # Only a panel's own jobs: run as ploi or forge, on a path in their home. Never system lines.
    line_re='^[^#[:space:]]+([[:space:]]+[^[:space:]]+){4}[[:space:]]+(ploi|forge)[[:space:]]+.*/home/(ploi|forge)/.*$'
    count=0
    while IFS= read -r line || [ -n "$line" ]; do
      [ -n "$line" ] || continue
      [[ $line =~ $line_re ]] || fail "only ploi or forge jobs in their home can be removed: $line"
      count=$((count + 1))
    done < "$patterns"
    [ $count -gt 0 ] || fail "no lines given"
    saved="$STATE/crontab/$1"
    if [ -n "$DRY" ]; then
      while IFS= read -r line; do [ -n "$line" ] && echo "remove from /etc/crontab: $line"; done < "$patterns"
      echo "save: $saved"
    else
      install -d -m 700 "$STATE/crontab"
      grep -xF -f "$patterns" /etc/crontab | put "$saved" 600 || true
      tmp=$(mktemp /etc/crontab.eeploi.XXXXXX)
      grep -vxF -f "$patterns" /etc/crontab > "$tmp" || true
      chmod 644 "$tmp"
      mv -f "$tmp" /etc/crontab
    fi ;;

  crontab-restore)
    [ $# -eq 1 ] || fail "usage: crontab-restore <domain>"
    domain "$1"
    saved="$STATE/crontab/$1"
    if [ -n "$DRY" ]; then
      echo "add back to /etc/crontab: the lines in $saved"
    elif [ -f "$saved" ]; then
      # Only the lines crontab-remove-lines took out, each once; later changes to /etc/crontab stay.
      tmp=$(mktemp /etc/crontab.eeploi.XXXXXX)
      cp -p /etc/crontab "$tmp"
      while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        grep -qxF -- "$line" "$tmp" || printf '%s\n' "$line" >> "$tmp"
      done < "$saved"
      chmod 644 "$tmp"
      mv -f "$tmp" /etc/crontab
      rm -f "$saved"
    fi ;;

  env-install)
    [ $# -eq 3 ] || fail "usage: env-install <from-file> <to-file> <owner>"
    source_path "$1" .env
    site_user "$3"
    site_path "$3" "$2"
    [ -f "$SRC" ] || [ -n "$DRY" ] || fail "no file: $1"
    # The panel's user reads the source (no link at the end), the site user writes the copy: root
    # opens neither path.
    # shellcheck disable=SC2016 # $1 is for the inner shell
    write='umask 027 && cat > "$1" && chmod 640 "$1"'
    cd / || fail "cannot change to /"
    if [ -n "$DRY" ]; then
      echo "run: runuser -u $SRC_OWNER -- dd if=$SRC iflag=nofollow | runuser -u $3 -- sh -c '$write' sh $2"
    else
      runuser -u "$SRC_OWNER" -- dd if="$SRC" iflag=nofollow status=none | runuser -u "$3" -- sh -c "$write" sh "$2"
    fi ;;

  storage-copy)
    [ $# -eq 3 ] || fail "usage: storage-copy <from-dir> <to-dir> <owner>"
    source_path "$1" storage
    site_user "$3"
    site_path "$3" "$2"
    # The panel's user reads the source with tar (links stay links), the site user unpacks it in its own
    # folder: root opens neither path.
    cd / || fail "cannot change to /"
    if [ -n "$DRY" ]; then
      echo "run: runuser -u $SRC_OWNER -- tar -C $SRC -cf - . | runuser -u $3 -- tar -C $2 -xf - --no-same-owner"
    elif [ -d "$SRC" ]; then
      runuser -u "$SRC_OWNER" -- tar -C "$SRC" -cf - . | runuser -u "$3" -- tar -C "$2" -xf - --no-same-owner
    fi ;;

  db-create)
    [ $# -eq 4 ] || fail "usage: db-create <engine> <name> <user> <socket|password> [< password]"
    db_engine "$1"
    db_name database "$2"
    db_name user "$3"
    db_login "$4"
    # D-25: socket login trusts every process of that Linux user: only a site user the helper made,
    # never one that runs more than one site or a system user.
    [ "$DB_LOGIN" != socket ] || site_user "$3"
    cd / || fail "cannot change to /"
    db_client "$1"
    db_state "$1" "$2" "$3"
    case "$1" in
      mysql) [ "$S_mariadb" = 0 ] || fail "this server runs MariaDB, not MySQL" ;;
      mariadb) [ "$S_mariadb" = 1 ] || fail "this server runs MySQL, not MariaDB" ;;
    esac
    # The user gets that one database and nothing else; a database someone else can use is not taken.
    [ "$S_user_global" = 0 ] || fail "user $3 has rights beyond one database, refusing"
    [ "$S_user_elsewhere" = 0 ] || fail "user $3 has rights on another database, refusing"
    [ "$S_db_others" = 0 ] || fail "database $2 belongs to another user, refusing"
    [ "$S_db_exists" = 0 ] || [ "$S_granted" != 0 ] || fail "database $2 exists and is not $3's, refusing"
    # D-25: an existing user keeps its way in: never switched between socket and password login.
    if [ "$S_user_exists" != 0 ] && [ "$DB_LOGIN" = socket ] && [ "$S_user_socket" = 0 ]; then
      fail "user $3 exists with password login, not socket login: refusing, it is not switched"
    fi
    if [ "$S_user_exists" != 0 ] && [ "$DB_LOGIN" = password ] && [ "$S_user_socket" != 0 ]; then
      fail "user $3 exists with socket login, not password login: refusing, it is not switched"
    fi
    # A socket has no IP, so socket login never has a 127.0.0.1 user. A user there alone has a
    # password the caller can't know.
    if [ "$1" != pgsql ] && [ "$DB_LOGIN" = socket ] && [ "$S_tcp_user_exists$S_tcp_granted" != 00 ]; then
      fail "user $3 exists on 127.0.0.1 with password login, not socket login: refusing, it is not switched"
    fi
    if [ "$1" != pgsql ] && [ "$DB_LOGIN" = password ] && [ "$S_user_exists" = 0 ] && [ "$S_tcp_user_exists" != 0 ]; then
      fail "user $3 exists on 127.0.0.1 only, refusing"
    fi
    # MySQL's auth_socket is a plugin; Ubuntu installs it unless root got a password. MariaDB has
    # unix_socket built in and on since 10.4.
    DB_PLUGIN=
    if [ "$DB_LOGIN" = socket ] && [ "$1" = mysql ] && [ "$S_socket_plugin" = 0 ]; then DB_PLUGIN=1; fi
    if [ "$DB_LOGIN" = socket ] && [ "$1" = mariadb ] && [ "$S_socket_plugin" = 0 ]; then
      fail "the unix_socket plugin is not active on this MariaDB server, refusing"
    fi
    DB_NEW_USER=
    DB_NEW_DB=
    DB_GRANT=
    [ "$S_user_exists" != 0 ] || DB_NEW_USER=1
    [ "$S_db_exists" != 0 ] || DB_NEW_DB=1
    [ "$S_granted" != 0 ] || DB_GRANT=1
    # D-25: password login on MySQL and MariaDB: a new user gets the same user on 127.0.0.1, with the
    # same password and grant. Never for a user that exists: the password on stdin could be anyone's, so
    # a 1.0.0 user stays on localhost only.
    DB_NEW_TCP_USER=
    DB_TCP_GRANT=
    if [ "$1" != pgsql ] && [ "$DB_LOGIN" = password ]; then
      [ -z "$DB_NEW_USER" ] || DB_NEW_TCP_USER=1
      if [ -n "$DB_NEW_TCP_USER" ] || [ "$S_tcp_user_exists" != 0 ]; then
        [ "$S_tcp_granted" != 0 ] || DB_TCP_GRANT=1
      fi
    fi
    if [ -z "$DB_PLUGIN$DB_NEW_USER$DB_NEW_DB$DB_GRANT$DB_NEW_TCP_USER$DB_TCP_GRANT" ]; then
      echo "exists: $1 database $2 for user $3, nothing changed ($DB_LOGIN login)"
      exit 0
    fi
    # The SQL goes on the client's stdin (printf is a shell builtin), so the password is on no command line.
    if [ -n "$DRY" ]; then
      echo "run: ${DB_CLIENT[*]} (SQL on stdin)"
      db_create_sql "$1" "$2" "$3" '<password>' | sed 's/^/  /'
    elif ! out=$(db_create_sql "$1" "$2" "$3" "$DB_PASSWORD" | "${DB_CLIENT[@]}" 2>&1); then
      # Only the error lines, without the password: psql repeats the failing statement.
      [ -z "$DB_PASSWORD" ] || out=${out//"$DB_PASSWORD"/<password>}
      printf '%s\n' "$out" | grep -E 'ERROR|FATAL' >&2 || true
      fail "$1 failed: database $2 for user $3 not created"
    fi
    if [ -n "$DB_NEW_USER" ]; then
      echo "created: $1 database $2 for user $3 ($DB_LOGIN login)"
    elif [ "$DB_LOGIN" = socket ]; then
      echo "created: $1 database $2 for user $3 (socket login, the user existed)"
    elif [ "$1" != pgsql ] && [ "$S_tcp_user_exists" = 0 ]; then
      echo "created: $1 database $2 for user $3 (password login, the user existed on localhost only, its password is unchanged)"
    else
      echo "created: $1 database $2 for user $3 (password login, the user existed, its password is unchanged)"
    fi ;;

  firewall-close-22)
    [ $# -eq 0 ] || fail "usage: firewall-close-22"
    # D-23: only on a server eeploi created.
    trusted "$ETC/new-server" || fail "firewall-close-22 only runs on a server eeploi created ($ETC/new-server is missing or not root-owned)"
    run ufw delete allow 22/tcp ;;

  site-user-create)
    [ $# -eq 2 ] || fail "usage: site-user-create <user> <domain>"
    site_user_name "$1"
    domain "$2"
    home="/srv/eeploi/$1"
    # Under the lock from the domain check until the registry file is written (or taken out again):
    # two calls at once can't list one domain twice.
    root_dir "$ETC/sites"
    registry_lock
    registry_find "DOMAIN=$2"
    [ -z "$REG_FOUND" ] || [ "$REG_FOUND" = "$1" ] || fail "$2 is listed for site user $REG_FOUND"
    new=1
    if [ -e "$ETC/sites/$1" ] || [ -L "$ETC/sites/$1" ]; then
      registry_read "$1"
      [ "$REG_DOMAIN" = "$2" ] || fail "site user $1 is for $REG_DOMAIN, not $2"
      new=0
      if passwd_of "$1" > /dev/null; then
        registry_unlock
        site_user "$1" "$2"
        site_home "$1"
        echo "exists: site user $1 for $2, nothing changed"
        exit 0
      fi
    fi
    # Without a user (a new site, or a call that stopped halfway) nothing of that name may be there.
    if passwd_of "$1" > /dev/null || group_of "$1" > /dev/null || present "$home"; then
      fail "$1 exists (a user, group or $home) and is not an eeploi site user"
    fi
    if [ $new -eq 1 ]; then
      REG_FILE="$ETC/sites/$1"
      REG_LINES="DOMAIN=$2"$'\n'"HOME=$home"$'\n'
      registry_write
    fi
    root_dir /srv/eeploi
    if [ -n "$DRY" ]; then
      run useradd --home-dir "$home" --create-home --user-group --shell /usr/sbin/nologin "$1"
      echo "check: site user $1 (uid 1000 or higher, home $home, only its own group)"
    else
      if ! useradd --home-dir "$home" --create-home --user-group --shell /usr/sbin/nologin "$1"; then
        [ $new -eq 0 ] || rm -f "$ETC/sites/$1"
        fail "useradd failed: site user $1 not created"
      fi
    fi
    registry_unlock
    [ -n "$DRY" ] || site_user "$1" "$2"
    site_home "$1"
    echo "created: site user $1 for $2, home $home" ;;

  run-as)
    [ $# -eq 1 ] || fail "usage: run-as <user> < script"
    site_user "$1"
    [ ! -t 0 ] || fail "run-as needs the script on stdin, not a terminal"
    { [ ! -t 1 ] && [ ! -t 2 ]; } || fail "run-as needs its output in a pipe or a file, not a terminal"
    cd / || fail "cannot change to /"
    # setsid: the site user's shell starts in a new session, without a controlling terminal.
    # --wait keeps its exit code.
    as=(setsid --wait runuser -u "$1" -- env -i HOME="/srv/eeploi/$1" USER="$1" LOGNAME="$1" PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 /bin/bash -s)
    if [ -n "$DRY" ]; then
      run "${as[@]}"
      exit 0
    fi
    exec "${as[@]}" ;;

  releases-own)
    [ $# -eq 1 ] || fail "usage: releases-own <user>"
    site_user "$1"
    dir="/srv/eeploi/$1/$REG_DOMAIN"
    # Root works from inside the checked site folder, in one walk. chown runs from each file's own
    # folder and changes a link itself, never where it points (-execdir, -h); a folder's files come
    # before the folder (-depth). Only folders and single-link files root or the deploy user owns, and
    # only with the kernel's hard link protection on.
    # D-10: one walk, a link never followed, a hard-linked file left as it is.
    if [ -n "$DRY" ]; then
      echo "check: fs.protected_hardlinks is 1"
      echo "run: cd $dir"
    else
      [ "$(cat /proc/sys/fs/protected_hardlinks 2> /dev/null)" = 1 ] || fail "fs.protected_hardlinks is off, refusing"
      cd -P -- "$dir" 2> /dev/null || fail "no site folder: $dir"
      [ "$(pwd -P)" = "$dir" ] || fail "$dir is a link, refusing"
      [[ -d releases && ! -L releases ]] || fail "no releases folder in $dir"
    fi
    run find releases -depth \( -user root -o -user "$DEPLOY_USER" \) \( -type d -o -links 1 \) \
      -execdir chown -h "$1:" -- {} + ;;

  redis-create)
    [ $# -eq 1 ] || [ $# -eq 2 ] || fail "usage: redis-create <user> [<mb>]"
    site_user "$1"
    mb=128
    [ $# -eq 1 ] || mb=$2
    { [[ $mb =~ ^[1-9][0-9]{1,3}$ ]] && [ "$mb" -ge 32 ] && [ "$mb" -le 1024 ]; } \
      || fail "the Redis size must be a whole number of MB from 32 to 1024: $mb"
    unit="eeploi-redis@$1"
    dropin="/etc/systemd/system/$unit.service.d/memory.conf"
    conf="$ETC/redis/$1.conf"
    data="/srv/eeploi/$1/.redis"
    root_dir "$ETC/redis"
    root_dir "${dropin%/*}"
    # The template, the config and the drop-in are kept first: a failed restart puts all three back.
    [ -n "$DRY" ] || keep "$REDIS_TEMPLATE" "$conf" "$dropin"
    # The template is the same for every site: written when it is missing or differs.
    if [ -n "$DRY" ] || ! redis_unit | cmp -s - "$REDIS_TEMPLATE"; then
      [ -z "$DRY" ] || redis_unit | sed 's/^/  /'
      redis_unit | put "$REDIS_TEMPLATE" 644
    fi
    [ -z "$DRY" ] || redis_conf "$1" "$mb" | sed 's/^/  /'
    redis_conf "$1" "$mb" | put "$conf" 644
    [ -z "$DRY" ] || redis_dropin "$mb" | sed 's/^/  /'
    redis_dropin "$mb" | put "$dropin" 644
    run systemctl daemon-reload
    # The site user makes its own folder: root writes nothing inside the home.
    cd / || fail "cannot change to /"
    run runuser -u "$1" -- install -d -m 700 "$data"
    state=stopped
    if running "$unit.service"; then
      if [ -n "$DRY" ]; then
        run systemctl restart "$unit"
      elif ! out=$(systemctl restart "$unit" 2>&1); then
        restore_kept
        systemctl daemon-reload
        systemctl restart "$unit" > /dev/null 2>&1 || true
        echo "$out" >&2
        fail "Redis of $1 did not restart, previous unit, config and drop-in restored"
      fi
      state=restarted
    fi
    # Only after a good restart, or when nothing was running.
    registry_edit "$1" set "REDIS_UNIT=$unit.service" "REDIS_DROPIN=$dropin" "REDIS_CONF=$conf" "REDIS_SOCKET=$data/redis.sock"
    echo "prepared: Redis of site user $1, $mb MB, $state" ;;

  redis-start)
    [ $# -eq 1 ] || fail "usage: redis-start <user>"
    site_user "$1"
    case $'\n'"$REG_LINES" in *$'\n'REDIS_CONF=*) ;; *) fail "no Redis for site user $1 yet: run redis-create first" ;; esac
    if [ -z "$DRY" ]; then
      { trusted "$ETC/redis/$1.conf" && trusted "/etc/systemd/system/eeploi-redis@$1.service.d/memory.conf" && [ -f "$REDIS_TEMPLATE" ]; } \
        || fail "no Redis for site user $1 yet: run redis-create first"
      [ -x /usr/bin/redis-server ] || fail "Redis is not installed on this server (no /usr/bin/redis-server): install the redis-server package first"
    else
      present /usr/bin/redis-server || fail "Redis is not installed on this server (no /usr/bin/redis-server): install the redis-server package first"
    fi
    run systemctl enable --now "eeploi-redis@$1" ;;

  redis-stop)
    [ $# -eq 1 ] || fail "usage: redis-stop <user>"
    site_user "$1"
    # Its data stays in the home, so it is there again when Redis is switched back on.
    run systemctl disable --now "eeploi-redis@$1" ;;

  php-pool-write)
    [ $# -eq 2 ] || fail "usage: php-pool-write <version> <user>"
    php_version "$1"
    site_user "$2"
    dir="/etc/php/$1/fpm/pool.d"
    file="$dir/eeploi-$2.conf"
    ini="/etc/php/$1/fpm/conf.d/90-eeploi.ini"
    # One pool per site: the pool of another PHP version that the registry lists goes, once the new one
    # passes its test.
    old='' old_version=''
    while IFS= read -r line; do
      case "$line" in POOL=*) old=${line#POOL=} ;; esac
    done <<< "$REG_LINES"
    if [ -n "$old" ] && [ "$old" != "$file" ]; then
      [[ $old =~ ^/etc/php/([0-9]\.[0-9])/fpm/pool\.d/eeploi-$2\.conf$ ]] || fail "invalid POOL in $REG_FILE: $old"
      old_version=${BASH_REMATCH[1]}
    else
      old=''
    fi
    if [ -n "$DRY" ]; then
      echo "write: $file (644)"
      pool_conf "$1" "$2" | sed 's/^/  /'
      echo "write: $ini (644)"
      opcache_ini | sed 's/^/  /'
      run "php-fpm$1" -t
      if [ -n "$old" ]; then
        run rm -f "$old"
        run "php-fpm$old_version" -t
      fi
      registry_edit "$2" set "POOL=$file"
      run service "php$1-fpm" reload
      [ -z "$old" ] || run service "php$old_version-fpm" reload
      exit 0
    fi
    [[ -d $dir && ! -L $dir ]] || fail "PHP $1 FPM is not installed: $dir"
    [[ -d ${ini%/*} && ! -L ${ini%/*} ]] || fail "PHP $1 FPM is not installed: ${ini%/*}"
    command -v "php-fpm$1" > /dev/null || fail "php-fpm$1 not found"
    keep "$file" "$ini"
    pool_conf "$1" "$2" | put "$file" 644
    opcache_ini | put "$ini" 644
    if ! out=$("php-fpm$1" -t 2>&1); then
      restore_kept
      echo "$out" >&2
      fail "php-fpm$1 -t failed, previous pool restored"
    fi
    if [ -n "$old" ] && [ -f "$old" ]; then
      old_backup=$(mktemp "${old%/*}/.${old##*/}.backup.XXXXXX")
      TMP_PATHS="$TMP_PATHS $old_backup"
      cp -p "$old" "$old_backup"
      rm -f "$old"
      if command -v "php-fpm$old_version" > /dev/null && ! out=$("php-fpm$old_version" -t 2>&1); then
        mv -f "$old_backup" "$old"
        restore_kept
        echo "$out" >&2
        fail "php-fpm$old_version -t failed without the PHP $old_version pool, both pools restored"
      fi
    fi
    registry_edit "$2" set "POOL=$file"
    service "php$1-fpm" reload
    if [ -n "$old" ]; then
      service "php$old_version-fpm" reload || echo "eeploi-helper: php$old_version-fpm did not reload, the PHP $old_version pool stays until it does" >&2
    fi ;;

  self-update)
    [ $# -eq 1 ] || fail "usage: self-update <version>"
    [[ $1 =~ $SEMVER_RE ]] || fail "invalid version: $1"
    # D-16: only a newer version.
    version_lt "$VERSION" "$1" || fail "only a newer version: $VERSION is installed, $1 is not newer"
    release_key "$PUBKEY" release PUBKEY
    url="$RELEASES/v$1/eeploi-helper"
    fetch=("${FETCH[@]}" --max-filesize 1048576)
    if [ -n "$DRY" ]; then
      echo "download: $url"
      echo "download: $url.minisig"
      echo "run: ${fetch[*]} -o <download>/<file> <url>"
      echo "run: minisign ${VERIFY[*]} -P $PUBKEY -m <download>/eeploi-helper -x <download>/eeploi-helper.minisig"
      echo "run: bash -n <download>/eeploi-helper"
      echo "check: <download>/eeploi-helper version = $1"
      echo "install: $INSTALL_PATH (root:root 755)"
      exit 0
    fi
    command -v curl > /dev/null || fail "curl not found"
    command -v "$MINISIGN" > /dev/null || fail "minisign not found"
    work=$(mktemp -d)
    TMP_PATHS="$TMP_PATHS $work"
    for f in eeploi-helper eeploi-helper.minisig; do
      "${fetch[@]}" -o "$work/$f" "$RELEASES/v$1/$f" || fail "download failed: $RELEASES/v$1/$f"
    done
    "$MINISIGN" "${VERIFY[@]}" -P "$PUBKEY" -m "$work/eeploi-helper" -x "$work/eeploi-helper.minisig" \
      || fail "signature check failed, nothing changed"
    bash -n "$work/eeploi-helper" || fail "the new helper is not valid bash, nothing changed"
    got=$(env -i PATH="$PATH" SUDO_USER="$CALLER" bash "$work/eeploi-helper" version 2>&1) \
      || fail "the new helper does not run, nothing changed"
    [ "$got" = "$1" ] || fail "the new helper says version $got, expected $1, nothing changed"
    new=$(mktemp "$INSTALL_PATH.eeploi.XXXXXX")
    TMP_PATHS="$TMP_PATHS $new"
    cp "$work/eeploi-helper" "$new"
    chown root:root "$new"
    chmod 755 "$new"
    mv -f "$new" "$INSTALL_PATH"
    echo "eeploi-helper $VERSION -> $1"
    exit 0 ;;

  recipe-run)
    [ $# -eq 2 ] || fail "usage: recipe-run <version> <provider>"
    [[ $1 =~ $SEMVER_RE ]] || fail "invalid version: $1"
    # D-21: the recipes repo checks its provider names by this same rule.
    [[ $2 =~ ^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$ ]] || fail "invalid provider: $2"
    release_key "$RECIPES_PUBKEY" recipes RECIPES_PUBKEY
    recipes_conf
    os_target
    tools=("$MINISIGN" tar gzip sha256sum)
    [ -n "$DRY" ] || tools+=(curl flock)
    for tool in "${tools[@]}"; do command -v "$tool" > /dev/null || fail "$tool not found"; done
    recipes_lock
    recipes_state
    # A release older than the last good one here is refused; the same one may run again.
    # D-19: never an older release.
    [ -z "$R_LAST" ] || ! version_lt "$1" "$R_LAST" || fail "recipes $R_LAST ran here, $1 is older: refused"
    R_BASE="$RECIPES_RELEASES/v$1"
    R_WORK=$(mktemp -d) || fail "cannot make a work folder"
    TMP_PATHS="$TMP_PATHS $R_WORK"
    manifest="recipes-$1-$2-$R_OS.manifest"
    package="recipes-$1.tar.gz"
    # D-18: nothing else is downloaded or read before the signature checks out, and every size is capped.
    recipes_fetch "$manifest" 65536
    recipes_fetch "$manifest.minisig" 4096
    [ -z "$DRY" ] || echo "check: minisign ${VERIFY[*]} -P $RECIPES_PUBKEY -m $manifest -x $manifest.minisig"
    "$MINISIGN" "${VERIFY[@]}" -P "$RECIPES_PUBKEY" -m "$R_WORK/$manifest" -x "$R_WORK/$manifest.minisig" > /dev/null 2>&1 \
      || fail "signature check failed: $manifest, nothing ran"
    recipes_manifest "$R_WORK/$manifest" "$1" "$2"
    recipes_fetch "$package" 4194304
    recipes_unpack "$R_WORK/$package"
    echo "recipe-run $1 $2 $R_OS"
    # The always steps, in order: one that is new or changed here runs, and so does one whose check
    # fails now. After a failed step the rest don't run.
    failed=0 kept='' FAIL_EXIT=1
    for ((i = 0; i < R_N; i++)); do
      [ "${R_KIND[i]}" = always ] || continue
      p=${R_PATH[i]} sha=${R_SHA[i]}
      if [ $failed -eq 1 ]; then
        echo "step skipped $p"
        audit "$CALLER: recipe-run $1: step skipped $p"
        continue
      fi
      state='ran'
      case $'\n'"$R_RAN" in
        *$'\n'"$sha $p"$'\n'*)
          check=${p%.sh}.check.sh
          if ! recipes_index "$check" || ! recipes_is_check "$R_I" || recipes_check "$check"; then state='same'; fi ;;
      esac
      if [ "$state" = ran ]; then
        # Under set -e whatever start.sh sets, as a check is.
        {
          recipes_render "$RECIPE_START" "$RECIPE_VALUES"
          echo
          echo 'set -euo pipefail'
          recipes_render "$p"
        } > "$R_WORK/step.sh"
        recipes_exec "$p" "$R_WORK/step.sh" || { state='failed'; failed=1; }
      fi
      echo "step $state $p"
      audit "$CALLER: recipe-run $1: step $state $p"
      kept="$kept$sha $p"$'\n'
    done
    # Then every check, read-only, each on its own.
    checks=0
    for ((i = 0; i < R_N; i++)); do
      recipes_is_check "$i" || continue
      p=${R_PATH[i]}
      if recipes_check "$p"; then echo "check ok $p"; else echo "check failed $p"; checks=1; fi
    done
    # The state only after every step went well; a failed run runs its steps again next time. Then
    # the checks and probes are kept, for server-report.
    if [ $failed -eq 0 ]; then
      recipes_state_write "$1" "$kept"
      # The same or a newer release replaces the kept set (the same one repairs it), never an older
      # one. A set it can't keep leaves the one before and doesn't stop the run.
      report_kept
      if [ -z "$K_RELEASE" ] || ! version_lt "$1" "$K_RELEASE"; then
        recipes_keep "$1" "$2 $R_OS" || echo "eeploi-helper: the checks and probes were not kept for server-report: until a good run keeps them, the report runs none" >&2
      fi
    fi
    if [ $failed -eq 0 ] && [ $checks -eq 0 ]; then result=ok; else result=failed; fi
    echo "result $result"
    audit "$CALLER: recipe-run $1: result $result"
    [ "$result" = ok ] || exit 1 ;;

  server-report)
    { [ $# -eq 0 ] || { [ $# -eq 1 ] && [ "$1" = --json ]; }; } || fail "usage: server-report [--json]"
    report_lock
    recipes_state
    # The values and the OS by recipe-run's own rules, without refusing the report.
    if [ ! -e "$ETC/recipes.conf" ] && [ ! -L "$ETC/recipes.conf" ]; then REP_VALUES=none
    elif values=$(recipes_conf 2> /dev/null && echo "$R_USER $R_PORT $R_PHP"); then
      read -r R_USER R_PORT R_PHP <<< "$values"
      REP_VALUES=ok
    else REP_VALUES=unreadable
    fi
    if values=$(os_target 2> /dev/null && echo "$R_OS $R_VERSION"); then
      read -r R_OS R_VERSION <<< "$values"
      REP_OS="${R_OS%-"$R_VERSION"} $R_VERSION"
    else REP_OS=unknown
    fi
    report_base
    # Parts 2 and the probes: ran, none (nothing to run) or not-run (they can't run here: exit 1).
    REP_CHECKS=ran REP_CHECKS_WHY='' REP_PROBES=ran REP_PROBES_WHY='' K_RELEASE='' K_TARGET='' K_PATH=() REP_EXIT=0
    if [ -z "$R_LAST" ]; then
      # D-33: a server without recipe-run state gets part 1 and the base only.
      REP_SETUP=not-eeploi REP_CHECKS=none REP_PROBES=none REP_CHECKS_WHY="not set up by eeploi"
    else
      REP_SETUP=eeploi
      report_kept
      if [ -n "$K_ERROR" ]; then
        REP_CHECKS=not-run REP_PROBES=not-run REP_CHECKS_WHY=$K_ERROR
      elif [ -z "$K_RELEASE" ]; then
        REP_CHECKS=none REP_PROBES=none REP_CHECKS_WHY="none kept: no good recipe-run since helper 1.2.0"
      elif [ "$K_RELEASE" != "$R_LAST" ]; then
        # D-27: the kept set is the last good run's, or it isn't used.
        REP_CHECKS=not-run REP_PROBES=not-run REP_CHECKS_WHY="the kept set is of recipes $K_RELEASE, the last good run of $R_LAST"
      elif ! report_fits; then
        REP_CHECKS=not-run REP_PROBES=not-run REP_CHECKS_WHY=$REP_FIT_WHY
      # D-32: the checks run only with this server's own values.
      elif [ "$REP_VALUES" = none ]; then REP_CHECKS=not-run REP_CHECKS_WHY="no $ETC/recipes.conf"
      elif [ "$REP_VALUES" = unreadable ]; then REP_CHECKS=not-run REP_CHECKS_WHY="$ETC/recipes.conf can't be used (recipe-run says why)"
      fi
    fi
    [ "$REP_PROBES" = ran ] || REP_PROBES_WHY=$REP_CHECKS_WHY
    if [ "$REP_CHECKS" = not-run ] || [ "$REP_PROBES" = not-run ]; then REP_EXIT=1; fi
    R_WORK=$(mktemp -d) || fail "cannot make a work folder"
    TMP_PATHS="$TMP_PATHS $R_WORK"
    R_FILES=$KEPT
    C_STATE=() C_PATH=() C_NOTES=() P_NAME=() P_STATE=() P_LINES=() P_REJECTED=()
    [ "$REP_CHECKS" != ran ] || report_checks
    [ "$REP_PROBES" != ran ] || report_probes
    if [ "${1:-}" = --json ]; then report_json; else report_text; fi
    exit "$REP_EXIT" ;;

  server-reboot)
    # D-36: reboots the server, with no arguments, for the deploy user only.
    [ $# -eq 0 ] || fail "usage: server-reboot"
    # D-40: one reboot at a time: a second call says when the pending one is due. D-42: a new one comes
    # 15 minutes after the last at the earliest.
    if reboot_pending; then
      state="pending $(pending_due)"
    else
      reboot_allowed
      root_dir "${REBOOT_STATE%/*}"
      # A lock that is there now must be one root can trust; one a first recipe-run makes later is root's.
      recipes_lock_there || true
      # D-38: when the unit fires and the lock is there, it takes the lock first, so a recipe-run or
      # server-report finishes, and holds it until the system stops the unit, so none starts while the
      # server goes down. Without the lock, no recipe-run ever ran here. "command exec": a lock it
      # can't open is logged, not a silent exit of sh.
      # D-42: right before systemctl reboot it writes the time ($3); a reboot that doesn't happen
      # leaves none: no time when it can't be written, and it is removed when systemctl reboot fails.
      # The time is as the state writes it ($4); without one, nothing is written. umask 022: the file is
      # root's alone, whatever systemd's default.
      # shellcheck disable=SC2016 # $1 to $4 are for the unit's shell
      job=(sh -c 'if [ -e "$1" ]; then command exec 8< "$1" || { logger -t eeploi-helper -- "server-reboot: no reboot, the recipe-run lock could not be opened"; exit 1; }; flock -w "$2" 8 || { logger -t eeploi-helper -- "server-reboot: no reboot, the recipe-run lock was not free within $2 seconds"; exit 1; }; fi; umask 022; { t=$(date -u "$4") && [ -n "$t" ] && printf "# Written by eeploi-helper (server-reboot): the last reboot it started. Do not edit.\nrebooted %s\n" "$t" > "$3.new" && mv -f "$3.new" "$3"; } || { rm -f "$3.new"; logger -t eeploi-helper -- "server-reboot: no reboot, the time could not be written to $3"; exit 1; }; systemctl reboot || { rm -f "$3"; logger -t eeploi-helper -- "server-reboot: no reboot, systemctl reboot failed"; exit 1; }; exec sleep infinity' sh "$RECIPES_STATE/.lock" "$REBOOT_WAIT" "$REBOOT_STATE" "$DATE_FORMAT")
      due=$(utc_in "$REBOOT_DELAY")
      if run systemd-run --quiet --unit="$REBOOT_UNIT" --description="eeploi-helper: reboot due $due" --collect \
        --on-active="$REBOOT_DELAY" --timer-property=AccuracySec=1s --timer-property=RemainAfterElapse=no \
        --setenv=PATH="$PATH" -- "${job[@]}"; then
        state="due $due"
      elif reboot_pending; then
        # Another call started one in the meantime: that one is pending.
        state="pending $(pending_due)"
      else
        fail "could not schedule the reboot"
      fi
    fi
    # D-39: <key> <value> lines; the reboot happens whether or not one is required. The caller knows the
    # reboot happened when the boot id changed: a reboot waiting for recipe-run's lock comes after its time.
    echo "reboot $state"
    echo "reboot-required $(reboot_required)"
    echo "boot-id $(boot_id)" ;;

  *)
    fail "unknown subcommand: $command" ;;
esac
