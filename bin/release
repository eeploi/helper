#!/usr/bin/env bash
# bin/release: sign eeploi-helper and publish it as the GitHub release of its VERSION.
# Run it yourself, in your own terminal: minisign asks for the key password, which is never
# stored, passed in or logged. Every step after signing is checked against minisign.pub.
# bin/release --check runs only the checks: no key, no signing, nothing published.
# The secret key is ~/.minisign/eeploi-helper.key, or HELPER_KEY when set.
# See RELEASING.md.
set -euo pipefail
cd "$(dirname "$0")/.."

REPO=eeploi/helper
KEY="${HELPER_KEY:-$HOME/.minisign/eeploi-helper.key}"
CHECK_ONLY=
[ "${1:-}" != --check ] || CHECK_ONLY=1
[ $# -eq 0 ] || [ -n "$CHECK_ONLY" ] || { echo "usage: bin/release [--check]" >&2; exit 64; }

work=$(mktemp -d)
tests_pid=
# A background job ignores Ctrl-C: stop the tests too.
trap '[ -z "$tests_pid" ] || kill "$tests_pid" 2> /dev/null || true; rm -rf "$work"' EXIT

say() { printf '\n== %s\n' "$*"; }
step() { printf '%s…\n' "$*"; }
# run_tests: tests/run.sh with its counts as it goes, on one line in a terminal, a line every 5 s otherwise.
# Its output stays in $work/tests for a failure.
run_tests() {
  local spin="|/-\\" n=0 counts=starting now status=0
  TESTS_PROGRESS="$work/progress" bash tests/run.sh > "$work/tests" 2>&1 &
  tests_pid=$!
  while kill -0 "$tests_pid" 2> /dev/null; do
    now=
    [ ! -f "$work/progress" ] || read -r now < "$work/progress" || true
    # Read while run.sh rewrites it, the file can be empty for a moment.
    [ -z "$now" ] || counts=$now
    if [ -t 1 ]; then
      printf '\r  %s %s\033[K' "${spin:n%4:1}" "$counts"
    elif [ $((n % 25)) -eq 0 ]; then
      printf '  %s\n' "$counts"
    fi
    n=$((n + 1))
    sleep 0.2
  done
  wait "$tests_pid" || status=$?
  tests_pid=
  [ ! -t 1 ] || printf '\r\033[K'
  [ ! -f "$work/progress" ] || read -r counts < "$work/progress" || true
  printf '  %s\n' "$counts"
  return "$status"
}
fail() { printf 'release: %s\n' "$*" >&2; exit 1; }
# verify <minisign args...>: against minisign.pub.
# D-13: a prehashed (ED) signature only, as the helper checks it.
verify() { minisign -V -H -p minisign.pub "$@"; }
confirm() {
  local answer
  read -r -p "$1 [y/N] " answer
  [ "$answer" = y ] || fail "stopped, nothing changed after this point"
}
sha256() { if command -v sha256sum > /dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }

for cmd in git gh minisign shellcheck; do
  command -v "$cmd" > /dev/null || fail "$cmd is not installed"
done

say "Checks"
[ "$(git branch --show-current)" = main ] || fail "not on main"
[ -z "$(git status --porcelain)" ] || fail "uncommitted changes"
step "fetching main and the tags from GitHub"
git fetch -q origin main
git fetch -q --force origin 'refs/tags/*:refs/tags/*'
head=$(git rev-parse HEAD)
[ "$head" = "$(git rev-parse origin/main)" ] || fail "main is not the same as GitHub's main: pull or push first"
commit=$(git rev-parse --short HEAD)

version=$(sed -n "s/^VERSION='\(.*\)'\$/\1/p" eeploi-helper)
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "cannot read VERSION from eeploi-helper"
tag="v$version"
# D-26: a v* tag can't move and a release can't change, so a version is released once.
step "checking that $tag is new"
! git rev-parse -q --verify "refs/tags/$tag" > /dev/null \
  || fail "$tag already exists: releases are immutable, release a new version"
if found=$(gh release view "$tag" -R "$REPO" --json isDraft --jq .isDraft 2>&1); then
  # A draft has no tag yet and can still go: what a run that stopped before publishing leaves.
  [ "$found" != true ] || fail "$REPO has a draft release $tag, left by a run that stopped: check it with" \
    "gh release view $tag -R $REPO, delete it with gh release delete $tag -R $REPO, then run this again"
  fail "$REPO already has a release $tag: releases are immutable, release a new version"
fi
# Only gh's "release not found" means none: any other error stops here, before anything is published.
[ "$found" = "release not found" ] || fail "could not ask GitHub for a release $tag: $found"

step "shellcheck"
shellcheck eeploi-helper tests/run.sh tests/decisions.sh bin/release || fail "shellcheck found problems"
step "running the tests"
# On a failure: what failed and why (cut short when much fails), then the end, also when run.sh itself broke.
run_tests || { { sed -n '/^FAIL /,/^$/p' "$work/tests" | head -40; tail -20 "$work/tests"; } >&2; fail "tests fail: bash tests/run.sh"; }
step "checking CI on $commit"
ci=$(gh run list -R "$REPO" --commit "$head" --json status,conclusion --jq '.[0] | "\(.status) \(.conclusion)"')
[ "$ci" = "completed success" ] || fail "CI on $commit is not green yet (${ci:-no run})"

echo "eeploi-helper $version at $commit: $tag is new, shellcheck clean, tests and CI green."
[ -z "$CHECK_ONLY" ] || exit 0

# D-14: signed by a person, in their own terminal; never in CI.
[ -t 0 ] || fail "run this in your own terminal: minisign asks for the key password"
# The script runs from the repo root, and the shell does not expand a quoted ~.
case "$KEY" in /*) ;; *) fail "HELPER_KEY must be an absolute path: $KEY" ;; esac
[ -f "$KEY" ] || fail "no secret key at $KEY (set HELPER_KEY to use another)"

say "Sign"
rm -f eeploi-helper.minisig
minisign -S -s "$KEY" -m eeploi-helper -t "eeploi-helper $version"
verified=$(verify -m eeploi-helper) || fail "the signature does not verify against minisign.pub as a prehashed signature (a legacy one is refused)"
grep -qxF "Trusted comment: eeploi-helper $version" <<< "$verified" || fail "the signature's trusted comment is not eeploi-helper $version"
cp eeploi-helper "$work/signed"

say "Publish"
confirm "Publish eeploi-helper $version ($commit) as $REPO $tag?"
# The folder can move while this runs, also during the question above (another session pulls main): stop before anything is pushed.
[ "$(git rev-parse HEAD)" = "$head" ] || fail "the folder moved off $commit since the checks: nothing was published, run it again"
git show "$head:eeploi-helper" > "$work/checked"
cmp -s "$work/signed" "$work/checked" || fail "the signed eeploi-helper is not the one in $commit: nothing was published"
cmp -s eeploi-helper "$work/signed" || fail "eeploi-helper changed since it was signed: nothing was published"
# D-26: nothing that can't change goes up before the files are checked. The release starts as a draft,
# with no tag; publishing it creates the tag on the checked commit. Until then a failed run leaves only
# a draft, which can be deleted, and the version stays free.
step "creating the release as a draft on $commit"
left="nothing was published and $tag was not made. A draft release $tag may be left on GitHub: check it with gh release view $tag -R $REPO, delete it with gh release delete $tag -R $REPO, then run this again"
gh release create "$tag" eeploi-helper eeploi-helper.minisig -R "$REPO" --draft --target "$head" \
  --title "eeploi-helper $version" --notes "See CHANGELOG.md." > /dev/null || fail "could not create the draft: $left"

say "Verify the draft"
draft=$(gh release view "$tag" -R "$REPO" --json isDraft,targetCommitish,assets \
  --jq '"\(.isDraft) \(.targetCommitish) \([.assets[].name] | sort | join(","))"') || fail "could not read the draft: $left"
[ "$draft" = "true $head eeploi-helper,eeploi-helper.minisig" ] \
  || fail "the draft is not a draft on $commit with only eeploi-helper and eeploi-helper.minisig ($draft): $left"
step "downloading its files again"
mkdir "$work/draft"
gh release download "$tag" -R "$REPO" -D "$work/draft" -p eeploi-helper -p eeploi-helper.minisig \
  || fail "could not download the draft's files: $left"
cmp -s "$work/draft/eeploi-helper" "$work/signed" || fail "the draft's eeploi-helper is not the signed file: $left"
verify -q -m "$work/draft/eeploi-helper" -x "$work/draft/eeploi-helper.minisig" \
  || fail "the draft's signature does not verify: $left"

say "Publish"
# A tag made on GitHub since the checks would carry the release: stop while it is a draft.
step "checking that $tag is still new"
remote=$(git ls-remote origin "refs/tags/$tag") || fail "could not ask GitHub for $tag: $left"
[ -z "$remote" ] || fail "$tag was made on GitHub since the checks: $left"
step "publishing $tag"
if ! gh release edit "$tag" -R "$REPO" --draft=false > /dev/null; then
  # The error can come after GitHub published it: only a release that is still a draft is unpublished.
  [ "$(gh release view "$tag" -R "$REPO" --json isDraft --jq .isDraft 2>&1)" != true ] \
    || fail "could not publish the draft: $left"
  fail "publishing $tag gave an error, and GitHub does not show it as a draft: check gh release view $tag -R $REPO before anything else"
fi

say "Verify the release"
published=$(gh release view "$tag" -R "$REPO" --json isDraft,isImmutable --jq '"\(.isDraft) \(.isImmutable)"') \
  || fail "could not read the published release $tag"
[ "$published" = "false true" ] || fail "$tag is published, but not as an immutable release ($published): check the repository's settings"
git fetch -q origin "refs/tags/$tag:refs/tags/$tag" || fail "could not fetch $tag from GitHub"
[ "$(git rev-parse "refs/tags/$tag^{commit}")" = "$head" ] || fail "$tag on GitHub is not $commit"

say "Done"
echo "eeploi-helper $version, $tag at $commit, SHA-256 $(sha256 eeploi-helper)."
echo "Next: pin $version and its SHA-256 in eeploi.com."
