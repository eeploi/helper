#!/usr/bin/env bash
# bin/release: sign eeploi-helper and publish it as the GitHub release of its VERSION.
# Run it yourself, in your own terminal: minisign asks for the key password, which is never
# stored, passed in or logged. It shows what is released and what changed since the last release,
# runs the checks, and signs only after you confirm. Every step after signing is checked against minisign.pub.
# bin/release --check runs only the checks: no key, no signing, nothing published.
# The secret key is ~/.minisign/eeploi-helper.key, or HELPER_KEY when set.
# See RELEASING.md.
set -euo pipefail
cd "$(dirname "$0")/.."

REPO=eeploi/helper
KEY="${HELPER_KEY:-$HOME/.minisign/eeploi-helper.key}"
CHECK_ONLY=
[ "${1:-}" != --check ] || CHECK_ONLY=1
[ $# -eq 0 ] || [ -n "$CHECK_ONLY" ] || { echo "usage: bin/release [--check]" >&2; exit 64; }

work=$(mktemp -d)
# A run that stops while a draft may be on GitHub says so, also when it stops without fail() (set -e, Ctrl-C).
on_exit() {
  local status=$?
  [ "$status" -eq 0 ] || [ -z "${left:-}" ] || printf '  stopped: %s\n' "$left" >&2
  rm -rf "$work"
}
trap on_exit EXIT

# Colour only on a terminal, never in a pipe or a log, and never inside a message: it reads the same without.
# NO_COLOR turns it off.
paint() { if [ -t "$1" ] && [ -z "${NO_COLOR:-}" ]; then printf '\033[%sm%s\033[0m' "$2" "$3"; else printf '%s' "$3"; fi; }
line() { printf '%s\n' "=========================================="; }
# field <label> <value>: one line of the overview.
field() { printf '%-18s %s\n' "$1" "$2"; }
heading() { printf '\n%s\n' "$(paint 1 1 "$1")"; }
ok() { printf '  %s %s\n' "$(paint 1 32 ✓)" "$*"; }
# printable: no control character (ESC, CR, tab and the like; a newline stays), so text from GitHub or a
# commit can't move the cursor or rewrite what the screen shows. Other UTF-8 stays.
printable() { LC_ALL=C tr -d '\000-\011\013-\037\177'; }
# While a draft may be on GitHub, $left says so and how to delete it: every failure then ends with it.
# A failure can carry gh's own output: printable only.
left=
fail() { printf '  %s %s\n' "$(paint 2 31 ✗)" "$(printf '%s' "$*${left:+: $left}" | printable)" >&2; left=; exit 1; }
# verify <minisign args...>: against minisign.pub.
# D-13: a prehashed (ED) signature only, as the helper checks it.
verify() { minisign -V -H -p minisign.pub "$@"; }
sha256() { if command -v sha256sum > /dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }
# version_lt <a> <b>: version a is lower than b, each part compared as a number. The same function as in
# eeploi-helper, which self-update uses (tests/run.sh checks that the two are the same).
version_lt() {
  local a1 a2 a3 b1 b2 b3
  IFS=. read -r a1 a2 a3 <<< "$1"
  IFS=. read -r b1 b2 b3 <<< "$2"
  (( a1 != b1 )) && { (( a1 < b1 )); return; }
  (( a2 != b2 )) && { (( a2 < b2 )); return; }
  (( a3 < b3 ))
}

for cmd in git gh minisign; do
  command -v "$cmd" > /dev/null || fail "$cmd is not installed"
done

version=$(sed -n "s/^VERSION='\(.*\)'\$/\1/p" eeploi-helper)
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "cannot read VERSION from eeploi-helper"
tag="v$version"
undo="check it with gh release view $tag -R $REPO, delete it with gh release delete $tag -R $REPO, then run this again"
# D-35: only versions self-update takes (its SEMVER_RE, read from eeploi-helper line by line) count.
semver=$(sed -n "s/^SEMVER_RE='\(.*\)'\$/\1/p" eeploi-helper)
[ -n "$semver" ] || fail "cannot read SEMVER_RE from eeploi-helper"
# The key's id, from the key itself (bytes 3 to 10, little-endian), not from the comment above it.
keyid=$(sed -n 2p minisign.pub | base64 -d 2> /dev/null | od -An -tx1 -j2 -N8 \
  | awk '{ for (i = NF; i > 0; i--) printf "%s", toupper($i) }') || true
[[ $keyid =~ ^[0-9A-F]{16}$ ]] || fail "cannot read the key id from minisign.pub"
# D-35: released means a v* tag on GitHub, not one only in this clone. The highest is the previous release.
released=$(git ls-remote --tags --refs origin 'v*') || fail "could not list the tags on GitHub"
previous=
while read -r _ ref; do
  ref=${ref#refs/tags/v}
  [[ $ref =~ $semver ]] || continue
  if [ -z "$previous" ] || version_lt "$previous" "$ref"; then previous=$ref; fi
done <<< "$released"
head=$(git rev-parse HEAD)
commit=$(git rev-parse --short HEAD)
branch=$(git branch --show-current)

line
printf '%s  ·  release\n' "$(paint 1 1 "EEPLOI HELPER")"
line
field "Previous version" "${previous:-none}${previous:+   (v$previous)}"
field "New version" "$version"
field "Commit" "$commit  $branch"
field "Key" "$keyid"
line

heading "Checks"
[ "$branch" = main ] || fail "not on main"
[ -z "$(git status --porcelain)" ] || fail "uncommitted changes"
git fetch -q origin main || fail "could not fetch main from GitHub"
git fetch -q --force origin 'refs/tags/*:refs/tags/*' || fail "could not fetch the tags from GitHub"
[ "$head" = "$(git rev-parse origin/main)" ] || fail "main is not the same as GitHub's main: pull or push first"
ok "main is clean and matches GitHub"

# D-26: a v* tag can't move and a release can't change, so a version is released once.
! git rev-parse -q --verify "refs/tags/$tag" > /dev/null \
  || fail "$tag already exists: releases are immutable, release a new version"
# isImmutable too: a gh too old to know it stops here, not after publishing.
if found=$(gh release view "$tag" -R "$REPO" --json isDraft,isImmutable --jq .isDraft 2>&1); then
  # A draft has no tag yet and can still go: what a run that stopped before publishing leaves.
  [ "$found" != true ] || fail "$REPO has a draft release $tag, left by a run that stopped: $undo"
  fail "$REPO already has a release $tag: releases are immutable, release a new version"
fi
# Only gh's "release not found" means none: any other error stops here, before anything is published.
[ "$found" = "release not found" ] || fail "could not ask GitHub for a release $tag: $found"
# D-35: releases only go up: no fix for an older line, which self-update refuses anyway. Higher than the
# previous release is higher than every one.
[[ $version =~ $semver ]] || fail "$version is not a version self-update installs"
[ -z "$previous" ] || version_lt "$previous" "$version" || fail "$version is not higher than $previous: releases only go up"
ok "$version is higher than every released version"

# D-34: the changelog has no dates, GitHub's release has the date. The pull request that raises VERSION
# moves the Unreleased lines under the version's heading, the second one, right below Unreleased.
# sections: each ## heading, then how many lines with text are under it.
sections=$(awk '/^## / { if (h != "") print n, h; h = $0; n = 0; next } NF { n++ } END { if (h != "") print n, h }' CHANGELOG.md) \
  || fail "cannot read CHANGELOG.md"
[ "$(sed -n '1,2s/^[0-9]* //p' <<< "$sections")" = "## Unreleased"$'\n'"## $version" ] \
  || fail "CHANGELOG.md does not start with ## Unreleased, then ## $version (without a date): move the Unreleased lines under it"
[ "$(sed -n 1p <<< "$sections")" = "0 ## Unreleased" ] \
  || fail "CHANGELOG.md has lines under ## Unreleased: move them under ## $version"
[ "$(sed -n '2s/ .*//p' <<< "$sections")" -gt 0 ] || fail "CHANGELOG.md has nothing under ## $version"
ok "CHANGELOG: ## $version, Unreleased empty"

# CI's own run on this exact commit stands for the tests and shellcheck: the latest run of ci.yml for the
# push to main (a pull request's run on the same commit tests its merge with another branch), and its job
# named test, finished and passed.
run=$(gh run list -R "$REPO" --commit "$head" --workflow ci.yml --event push --branch main --limit 1 \
  --json databaseId --jq '.[0].databaseId // ""') || fail "could not ask GitHub for CI on $commit"
[ -n "$run" ] || fail "CI has no run for the push of $commit to main yet"
[[ $run =~ ^[0-9]+$ ]] || fail "could not read CI's run on $commit ($run)"
ci=$(gh run view "$run" -R "$REPO" --json headSha,event,headBranch,jobs \
  --jq '"\(.headSha) \(.event) \(.headBranch) " + ([.jobs[] | select(.name == "test") | "\(.status)/\(.conclusion)"] | join(","))') \
  || fail "could not read CI's run $run on $commit"
read -r ci_sha ci_event ci_branch jobs <<< "$ci" || true
[ "$ci_sha" = "$head" ] || fail "CI's run $run is not on $commit ($ci_sha)"
[ "$ci_event $ci_branch" = "push main" ] || fail "CI's run $run is not for the push to main ($ci_event $ci_branch)"
[ -n "${jobs:-}" ] || fail "CI's run $run on $commit has no job named test"
[ "$jobs" = completed/success ] || fail "CI's test job on $commit has not passed ($jobs)"
ok "CI \`test\` passed on $commit"

# What is released: the commits since the previous release, and how much of eeploi-helper changed.
# Subjects only while they fit on a screen, never a diff.
if [ -n "$previous" ]; then
  since="refs/tags/v$previous"
  ancestor=0
  git merge-base --is-ancestor "$since" "$head" || ancestor=$?
  [ "$ancestor" != 1 ] || fail "v$previous is not in the history of $commit"
  [ "$ancestor" = 0 ] || fail "git could not compare v$previous with $commit"
  count=$(git rev-list --count "$since..$head")
  read -r added removed _ < <(git diff --numstat "$since" "$head" -- eeploi-helper) || true
  commits="$count commits"
  [ "$count" != 1 ] || commits="1 commit"
  ok "Changes since v$previous: $commits, eeploi-helper +${added:-0} −${removed:-0} lines"
  if [ "$count" -le 10 ]; then
    # "subject (#37)" reads as "#37 subject".
    git log --reverse --format=%s "$since..$head" | printable | sed -E 's/^(.*) \(#([0-9]+)\)$/#\2 \1/; s/^/      /'
  else
    printf '      see them with: git log --oneline v%s..%s\n' "$previous" "$commit"
  fi
else
  ok "First release: no earlier version"
fi

if [ -n "$CHECK_ONLY" ]; then
  printf '\nEvery check passed. Nothing signed (--check).\n'
  exit 0
fi

# D-14: signed by a person, in their own terminal; never in CI.
[ -t 0 ] || fail "run this in your own terminal: minisign asks for the key password"
# The script runs from the repo root, and the shell does not expand a quoted ~.
case "$KEY" in /*) ;; *) fail "HELPER_KEY must be an absolute path: $KEY" ;; esac
[ -f "$KEY" ] || fail "no secret key at $KEY (set HELPER_KEY to use another)"

printf '\n'
# read -p asks on stderr. An end of input is a no.
read -r -p "$(paint 2 1 "Sign $version?") [y/N] " answer || answer=
[ "$answer" = y ] || fail "stopped: nothing signed, nothing published"
rm -f eeploi-helper.minisig
minisign -S -s "$KEY" -m eeploi-helper -t "eeploi-helper $version"
verified=$(verify -m eeploi-helper) || fail "the signature does not verify against minisign.pub as a prehashed signature (a legacy one is refused)"
grep -qxF "Trusted comment: eeploi-helper $version" <<< "$verified" || fail "the signature's trusted comment is not eeploi-helper $version"
cp eeploi-helper "$work/signed"
ok "signed, signature checks out"

# The folder can move while this runs, also during the question above (another session pulls main): stop before anything is pushed.
[ "$(git rev-parse HEAD)" = "$head" ] || fail "the folder moved off $commit since the checks: nothing was published, run it again"
git show "$head:eeploi-helper" > "$work/checked"
cmp -s "$work/signed" "$work/checked" || fail "the signed eeploi-helper is not the one in $commit: nothing was published"
cmp -s eeploi-helper "$work/signed" || fail "eeploi-helper changed since it was signed: nothing was published"
# D-26: nothing that can't change goes up before the files are checked. The release starts as a draft,
# with no tag; publishing it creates the tag on the checked commit. Until then a failed run leaves only
# a draft, which can be deleted, and the version stays free.
left="nothing was published and $tag was not made. A draft release $tag may be left on GitHub: $undo"
gh release create "$tag" eeploi-helper eeploi-helper.minisig -R "$REPO" --draft --target "$head" \
  --title "eeploi-helper $version" --notes "See CHANGELOG.md." > /dev/null || fail "could not create the draft"
draft=$(gh release view "$tag" -R "$REPO" --json isDraft,targetCommitish,assets \
  --jq '"\(.isDraft) \(.targetCommitish) \([.assets[].name] | sort | join(","))"') || fail "could not read the draft"
[ "$draft" = "true $head eeploi-helper,eeploi-helper.minisig" ] \
  || fail "the draft is not a draft on $commit with only eeploi-helper and eeploi-helper.minisig ($draft)"
mkdir "$work/draft"
gh release download "$tag" -R "$REPO" -D "$work/draft" -p eeploi-helper -p eeploi-helper.minisig \
  || fail "could not download the draft's files"
cmp -s "$work/draft/eeploi-helper" "$work/signed" || fail "the draft's eeploi-helper is not the signed file"
verify -q -m "$work/draft/eeploi-helper" -x "$work/draft/eeploi-helper.minisig" \
  || fail "the draft's signature does not verify"
ok "draft created, files match"

# A tag made on GitHub since the checks would carry the release: stop while it is a draft.
remote=$(git ls-remote origin "refs/tags/$tag") || fail "could not ask GitHub for $tag"
if [ -n "$remote" ]; then
  left=
  fail "$tag was made on GitHub since the checks, so this version can't be released: the draft was not published;" \
    "delete it with gh release delete $tag -R $REPO and release a new version"
fi
if ! gh release edit "$tag" -R "$REPO" --draft=false > /dev/null; then
  # The error can come after GitHub published it: only a release that is still a draft is unpublished.
  state=$(gh release view "$tag" -R "$REPO" --json isDraft --jq .isDraft 2>&1) || true
  [ "$state" != true ] || fail "could not publish the draft"
  left=
  [ "$state" != false ] || fail "publishing $tag gave an error, but GitHub shows it published: check gh release view $tag -R $REPO before anything else"
  fail "publishing $tag gave an error, and GitHub could not say whether it is published ($state): check gh release view $tag -R $REPO." \
    "Still a draft: $undo. Published: the version is released"
fi
left=
published=$(gh release view "$tag" -R "$REPO" --json isDraft,isImmutable,assets \
  --jq '"\(.isDraft) \(.isImmutable) \([.assets[].name] | sort | join(","))"') || fail "could not read the published release $tag"
[ "$published" = "false true eeploi-helper,eeploi-helper.minisig" ] \
  || fail "$tag is published, but not as an immutable release with only eeploi-helper and eeploi-helper.minisig ($published): check it and the repository's settings"
# A draft's files could still change until it was published: check the published ones too.
mkdir "$work/published"
gh release download "$tag" -R "$REPO" -D "$work/published" -p eeploi-helper -p eeploi-helper.minisig \
  || fail "could not download the published files"
cmp -s "$work/published/eeploi-helper" "$work/signed" || fail "the published eeploi-helper is not the signed file"
verify -q -m "$work/published/eeploi-helper" -x "$work/published/eeploi-helper.minisig" \
  || fail "the published signature does not verify"
git fetch -q origin "refs/tags/$tag:refs/tags/$tag" || fail "could not fetch $tag from GitHub"
[ "$(git rev-parse "refs/tags/$tag^{commit}")" = "$head" ] || fail "$tag on GitHub is not $commit"
ok "published: $tag, immutable"

printf '\n'
line
printf '%s  eeploi-helper %s\n' "$(paint 1 '1;32' RELEASED)" "$version"
field "Tag" "$tag  on $commit"
field "Key" "$keyid"
field "SHA-256" "$(sha256 "$work/signed")"
line
